2-7-2-2\" data-name=\"experience entry previous\">\n<p class=\"gt-exp-dates\" data-kid=\"1-2-2-7-2-2-1\" data-name=\"dates label\">2019–2022</p>\n<div data-kid=\"1-2-2-7-2-2-2\" data-name=\"experience details container\">\n<h3 data-kid=\"1-2-2-7-2-2-2-1\" data-name=\"job title\">Frontend Engineer</h3>\n<p class=\"gt-exp-co\" data-kid=\"1-2-2-7-2-2-2-2\" data-name=\"company name\">Copperline</p>\n<p class=\"gt-exp-desc\" data-kid=\"1-2-2-7-2-2-2-3\" data-name=\"role description\">Customer billing portal and internal support tools.</p>\n</div>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"contact-title\" class=\"gt-contact\" data-kid=\"1-2-2-8\" data-name=\"contact section\" id=\"contact\">\n<h2 data-kid=\"1-2-2-8-1\" data-name=\"section heading\" id=\"contact-title\">Contact</h2>\n<p class=\"gt-contact-lead\" data-kid=\"1-2-2-8-2\" data-name=\"contact lead text\">Senior frontend and full stack roles.</p>\n<div class=\"gt-contact-email-row\" data-kid=\"1-2-2-8-3\" data-name=\"email row with copy button\">\n<a class=\"gt-contact-email\" data-kid=\"1-2-2-8-3-1\" data-name=\"large email address link\" href=\"mailto:inez@inezpark.dev\">inez@inezpark.dev</a>\n<button class=\"gt-copyBtn\" data-copy=\"inez@inezpark.dev\" data-dynamic=\"true\" data-kid=\"1-2-2-8-3-2\" data-name=\"copy email button\" data-reason=\"label text and icon swapped to 'Copied' on click for 2 seconds\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon-clipboard-copy gt-ico\" data-kid=\"1-2-2-8-3-2-1\" data-name=\"clipboard copy icon\"></i>\n<span data-copy-label=\"\" data-kid=\"1-2-2-8-3-2-2\" data-name=\"button label\">Copy email</span>\n</button>\n</div>\n<div class=\"gt-contact-links\" data-kid=\"1-2-2-8-4\" data-name=\"contact links row\">\n<a class=\"gt-contact-link\" data-kid=\"1-2-2-8-4-1\" data-name=\"GitHub profile link\" href=\"https://github.com/inezpark\" rel=\"noreferrer\" target=\"_blank\">GitHub <i aria-hidden=\"true\" class=\"icon-arrow-up-right gt-ico\" data-kid=\"1-2-2-8-4-1-1\" data-name=\"arrow up right icon\"></i></a>\n<a class=\"gt-contact-link\" data-kid=\"1-2-2-8-4-2\" data-name=\"LinkedIn profile link\" href=\"https://www.linkedin.com/in/inezpark\" rel=\"noreferrer\" target=\"_blank\">LinkedIn <i aria-hidden=\"true\" class=\"icon-arrow-up-right gt-ico\" data-kid=\"1-2-2-8-4-2-1\" data-name=\"arrow up right icon\"></i></a>\n<a class=\"gt-contact-link\" data-kid=\"1-2-2-8-4-3\" data-name=\"request resume mailto link\" href=\"mailto:inez@inezpark.dev?subject=R%C3%A9sum%C3%A9%20request\">Request résumé <i aria-hidden=\"true\" class=\"icon-arrow-up-right gt-ico\" data-kid=\"1-2-2-8-4-3-1\" data-name=\"arrow up right icon\"></i></a>\n</div>\n</section>\n<footer class=\"gt-foot\" data-kid=\"1-2-2-9\" data-name=\"page footer\">\n<span data-kid=\"1-2-2-9-1\" data-name=\"footer copyright text\">Inez Park, Brooklyn, NY</span>\n<a data-kid=\"1-2-2-9-2\" data-name=\"footer site link\" href=\"https://inezpark.dev\" rel=\"noreferrer\" target=\"_blank\">inezpark.dev</a>\n</footer>\n</main>\n</div>\n<span aria-live=\"polite\" class=\"gt-sr-only\" data-copy-status=\"\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"screen reader live region for copy status\" data-reason=\"text content written by copy script on button click\" role=\"status\"></span>\n</div>\n<script>\n(function () {\n  var sectionIds = ['switchyard', 'facet', 'scaffold-a11y', 'stack', 'experience', 'contact'];\n  var links = Array.prototype.slice.call(document.querySelectorAll('[data-project-link], [data-section-link]'));\n  var sections = sectionIds.map(function (id) { return document.getElementById(id); }).filter(Boolean);\n\n  function activate(id) {\n    links.forEach(function (link) {\n      var target = link.getAttribute('data-project-link') || link.getAttribute('data-section-link');\n      if (target === id) {\n        link.setAttribute('aria-current', 'location');\n      } else {\n        link.removeAttribute('aria-current');\n      }\n    });\n  }\n\n  var queued = false;\n\n  function update() {\n    queued = false;\n    var marker = window.innerHeight * 0.32;\n    var active = sections.length ? sections[0].id : null;\n\n    sections.forEach(function (section) {\n      if (section.getBoundingClientRect().top <= marker) {\n        active = section.id;\n      }\n    });\n\n    var atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8;\n    if (atBottom && sections.length) {\n      active = sections[sections.length - 1].id;\n    }\n\n    if (active) activate(active);\n  }\n\n  function schedule() {\n    if (!queued) {\n      queued = true;\n      window.requestAnimationFrame(update);\n    }\n  }\n\n  window.addEventListener('scroll', schedule, { passive: true });\n  window.addEventListener('resize', schedule);\n  update();\n})();\n\n(function () {\n  function fallbackCopy(text) {\n    var area = document.createElement('textarea');\n    area.value = text;\n    area.setAttribute('readonly', '');\n    area.style.position = 'fixed';\n    area.style.opacity = '0';\n    document.body.appendChild(area);\n    area.select();\n    try { document.execCommand('copy'); } catch (error) {}\n    document.body.removeChild(area);\n  }\n\n  var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-copy]'));\n  var status = document.querySelector('[data-copy-status]');\n\n  buttons.forEach(function (button) {\n    var label = button.querySelector('[data-copy-label]');\n    var icon = button.querySelector('i');\n    var original = label ? label.textContent : '';\n    var timer;\n\n    button.addEventListener('click', function () {\n      var text = button.getAttribute('data-copy');\n\n      function done() {\n        if (label) label.textContent = 'Copied';\n        if (icon) {\n          icon.classList.remove('icon-clipboard-copy');\n          icon.classList.add('icon-check');\n        }\n        if (status) status.textContent = 'Copied to clipboard';\n        window.clearTimeout(timer);\n        timer = window.setTimeout(function () {\n          if (label) label.textContent = original;\n          if (icon) {\n            icon.classList.add('icon-clipboard-copy');\n            icon.classList.remove('icon-check');\n          }\n          if (status) status.textContent = '';\n        }, 2000);\n      }\n\n      if (navigator.clipboard && navigator.clipboard.writeText) {\n        navigator.clipboard.writeText(text).then(done).catch(function () {\n          fallbackCopy(text);\n          done();\n        });\n      } else {\n        fallbackCopy(text);\n        done();\n      }\n    });\n  });\n})();\n</script>",
