      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\nhtml { scroll-behavior: smooth; }\nbody { background: #EEF1F4; margin: 0; }\n\n.gt {\n  --paper: #EEF1F4;\n  --paper-2: #F6F8FA;\n  --white: #FFFFFF;\n  --ink: #121820;\n  --ink-2: #25313D;\n  --muted: #5F6C79;\n  --line: #D3DBE3;\n  --line-soft: rgba(18, 24, 32, 0.09);\n  --signal: #C44722;\n  --signal-deep: #A93A1B;\n  --signal-soft: #F8E3DA;\n  --blue-wash: #BBD3E8;\n  --success: #2F6B57;\n  --sans: 'Manrope', system-ui, -apple-system, sans-serif;\n  --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;\n  position: relative;\n  min-height: 100vh;\n  overflow-x: clip;\n  isolation: isolate;\n  background: var(--paper);\n  color: var(--ink);\n  font-family: var(--sans);\n  font-size: 16px;\n  line-height: 1.5;\n  -webkit-font-smoothing: antialiased;\n}\n\n.gt *,\n.gt *::before,\n.gt *::after { box-sizing: border-box; }\n\n.gt [hidden] { display: none !important; }\n.gt :where(a) { color: inherit; text-decoration: none; }\n.gt :where(button) { font-family: inherit; }\n.gt h1, .gt h2, .gt h3, .gt h4, .gt p, .gt dl, .gt dd, .gt dt { margin: 0; }\n.gt ul { margin: 0; padding: 0; list-style: none; }\n.gt img { max-width: 100%; display: block; }\n\n.gt-ambient {\n  position: fixed;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(920px 620px at 82% -8%, rgba(172, 202, 231, 0.66), transparent 66%),\n    radial-gradient(760px 520px at 4% 18%, rgba(219, 228, 237, 0.9), transparent 72%),\n    radial-gradient(620px 460px at 62% 52%, rgba(244, 233, 226, 0.55), transparent 72%);\n}\n\n.gt-ambient::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background-image:\n    linear-gradient(rgba(18, 24, 32, 0.035) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(18, 24, 32, 0.035) 1px, transparent 1px);\n  background-size: 64px 64px;\n  -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.78), transparent 62%);\n  mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.78), transparent 62%);\n}\n\n.gt-content { position: relative; z-index: 1; }\n\n.wrap { width: min(1200px, calc(100% - 80px)); margin: 0 auto; }\n\n.skip-link {\n  position: absolute;\n  left: 20px;\n  top: -60px;\n  z-index: 100;\n  padding: 10px 14px;\n  border-radius: 6px;\n  background: var(--ink);\n  color: #fff;\n  font-size: 13px;\n  font-weight: 600;\n  transition: top 160ms ease;\n}\n.skip-link:focus { top: 12px; }\n\n.icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 16px;\n  height: 16px;\n  font-size: 16px;\n  line-height: 1;\n  font-style: normal;\n  flex: 0 0 auto;\n}\n.icon-sm { width: 14px; height: 14px; font-size: 14px; }\n\n.gt :focus-visible {\n  outline: 2px solid var(--signal);\n  outline-offset: 3px;\n}\n\n/* Header */\n.site-header {\n  position: sticky;\n  top: 0;\n  z-index: 40;\n  background: rgba(238, 241, 244, 0.88);\n  border-bottom: 1px solid var(--line-soft);\n  backdrop-filter: blur(16px);\n}\n.header-inner {\n  min-height: 64px;\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  align-items: center;\n  gap: 24px;\n}\n.brand {\n  justify-self: start;\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 14px;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n}\n.brand-mark {\n  display: grid;\n  place-items: center;\n  width: 28px;\n  height: 28px;\n  border: 1px solid var(--ink);\n  border-radius: 6px;\n  font-family: var(--mono);\n  font-size: 10px;\n  font-weight: 500;\n  letter-spacing: 0.02em;\n}\n.nav { justify-self: center; display: flex; align-items: center; gap: 28px; }\n.nav a {\n  position: relative;\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--muted);\n  transition: color 160ms ease;\n}\n.nav a::after {\n  content: '';\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: -5px;\n  height: 1px;\n  background: var(--signal);\n  transform: scaleX(0);\n  transform-origin: left;\n  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);\n}\n.nav a:hover { color: var(--ink); }\n.nav a:hover::after { transform: scaleX(1); }\n.header-resume {\n  justify-self: end;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 0;\n  border-bottom: 1px solid transparent;\n  font-size: 13px;\n  font-weight: 600;\n  transition: border-color 160ms ease, color 160ms ease;\n}\n.header-resume:hover { border-color: var(--ink); }\n.header-resume .icon { color: var(--signal); }\n\n/* Intro */\n.intro {\n  display: grid;\n  grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);\n  gap: clamp(40px, 6vw, 84px);\n  align-items: end;\n  padding: 52px 0 40px;\n}\n.intro h1 {\n  font-size: clamp(52px, 5.6vw, 76px);\n  line-height: 0.94;\n  letter-spacing: -0.052em;\n  font-weight: 700;\n}\n.intro-role {\n  margin-top: 12px;\n  font-family: var(--mono);\n  font-size: 12.5px;\n  color: var(--muted);\n}\n.intro-right { max-width: 470px; padding-bottom: 2px; }\n.profile {\n  font-size: 18px;\n  line-height: 1.58;\n  letter-spacing: -0.012em;\n}\n.meta-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px 18px;\n  margin-top: 18px;\n  font-family: var(--mono);\n  font-size: 11.5px;\n  color: var(--muted);\n}\n.intro-links { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 15px; }\n.intro-links a {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding-bottom: 2px;\n  border-bottom: 1px solid var(--line);\n  font-size: 13px;\n  font-weight: 600;\n  transition: color 160ms ease, border-color 160ms ease;\n}\n.intro-links a:hover { color: var(--signal-deep); border-color: var(--signal); }\n.intro-links .icon { color: var(--muted); }\n\n/* Project chapters */\n.project {\n  padding: 56px 0 76px;\n  border-top: 1px solid var(--line);\n  scroll-margin-top: 84px;\n}\n.project-head {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 28px;\n  align-items: start;\n  margin-bottom: 26px;\n}\n.project h2 {\n  font-size: clamp(34px, 3.3vw, 46px);\n  line-height: 1;\n  font-weight: 700;\n  letter-spacing: -0.045em;\n}\n.project-sub {\n  max-width: 58ch;\n  margin-top: 10px;\n  font-size: 14.5px;\n  line-height: 1.62;\n  color: var(--muted);\n}\n.project-meta {\n  padding-top: 5px;\n  font-family: var(--mono);\n  font-size: 11.5px;\n  line-height: 1.75;\n  color: var(--muted);\n  text-align: right;\n}\n.project-meta span { display: block; }\n\n/* Glass specimen */\n.specimen {\n  position: relative;\n  border: 1px solid rgba(255, 255, 255, 0.92);\n  border-radius: 20px;\n  overflow: hidden;\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.52));\n  box-shadow:\n    0 30px 76px -36px rgba(18, 24, 32, 0.42),\n    inset 0 1px 0 rgba(255, 255, 255, 1);\n  backdrop-filter: blur(22px) saturate(1.12);\n}\n.specimen::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: radial-gradient(620px 320px at 86% -4%, rgba(161, 196, 230, 0.42), transparent 72%);\n}\n.specimen-head {\n  position: relative;\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 24px;\n  padding: 22px 24px 0;\n}\n.path {\n  margin-bottom: 8px;\n  font-family: var(--mono);\n  font-size: 11px;\n  color: var(--muted);\n}\n.specimen-title {\n  font-size: 26px;\n  line-height: 1.05;\n  font-weight: 700;\n  letter-spacing: -0.035em;\n}\n.specimen-sub {\n  max-width: 62ch;\n  margin-top: 7px;\n  font-size: 13.5px;\n  line-height: 1.55;\n  color: var(--muted);\n}\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  min-height: 36px;\n  padding: 0 13px;\n  border-radius: 7px;\n  border: 1px solid transparent;\n  font-size: 12.5px;\n  font-weight: 700;\n  line-height: 1;\n  cursor: pointer;\n  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;\n}\n.btn:active { transform: translateY(1px); }\n.btn-primary { background: var(--ink); color: #fff; }\n.btn-primary:hover { background: #24303C; }\n.btn-secondary { background: #fff; border-color: var(--line); color: var(--ink); }\n.btn-secondary:hover { background: #F1F4F7; }\n.btn-signal {\n  min-height: 40px;\n  padding: 0 15px;\n  background: var(--signal);\n  color: #fff;\n  box-shadow: 0 8px 18px -10px rgba(191, 69, 33, 0.8);\n}\n.btn-signal:hover { background: var(--signal-deep); }\n.btn-signal .icon { color: #fff; }\n\n.tabs {\n  position: relative;\n  display: flex;\n  align-items: stretch;\n  gap: 26px;\n  margin-top: 18px;\n  padding: 0 24px;\n  border-bottom: 1px solid var(--line-soft);\n  overflow-x: auto;\n  scrollbar-width: none;\n}\n.tabs::-webkit-scrollbar { display: none; }\n.tab {\n  position: relative;\n  padding: 12px 0;\n  border: 0;\n  background: transparent;\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 12px;\n  font-weight: 500;\n  white-space: nowrap;\n  cursor: pointer;\n  transition: color 160ms ease;\n}\n.tab:hover { color: var(--ink); }\n.tab[aria-selected=\"true\"] {\n  color: var(--ink);\n  box-shadow: inset 0 -2px 0 var(--signal);\n}\n\n.mobile-switch {\n  display: none;\n  gap: 4px;\n  padding: 10px 14px;\n  border-bottom: 1px solid var(--line-soft);\n  background: rgba(246, 248, 250, 0.9);\n}\n.mobile-switch button {\n  flex: 1;\n  min-height: 34px;\n  border: 1px solid transparent;\n  border-radius: 6px;\n  background: transparent;\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 11px;\n  font-weight: 500;\n  cursor: pointer;\n}\n.mobile-switch button.active {\n  border-color: var(--line);\n  background: #fff;\n  color: var(--ink);\n}\n\n.specimen-body {\n  display: grid;\n  grid-template-columns: 264px minmax(0, 1fr);\n  position: relative;\n}\n\n.inspector {\n  padding: 18px 16px;\n  border-right: 1px solid var(--line-soft);\n  background: rgba(246, 248, 250, 0.82);\n}\n.inspector h4,\n.field-label {\n  font-family: var(--mono);\n  font-size: 10.5px;\n  font-weight: 600;\n  color: var(--muted);\n}\n.inspector h4 { margin-bottom: 10px; }\n.state-list { display: flex; flex-direction: column; gap: 6px; }\n.state-option {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  min-height: 40px;\n  padding: 9px 12px;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  background: #F7F9FB;\n  font-size: 12.5px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color 150ms ease, border-color 150ms ease;\n}\n.state-option:hover { background: #fff; border-color: var(--line); }\n.state-option input {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  opacity: 0;\n  cursor: pointer;\n}\n.state-option:has(input:checked) {\n  background: #fff;\n  border-color: var(--ink);\n}\n.state-option:focus-within {\n  outline: 2px solid var(--signal);\n  outline-offset: 2px;\n}\n.state-dot {\n  width: 9px;\n  height: 9px;\n  border: 1px solid #97A5B2;\n  border-radius: 50%;\n  flex: 0 0 auto;\n}\n.state-option:has(input:checked) .state-dot {\n  border-color: var(--signal);\n  background: var(--signal);\n}\n.api-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin-top: 16px;\n  padding-top: 14px;\n  border-top: 1px solid var(--line);\n}\n.api-row {\n  display: flex;\n  justify-content: space-between;\n  gap: 10px;\n  font-family: var(--mono);\n  font-size: 10.5px;\n  line-height: 1.5;\n}\n.api-row dt { color: var(--muted); }\n.api-row dd { color: var(--ink); text-align: right; }\n\n.specimen-panels { min-width: 0; padding: 18px; }\n.tab-panel { min-width: 0; }\n.tab-panel:focus-visible { outline-offset: 4px; }\n\n.preview-surface {\n  display: grid;\n  place-items: center;\n  min-height: 360px;\n  padding: 28px;\n  overflow: hidden;\n  border: 1px solid var(--line-soft);\n  border-radius: 12px;\n  background:\n    radial-gradient(440px 260px at 72% 8%, rgba(169, 202, 232, 0.54), transparent 72%),\n    #F4F7FA;\n}\n.dialog-card {\n  width: min(100%, 392px);\n  padding: 22px;\n  border: 1px solid #DEE5EB;\n  border-radius: 14px;\n  background: #fff;\n  box-shadow: 0 20px 42px -24px rgba(18, 24, 32, 0.46);\n  animation: dialog-in 180ms cubic-bezier(0.16, 1, 0.3, 1) both;\n}\n.dialog-title {\n  font-size: 19px;\n  line-height: 1.2;\n  font-weight: 700;\n  letter-spacing: -0.028em;\n}\n.dialog-desc {\n  margin-top: 6px;\n  font-size: 13px;\n  line-height: 1.55;\n  color: var(--muted);\n}\n.dialog-field-label {\n  display: block;\n  margin: 16px 0 6px;\n  font-family: var(--mono);\n  font-size: 10.5px;\n  font-weight: 600;\n  color: var(--muted);\n}\n.field {\n  width: 100%;\n  height: 38px;\n  padding: 0 10px;\n  border: 1px solid var(--line);\n  border-radius: 7px;\n  background: #fff;\n  color: var(--ink);\n  font-family: var(--sans);\n  font-size: 12.5px;\n}\n.field-static {\n  display: flex;\n  align-items: center;\n  color: var(--muted);\n  overflow: hidden;\n  white-space: nowrap;\n  text-overflow: ellipsis;\n}\n.field[aria-invalid=\"true\"],\n.field-invalid {\n  border-color: var(--signal);\n  box-shadow: 0 0 0 3px rgba(217, 83, 43, 0.12);\n}\n.field-error {\n  margin-top: 6px;\n  font-size: 11.5px;\n  line-height: 1.45;\n  color: var(--signal-deep);\n}\n.dialog-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  margin-top: 18px;\n}\n.dialog-actions .btn { min-height: 36px; }\n.success-mark {\n  display: grid;\n  place-items: center;\n  width: 34px;\n  height: 34px;\n  margin-bottom: 12px;\n  border-radius: 50%;\n  background: #E7F0EB;\n  color: var(--success);\n}\n.success-mark .icon { color: var(--success); }\n.spinner {\n  width: 12px;\n  height: 12px;\n  border: 2px solid rgba(255, 255, 255, 0.34);\n  border-top-color: #fff;\n  border-radius: 50%;\n  animation: spin 700ms linear infinite;\n}\n\n/* Code and tests */\n.code-wrap {\n  overflow: hidden;\n  border: 1px solid #26313D;\n  border-radius: 12px;\n  background: #121820;\n}\n.code-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 11px 14px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n  font-family: var(--mono);\n  font-size: 11px;\n  color: #A9B6C4;\n}\n.code-head span { display: inline-flex; align-items: center; gap: 7px; }\n.code-pre {\n  max-height: 360px;\n  margin: 0;\n  padding: 18px;\n  overflow: auto;\n  color: #DCE5EC;\n  font-family: var(--mono);\n  font-size: 11.5px;\n  line-height: 1.75;\n  tab-size: 2;\n}\n.tests {\n  padding: 18px;\n  border: 1px solid var(--line-soft);\n  border-radius: 12px;\n  background: #fff;\n}\n.test-row {\n  display: grid;\n  grid-template-columns: 20px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 0;\n  border-bottom: 1px solid var(--line);\n  font-size: 12.5px;\n}\n.test-row:last-of-type { border-bottom: 0; }\n.test-check {\n  display: grid;\n  place-items: center;\n  width: 18px;\n  height: 18px;\n  border-radius: 50%;\n  background: #E7F0EB;\n  color: var(--success);\n}\n.test-check .icon { width: 12px; height: 12px; font-size: 12px; color: var(--success); }\n.test-name { font-family: var(--mono); font-size: 10px; color: var(--muted); }\n.aria-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); }\n.token {\n  padding: 4px 7px;\n  border: 1px solid var(--line);\n  border-radius: 5px;\n  background: #F7F9FB;\n  color: var(--ink-2);\n  font-family: var(--mono);\n  font-size: 10px;\n}\n\n/* Attribution and notes */\n.attribution {\n  display: grid;\n  grid-template-columns: 0.8fr 1.4fr 1.2fr;\n  gap: 28px;\n  margin-top: 20px;\n  padding-top: 16px;\n  border-top: 1px solid var(--line);\n}\n.attribution h4 {\n  margin-bottom: 5px;\n  font-family: var(--mono);\n  font-size: 10px;\n  font-weight: 600;\n  color: var(--muted);\n}\n.attribution p { font-size: 12.5px; line-height: 1.6; }\n.impl-notes {\n  display: grid;\n  grid-template-columns: 1fr 1fr auto;\n  gap: 28px;\n  align-items: end;\n  margin-top: 20px;\n  padding-top: 16px;\n  border-top: 1px solid var(--line);\n}\n.impl-notes h4 {\n  margin-bottom: 5px;\n  font-family: var(--mono);\n  font-size: 10px;\n  font-weight: 600;\n  color: var(--muted);\n}\n.impl-notes p { font-size: 12.5px; line-height: 1.6; color: var(--ink-2); }\n.text-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 4px 0;\n  border: 0;\n  border-bottom: 1px solid var(--line);\n  background: transparent;\n  font-size: 12px;\n  font-weight: 700;\n  cursor: pointer;\n  transition: border-color 160ms ease, color 160ms ease;\n}\n.text-link:hover { color: var(--signal-deep); border-color: var(--signal); }\n.text-link .icon { color: var(--signal); }\n\n/* Switchyard */\n.switch-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);\n  gap: 32px;\n  align-items: start;\n}\n.release-panel {\n  padding: 22px;\n  border: 1px solid var(--line);\n  border-radius: 14px;\n  background: #fff;\n}\n.release-head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 16px;\n}\n.release-name { margin-top: 4px; font-family: var(--mono); font-size: 18px; font-weight: 600; letter-spacing: -0.02em; }\n.chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px 8px;\n  border: 1px solid var(--line);\n  border-radius: 5px;\n  background: #F6F8FA;\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--ink);\n  white-space: nowrap;\n}\n.release-status {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-top: 16px;\n  padding: 10px 0;\n  border-top: 1px solid var(--line);\n  border-bottom: 1px solid var(--line);\n  font-size: 12.5px;\n  font-weight: 600;\n}\n.status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--signal); flex: 0 0 auto; }\n.release-count { margin-left: auto; font-family: var(--mono); font-size: 10.5px; font-weight: 500; color: var(--muted); }\n.rollout { margin-top: 14px; }\n.rollout-labels { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 10.5px; color: var(--muted); }\n.meter { height: 6px; margin-top: 7px; overflow: hidden; border-radius: 3px; background: #E4EAF0; }\n.meter span { display: block; height: 100%; background: var(--ink); }\n.approvals { margin-top: 14px; }\n.approval-row {\n  display: grid;\n  grid-template-columns: 24px minmax(0, 1fr) auto auto;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 0;\n  border-bottom: 1px solid var(--line-soft);\n  font-size: 12px;\n}\n.approval-row:last-child { border-bottom: 0; }\n.avatar {\n  display: grid;\n  place-items: center;\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  background: #E7EDF3;\n  color: var(--ink-2);\n  font-family: var(--mono);\n  font-size: 8.5px;\n  font-weight: 600;\n}\n.approval-state { font-family: var(--mono); font-size: 9.5px; color: var(--muted); }\n.approval-state.pending { color: var(--signal-deep); }\n.approval-row time { font-family: var(--mono); font-size: 9.5px; color: var(--muted); }\n.reconnect { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); }\n.reconnect-flow { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-top: 8px; }\n.flow-step {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 8px;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  background: #F6F8FA;\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--ink-2);\n}\n.flow-arrow { color: #93A1AE; }\n.flow-arrow .icon { width: 12px; height: 12px; font-size: 12px; }\n\n.ownership { padding-top: 14px; border-top: 2px solid var(--ink); }\n.ownership h3 { margin: 6px 0 12px; font-size: 19px; line-height: 1.2; font-weight: 700; letter-spacing: -0.028em; }\n.ownership ul { display: flex; flex-direction: column; gap: 8px; }\n.ownership li { position: relative; padding-left: 13px; font-size: 12.5px; line-height: 1.5; color: var(--ink-2); }\n.ownership li::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 7px;\n  width: 4px;\n  height: 4px;\n  background: var(--signal);\n}\n.impl-note { margin-top: 16px; font-size: 12.5px; line-height: 1.62; color: var(--muted); }\n.tech-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }\n.tech {\n  padding: 4px 6px;\n  border: 1px solid var(--line);\n  border-radius: 5px;\n  background: #F7F9FB;\n  color: var(--ink-2);\n  font-family: var(--mono);\n  font-size: 10px;\n}\n.impl-disclosure { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--line); }\n.impl-disclosure summary {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  min-height: 32px;\n  list-style: none;\n  font-size: 12.5px;\n  font-weight: 600;\n  cursor: pointer;\n}\n.impl-disclosure summary::-webkit-details-marker { display: none; }\n.impl-disclosure summary .icon { color: var(--signal); transition: transform 160ms ease; }\n.impl-disclosure[open] summary .icon { transform: rotate(180deg); }\n.impl-disclosure p { margin-top: 8px; font-size: 12px; line-height: 1.62; color: var(--muted); }\n\n/* scaffold-a11y */\n.scaffold-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);\n  gap: 32px;\n  align-items: start;\n}\n.scaffold-title {\n  font-family: var(--mono);\n  font-size: clamp(30px, 3vw, 38px);\n  font-weight: 600;\n  letter-spacing: -0.04em;\n  line-height: 1.05;\n}\n.terminal {\n  overflow: hidden;\n  border: 1px solid #26313D;\n  border-radius: 14px;\n  background: #121820;\n  box-shadow: 0 24px 50px -34px rgba(18, 24, 32, 0.75);\n}\n.terminal-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 11px 14px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n}\n.terminal-label { font-family: var(--mono); font-size: 10px; color: #9EADBB; }\n.copy-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 30px;\n  padding: 0 9px;\n  border: 1px solid rgba(255, 255, 255, 0.18);\n  border-radius: 6px;\n  background: transparent;\n  color: #C9D6E2;\n  font-family: var(--mono);\n  font-size: 10px;\n  cursor: pointer;\n  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;\n}\n.copy-btn:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.32); color: #fff; }\n.copy-btn .icon { width: 13px; height: 13px; font-size: 13px; }\n.terminal-body {\n  max-height: 300px;\n  margin: 0;\n  padding: 16px;\n  overflow: auto;\n  color: #DCE5EC;\n  font-family: var(--mono);\n  font-size: 11.5px;\n  line-height: 1.85;\n  white-space: pre-wrap;\n}\n.term-prompt { color: #F07A52; }\n.term-cmd { color: #F5F8FA; font-weight: 500; }\n.term-file { color: #C9D6E2; }\n.term-check { color: #9CC4B3; }\n.term-note { color: #9EADBB; }\n.scaffold-copy { font-size: 13.5px; line-height: 1.65; color: var(--muted); }\n.files { display: flex; flex-direction: column; margin-top: 16px; }\n.file-row {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 8px 0;\n  border-bottom: 1px solid var(--line);\n  font-family: var(--mono);\n  font-size: 11px;\n}\n.file-row span:last-child { color: var(--muted); }\n.checks { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }\n.scaffold-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  margin-top: 16px;\n  padding-bottom: 2px;\n  border-bottom: 1px solid var(--line);\n  font-size: 12.5px;\n  font-weight: 700;\n  transition: border-color 160ms ease, color 160ms ease;\n}\n.scaffold-link:hover { color: var(--signal-deep); border-color: var(--signal); }\n.scaffold-link .icon { color: var(--signal); }\n\n/* Stack and experience */\n.stack-table { margin-top: 24px; border-top: 1px solid var(--line); }\n.stack-row {\n  display: grid;\n  grid-template-columns: 140px minmax(0, 1fr) 240px;\n  gap: 20px;\n  align-items: start;\n  padding: 18px 0;\n}\n.stack-row + .stack-row { border-top: 1px solid var(--line); }\n.stack-key { font-family: var(--mono); font-size: 11px; font-weight: 600; }\n.stack-tools { display: flex; flex-wrap: wrap; gap: 6px; }\n.stack-used { font-family: var(--mono); font-size: 10.5px; line-height: 1.7; color: var(--muted); }\n.stack-used a { border-bottom: 1px solid transparent; }\n.stack-used a:hover { color: var(--signal-deep); border-color: var(--signal); }\n\n.exp-table { margin-top: 24px; border-top: 1px solid var(--line); }\n.exp-row {\n  display: grid;\n  grid-template-columns: 160px minmax(0, 1fr);\n  gap: 28px;\n  padding: 22px 0;\n  border-bottom: 1px solid var(--line);\n}\n.exp-period { padding-top: 3px; font-family: var(--mono); font-size: 11px; color: var(--muted); }\n.exp-role { font-size: 20px; line-height: 1.2; font-weight: 700; letter-spacing: -0.026em; }\n.exp-company { margin-top: 4px; font-family: var(--mono); font-size: 11.5px; color: var(--muted); }\n.exp-desc { max-width: 62ch; margin-top: 8px; font-size: 13px; line-height: 1.62; color: var(--ink-2); }\n\n/* Contact */\n.contact {\n  position: relative;\n  overflow: hidden;\n  margin-top: 8px;\n  padding: 56px 0 20px;\n  background: var(--ink);\n  color: #F4F7FA;\n  scroll-margin-top: 84px;\n}\n.contact::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(720px 420px at 86% -10%, rgba(116, 157, 197, 0.26), transparent 72%),\n    radial-gradient(520px 360px at 10% 100%, rgba(217, 83, 43, 0.12), transparent 72%);\n}\n.contact-inner {\n  position: relative;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 40px;\n  align-items: end;\n}\n.contact h2 {\n  margin-bottom: 6px;\n  font-family: var(--sans);\n  font-size: 24px;\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: #F4F7FA;\n}\n.contact-role { font-family: var(--mono); font-size: 11px; color: #8FA0AF; }\n.contact-email {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  margin-top: 14px;\n  padding-bottom: 3px;\n  border-bottom: 1px solid transparent;\n  color: #F4F7FA;\n  font-size: clamp(28px, 3.4vw, 44px);\n  font-weight: 600;\n  line-height: 1.12;\n  letter-spacing: -0.045em;\n  transition: color 180ms ease, border-color 180ms ease;\n}\n.contact-email:hover { color: #F2A084; border-color: rgba(240, 122, 82, 0.6); }\n.contact-email .icon { color: #F07A52; }\n.contact-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 16px; }\n.contact-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 18px; }\n.contact-links a {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding-bottom: 2px;\n  border-bottom: 1px solid transparent;\n  color: #C9D6E2;\n  font-size: 12.5px;\n  font-weight: 600;\n  transition: color 160ms ease, border-color 160ms ease;\n}\n.contact-links a:hover { color: #fff; border-color: rgba(255, 255, 255, 0.4); }\n.contact-copy {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 34px;\n  padding: 0 12px;\n  border: 1px solid rgba(255, 255, 255, 0.18);\n  border-radius: 6px;\n  background: transparent;\n  color: #C9D6E2;\n  font-family: var(--mono);\n  font-size: 10.5px;\n  cursor: pointer;\n  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;\n}\n.contact-copy:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.32); color: #fff; }\n.contact-copy .icon { width: 13px; height: 13px; font-size: 13px; }\n.contact-foot {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  margin-top: 44px;\n  padding-top: 14px;\n  border-top: 1px solid rgba(255, 255, 255, 0.14);\n  color: #8FA0AF;\n  font-family: var(--mono);\n  font-size: 10.5px;\n}\n.contact-foot a { display: inline-flex; align-items: center; gap: 5px; color: #C9D6E2; }\n.contact-foot a:hover { color: #fff; }\n\n/* Dialog overlay */\n.dialog-layer { position: fixed; inset: 0; z-index: 80; display: grid; place-items: center; padding: 20px; }\n.dialog-backdrop {\n  position: absolute;\n  inset: 0;\n  background: rgba(18, 24, 32, 0.44);\n  backdrop-filter: blur(5px);\n  animation: fade-in 160ms ease both;\n}\n.live-dialog {\n  position: relative;\n  width: min(100%, 440px);\n  max-height: calc(100vh - 40px);\n  overflow: auto;\n  padding: 22px;\n  border: 1px solid #DEE5EB;\n  border-radius: 16px;\n  background: #fff;\n  box-shadow: 0 40px 90px -30px rgba(18, 24, 32, 0.6);\n  animation: dialog-in 200ms cubic-bezier(0.16, 1, 0.3, 1) both;\n}\n.live-dialog-head { display: flex; justify-content: flex-end; }\n.icon-btn {\n  display: grid;\n  place-items: center;\n  width: 32px;\n  height: 32px;\n  padding: 0;\n  border: 1px solid var(--line);\n  border-radius: 7px;\n  background: #fff;\n  color: var(--muted);\n  cursor: pointer;\n  transition: background-color 160ms ease, color 160ms ease;\n}\n.icon-btn:hover { background: #F1F4F7; color: var(--ink); }\n.live-dialog-body { padding-top: 2px; }\n.live-dialog-body .dialog-title { font-size: 21px; }\n.live-dialog-body .dialog-desc { margin-top: 7px; font-size: 13.5px; }\n.live-dialog-body .field { margin-top: 0; height: 40px; }\n.live-dialog-body .dialog-actions { margin-top: 20px; }\n.live-dialog-body .btn { min-height: 38px; }\n\n.sr-only {\n  position: absolute !important;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n@keyframes spin { to { transform: rotate(360deg); } }\n@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }\n@keyframes dialog-in {\n  from { opacity: 0; transform: translateY(8px) scale(0.985); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n@media (max-width: 980px) {\n  .wrap { width: calc(100% - 48px); }\n  .intro {\n    grid-template-columns: 1fr;\n    gap: 26px;\n    padding: 38px 0 34px;\n  }\n  .intro-right { max-width: 620px; }\n  .project { padding: 46px 0 62px; }\n  .project-head { grid-template-columns: 1fr; gap: 10px; }\n  .project-meta { text-align: left; }\n  .project-meta span { display: inline; margin-right: 12px; }\n  .switch-grid,\n  .scaffold-grid { grid-template-columns: 1fr; gap: 26px; }\n  .specimen-body { grid-template-columns: 1fr; }\n  .inspector {\n    display: none;\n    border-right: 0;\n    border-bottom: 1px solid var(--line-soft);\n  }\n  .mobile-switch { display: flex; }\n  .specimen.show-controls .inspector { display: block; }\n  .specimen.show-controls .specimen-panels { display: none; }\n  .specimen[data-tab=\"code\"] .inspector,\n  .specimen[data-tab=\"tests\"] .inspector { display: none !important; }\n  .specimen[data-tab=\"code\"] .mobile-switch,\n  .specimen[data-tab=\"tests\"] .mobile-switch { display: none; }\n  .specimen-panels { padding: 14px; }\n  .attribution { grid-template-columns: 1fr; gap: 14px; }\n  .impl-notes { grid-template-columns: 1fr 1fr; gap: 18px; align-items: start; }\n  .impl-notes .text-link { grid-column: 1 / -1; justify-self: start; }\n  .stack-row { grid-template-columns: 120px minmax(0, 1fr) 190px; }\n  .exp-row { grid-template-columns: 130px minmax(0, 1fr); gap: 20px; }\n  .contact-inner { grid-template-columns: 1fr; gap: 26px; }\n  .contact-actions { align-items: flex-start; }\n  .contact-links { justify-content: flex-start; }\n}\n\n@media (max-width: 820px) {\n  .header-inner {\n    min-height: 0;\n    grid-template-columns: 1fr auto;\n    gap: 8px 18px;\n    padding: 12px 0;\n  }\n  .brand { grid-column: 1; grid-row: 1; }\n  .header-resume { grid-column: 2; grid-row: 1; }\n  .nav { grid-column: 1 / -1; grid-row: 2; justify-self: start; gap: 22px; }\n  .project { scroll-margin-top: 112px; }\n  .contact { scroll-margin-top: 112px; }\n}\n\n@media (max-width: 620px) {\n  .wrap { width: calc(100% - 36px); }\n  .intro h1 { font-size: clamp(46px, 12vw, 62px); }\n  .profile { font-size: 16px; }\n  .specimen-head { flex-direction: column; gap: 14px; padding: 18px 18px 0; }\n  .btn-signal { align-self: flex-start; }\n  .tabs { gap: 20px; padding: 0 18px; margin-top: 14px; }\n  .specimen-title { font-size: 23px; }\n  .preview-surface { min-height: 322px; padding: 16px; }\n  .dialog-card { padding: 18px; }\n  .dialog-title { font-size: 18px; }\n  .specimen-panels { padding: 12px; }\n  .attribution { gap: 12px; }\n  .impl-notes { grid-template-columns: 1fr; gap: 14px; }\n  .release-panel { padding: 18px; }\n  .approval-row { grid-template-columns: 24px minmax(0, 1fr) auto; }\n  .approval-row time { display: none; }\n  .flow-arrow { transform: rotate(90deg); }\n  .reconnect-flow { flex-direction: column; align-items: flex-start; }\n  .stack-row { grid-template-columns: 1fr; gap: 8px; padding: 16px 0; }\n  .stack-used { font-size: 10px; }\n  .exp-row { grid-template-columns: 1fr; gap: 7px; }\n  .exp-period { padding-top: 0; }\n  .contact { padding-top: 42px; }\n  .contact-email { font-size: clamp(24px, 7.6vw, 32px); }\n  .contact-links { gap: 14px; }\n  .contact-foot { flex-direction: column; align-items: flex-start; margin-top: 32px; }\n  .dialog-layer { padding: 14px; }\n  .live-dialog { padding: 18px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  html { scroll-behavior: auto; }\n  .gt *,\n  .gt *::before,\n  .gt *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n</style>\n<div class=\"gt\" data-kid=\"1\" data-name=\"page root container\" id=\"top\">\n<div aria-hidden=\"true\" class=\"gt-ambient\" data-kid=\"1-1\" data-name=\"ambient gradient and grid background\"></div>\n<div class=\"gt-content\" data-kid=\"1-2\" data-name=\"main page content wrapper\">\n<a class=\"skip-link\" data-kid=\"1-2-1\" data-name=\"skip-to-content link\" href=\"#work\">Skip to work</a>\n<header class=\"site-header\" data-kid=\"1-2-2\" data-name=\"sticky site header\">\n<div class=\"wrap header-inner\" data-kid=\"1-2-2-1\" data-name=\"header layout grid\">\n<a aria-label=\"Inez Park, back to top\" class=\"brand\" data-kid=\"1-2-2-1-1\" data-name=\"brand wordmark link to top\" href=\"#top\">\n<span aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-2-2-1-1-1\" data-name=\"brand monogram mark\">IP</span>\n<span data-kid=\"1-2-2-1-1-2\" data-name=\"brand name text\">Inez Park</span>\n</a>\n<nav aria-label=\"Primary\" class=\"nav\" data-kid=\"1-2-2-1-2\" data-name=\"primary navigation links\">\n<a data-kid=\"1-2-2-1-2-1\" data-name=\"navigation link to work section\" href=\"#work\">Work</a>\n<a data-kid=\"1-2-2-1-2-2\" data-name=\"navigation link to stack section\" href=\"#stack\">Stack</a>\n<a data-kid=\"1-2-2-1-2-3\" data-name=\"navigation link to experience section\" href=\"#experience\">Experience</a>\n<a data-kid=\"1-2-2-1-2-4\" data-name=\"navigation link to contact section\" href=\"#contact\">Contact</a>\n</nav>\n<a class=\"header-resume\" data-kid=\"1-2-2-1-3\" data-name=\"header resume request link\" href=\"mailto:inez@inezpark.dev?subject=R%C3%A9sum%C3%A9%20request\">\n          Request résumé\n          <i aria-hidden=\"true\" class=\"icon icon-arrow-up-right\" data-kid=\"1-2-2-1-3-1\" data-name=\"arrow-up-right icon\"></i>\n</a>\n</div>\n</header>\n<main data-kid=\"1-2-3\" data-name=\"main content region\">\n<section aria-labelledby=\"intro-title\" class=\"intro wrap\" data-kid=\"1-2-3-1\" data-name=\"intro hero section\">\n<div data-kid=\"1-2-3-1-1\" data-name=\"hero title block\">\n<h1 data-kid=\"1-2-3-1-1-1\" data-name=\"hero name headline\" id=\"intro-title\">Inez Park</h1>\n<p class=\"intro-role\" data-kid=\"1-2-3-1-1-2\" data-name=\"hero role subtitle\">Full Stack &amp; Frontend Engineer</p>\n</div>\n<div class=\"intro-right\" data-kid=\"1-2-3-1-2\" data-name=\"hero right column\">\n<p class=\"profile\" data-kid=\"1-2-3-1-2-1\" data-name=\"profile summary bio text\">I build product interfaces and the services behind them. Six years across release tooling, design systems, and billing software.</p>\n<div class=\"meta-row\" data-kid=\"1-2-3-1-2-2\" data-name=\"meta info row of location and site\">\n<span data-kid=\"1-2-3-1-2-2-1\" data-name=\"location text\">Brooklyn, NY</span>\n<span data-kid=\"1-2-3-1-2-2-2\" data-name=\"website text\">inezpark.dev</span>\n</div>\n<div class=\"intro-links\" data-kid=\"1-2-3-1-2-3\" data-name=\"social and contact links row\">\n<a data-kid=\"1-2-3-1-2-3-1\" data-name=\"GitHub profile link\" href=\"https://github.com/inezpark\" rel=\"noreferrer\" target=\"_blank\">\n              GitHub\n              <i aria-hidden=\"true\" class=\"icon icon-sm icon-arrow-up-right\" data-kid=\"1-2-3-1-2-3-1-1\" data-name=\"arrow-up-right icon\"></i>\n</a>\n<a data-kid=\"1-2-3-1-2-3-2\" data-name=\"LinkedIn profile link\" href=\"https://linkedin.com/in/inezpark\" rel=\"noreferrer\" target=\"_blank\">\n              LinkedIn\n              <i aria-hidden=\"true\" class=\"icon icon-sm icon-arrow-up-right\" data-kid=\"1-2-3-1-2-3-2-1\" data-name=\"arrow-up-right icon\"></i>\n</a>\n<a data-kid=\"1-2-3-1-2-3-3\" data-name=\"email contact link\" href=\"mailto:inez@inezpark.dev\">\n              Email\n              <i aria-hidden=\"true\" class=\"icon icon-sm icon-mail\" data-kid=\"1-2-3-1-2-3-3-1\" data-name=\"mail icon\"></i>\n</a>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"facet-title\" class=\"project wrap\" data-kid=\"1-2-3-2\" data-name=\"Facet project section\" id=\"work\">\n<div class=\"project-head\" data-kid=\"1-2-3-2-1\" data-name=\"project heading block\">\n<div data-kid=\"1-2-3-2-1-1\" data-name=\"project title and description block\">\n<h2 data-kid=\"1-2-3-2-1-1-1\" data-name=\"project title heading\" id=\"facet-title\">Facet</h2>\n<p class=\"project-sub\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"project summary description\">A workbench for inspecting component behavior, copying the implementation, and running accessibility checks before a release.</p>\n</div>\n<p class=\"project-meta\" data-kid=\"1-2-3-2-1-2\" data-name=\"project meta info\">\n<span data-kid=\"1-2-3-2-1-2-1\" data-name=\"project meta category label\">Design systems</span>\n<span data-kid=\"1-2-3-2-1-2-2\" data-name=\"project meta company label\">Tessellate</span>\n<span data-kid=\"1-2-3-2-1-2-3\" data-name=\"project meta date range label\">2022–Present</span>\n</p>\n</div>\n<div class=\"specimen\" data-kid=\"1-2-3-2-2\" data-name=\"glass specimen interactive panel\" data-tab=\"preview\">\n<div class=\"specimen-head\" data-kid=\"1-2-3-2-2-1\" data-name=\"specimen header bar\">\n<div data-kid=\"1-2-3-2-2-1-1\" data-name=\"specimen title block\">\n<p class=\"path\" data-kid=\"1-2-3-2-2-1-1-1\" data-name=\"specimen file path breadcrumb\">Facet / components / dialog</p>\n<h3 class=\"specimen-title\" data-kid=\"1-2-3-2-2-1-1-2\" data-name=\"specimen component name heading\">Dialog</h3>\n<p class=\"specimen-sub\" data-kid=\"1-2-3-2-2-1-1-3\" data-name=\"specimen component description\">Confirmation dialog with focus management, validation, and async states.</p>\n</div>\n<button aria-controls=\"live-dialog\" aria-haspopup=\"dialog\" class=\"btn btn-signal\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"try dialog trigger button\" id=\"try-dialog\" type=\"button\">\n              Try dialog\n              <i aria-hidden=\"true\" class=\"icon icon-arrow-right\" data-kid=\"1-2-3-2-2-1-2-1\" data-name=\"arrow-right icon\"></i>\n</button>\n</div>\n<div aria-label=\"Dialog specimen view\" class=\"tabs\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-2\" data-name=\"specimen view tabs\" data-reason=\"aria-selected and tabindex rewritten by script so focus order and selection reflect current tab\" role=\"tablist\">\n<button aria-controls=\"panel-preview\" aria-selected=\"true\" class=\"tab\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"preview tab button\" data-reason=\"aria-selected and tabindex state rewritten by tab-switching script\" data-tab=\"preview\" id=\"tab-preview\" role=\"tab\" type=\"button\">Preview</button>\n<button aria-controls=\"panel-code\" aria-selected=\"false\" class=\"tab\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"code tab button\" data-reason=\"aria-selected and tabindex state rewritten by tab-switching script\" data-tab=\"code\" id=\"tab-code\" role=\"tab\" tabindex=\"-1\" type=\"button\">Code</button>\n<button aria-controls=\"panel-tests\" aria-selected=\"false\" class=\"tab\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"tests tab button\" data-reason=\"aria-selected and tabindex state rewritten by tab-switching script\" data-tab=\"tests\" id=\"tab-tests\" role=\"tab\" tabindex=\"-1\" type=\"button\">Tests</button>\n</div>\n<div aria-label=\"Dialog preview or controls\" class=\"mobile-switch\" data-kid=\"1-2-3-2-2-3\" data-name=\"mobile view switch group\" role=\"group\">\n<button aria-pressed=\"true\" class=\"active\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-3-1\" data-mobile-view=\"preview\" data-name=\"mobile preview toggle button\" data-reason=\"active class and aria-pressed toggled by script on click\" type=\"button\">Preview</button>\n<button aria-pressed=\"false\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-3-2\" data-mobile-view=\"controls\" data-name=\"mobile controls toggle button\" data-reason=\"active class and aria-pressed toggled by script on click\" type=\"button\">Controls</button>\n</div>\n<div class=\"specimen-body\" data-kid=\"1-2-3-2-2-4\" data-name=\"specimen body two-column layout\">\n<aside aria-label=\"Dialog controls\" class=\"inspector\" data-kid=\"1-2-3-2-2-4-1\" data-name=\"state inspector panel\">\n<h4 data-kid=\"1-2-3-2-2-4-1-1\" data-name=\"state controls heading\" id=\"dialog-state-label\">State</h4>\n<div aria-labelledby=\"dialog-state-label\" class=\"state-list\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-4-1-2\" data-name=\"state radio group\" data-reason=\"hidden state of preview cards driven by selected radio value\" role=\"radiogroup\">\n<label class=\"state-option\" data-kid=\"1-2-3-2-2-4-1-2-1\" data-name=\"default state radio option\">\n<input checked=\"\" data-kid=\"1-2-3-2-2-4-1-2-1-1\" data-name=\"default state radio input\" name=\"dialog-state\" type=\"radio\" value=\"default\"/>\n<span data-kid=\"1-2-3-2-2-4-1-2-1-2\" data-name=\"state label default text\">Default</span>\n<span aria-hidden=\"true\" class=\"state-dot\" data-kid=\"1-2-3-2-2-4-1-2-1-3\" data-name=\"state indicator dot\"></span>\n</label>\n<label class=\"state-option\" data-kid=\"1-2-3-2-2-4-1-2-2\" data-name=\"validation error state radio option\">\n<input data-kid=\"1-2-3-2-2-4-1-2-2-1\" data-name=\"validation error radio input\" name=\"dialog-state\" type=\"radio\" value=\"validation\"/>\n<span data-kid=\"1-2-3-2-2-4-1-2-2-2\" data-name=\"state label validation error text\">Validation error</span>\n<span aria-hidden=\"true\" class=\"state-dot\" data-kid=\"1-2-3-2-2-4-1-2-2-3\" data-name=\"state indicator dot\"></span>\n</label>\n<label class=\"state-option\" data-kid=\"1-2-3-2-2-4-1-2-3\" data-name=\"submitting state radio option\">\n<input data-kid=\"1-2-3-2-2-4-1-2-3-1\" data-name=\"submitting state radio input\" name=\"dialog-state\" type=\"radio\" value=\"submitting\"/>\n<span data-kid=\"1-2-3-2-2-4-1-2-3-2\" data-name=\"state label submitting text\">Submitting</span>\n<span aria-hidden=\"true\" class=\"state-dot\" data-kid=\"1-2-3-2-2-4-1-2-3-3\" data-name=\"state indicator dot\"></span>\n</label>\n<label class=\"state-option\" data-kid=\"1-2-3-2-2-4-1-2-4\" data-name=\"success state radio option\">\n<input data-kid=\"1-2-3-2-2-4-1-2-4-1\" data-name=\"success state radio input\" name=\"dialog-state\" type=\"radio\" value=\"success\"/>\n<span data-kid=\"1-2-3-2-2-4-1-2-4-2\" data-name=\"state label success text\">Success</span>\n<span aria-hidden=\"true\" class=\"state-dot\" data-kid=\"1-2-3-2-2-4-1-2-4-3\" data-name=\"state indicator dot\"></span>\n</label>\n</div>\n<dl class=\"api-list\" data-kid=\"1-2-3-2-2-4-1-3\" data-name=\"component API list\">\n<div class=\"api-row\" data-kid=\"1-2-3-2-2-4-1-3-1\" data-name=\"API prop row for variant\"><dt data-kid=\"1-2-3-2-2-4-1-3-1-1\" data-name=\"API prop name variant\">variant</dt><dd data-kid=\"1-2-3-2-2-4-1-3-1-2\" data-name=\"API prop value confirm\">confirm</dd></div>\n<div class=\"api-row\" data-kid=\"1-2-3-2-2-4-1-3-2\" data-name=\"API prop row for initialFocus\"><dt data-kid=\"1-2-3-2-2-4-1-3-2-1\" data-name=\"API prop name initialFocus\">initialFocus</dt><dd data-kid=\"1-2-3-2-2-4-1-3-2-2\" data-name=\"API prop value cancel\">cancel</dd></div>\n<div class=\"api-row\" data-kid=\"1-2-3-2-2-4-1-3-3\" data-name=\"API prop row for onConfirm\"><dt data-kid=\"1-2-3-2-2-4-1-3-3-1\" data-name=\"API prop name onConfirm\">onConfirm</dt><dd data-kid=\"1-2-3-2-2-4-1-3-3-2\" data-name=\"API prop value async\">async</dd></div>\n</dl>\n</aside>\n<div class=\"specimen-panels\" data-kid=\"1-2-3-2-2-4-2\" data-name=\"specimen tab panels container\">\n<section aria-labelledby=\"tab-preview\" class=\"tab-panel\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-4-2-1\" data-name=\"preview tab panel\" data-reason=\"panel visibility toggled via hidden attribute by tab-switching script\" id=\"panel-preview\" role=\"tabpanel\" tabindex=\"0\">\n<div class=\"preview-surface\" data-kid=\"1-2-3-2-2-4-2-1-1\" data-name=\"dialog preview surface\">\n<p aria-live=\"polite\" class=\"sr-only\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-4-2-1-1-1\" data-name=\"screen reader state announcement\" data-reason=\"text content written by script to reflect current state\" id=\"preview-state-label\">Dialog preview: Default state.</p>\n<div aria-hidden=\"true\" class=\"dialog-card\" data-dialog-state=\"default\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-4-2-1-1-2\" data-name=\"default state dialog card\" data-reason=\"shown/hidden driven by current state selection\">\n<h4 class=\"dialog-title\" data-kid=\"1-2-3-2-2-4-2-1-1-2-1\" data-name=\"dialog card title\">Publish library changes?</h4>\n<p class=\"dialog-desc\" data-kid=\"1-2-3-2-2-4-2-1-1-2-2\" data-name=\"dialog card description\">14 components will be updated for every workspace.</p>\n<span class=\"dialog-field-label\" data-kid=\"1-2-3-2-2-4-2-1-1-2-3\" data-name=\"release note field label\">Release note</span>\n<div class=\"field field-static\" data-kid=\"1-2-3-2-2-4-2-1-1-2-4\" data-name=\"static release note field value\">Align dialog spacing with the 8px scale</div>\n<div class=\"dialog-actions\" data-kid=\"1-2-3-2-2-4-2-1-1-2-5\" data-name=\"dialog card action buttons\">\n<span class=\"btn btn-secondary\" data-kid=\"1-2-3-2-2-4-2-1-1-2-5-1\" data-name=\"cancel action button\">Cancel</span>\n<span class=\"btn btn-primary\" data-kid=\"1-2-3-2-2-4-2-1-1-2-5-2\" data-name=\"publish action button\">Publish</span>\n</div>\n</div>\n<div aria-hidden=\"true\" class=\"dialog-card\" data-dialog-state=\"validation\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-4-2-1-1-3\" data-name=\"validation error state dialog card\" data-reason=\"shown/hidden driven by current state selection\" hidden=\"\">\n<h4 class=\"dialog-title\" data-kid=\"1-2-3-2-2-4-2-1-1-3-1\" data-name=\"dialog card title\">Publish library changes?</h4>\n<p class=\"dialog-desc\" data-kid=\"1-2-3-2-2-4-2-1-1-3-2\" data-name=\"dialog card description\">14 components will be updated for every workspace.</p>\n<span class=\"dialog-field-label\" data-kid=\"1-2-3-2-2-4-2-1-1-3-3\" data-name=\"release note field label\">Release note</span>\n<div class=\"field field-invalid\" data-kid=\"1-2-3-2-2-4-2-1-1-3-4\" data-name=\"invalid empty release note field\"></div>\n<p class=\"field-error\" data-kid=\"1-2-3-2-2-4-2-1-1-3-5\" data-name=\"field error message text\">Add a release note before publishing.</p>\n<div class=\"dialog-actions\" data-kid=\"1-2-3-2-2-4-2-1-1-3-6\" data-name=\"dialog card action buttons\">\n<span class=\"btn btn-secondary\" data-kid=\"1-2-3-2-2-4-2-1-1-3-6-1\" data-name=\"cancel action button\">Cancel</span>\n<span class=\"btn btn-primary\" data-kid=\"1-2-3-2-2-4-2-1-1-3-6-2\" data-name=\"publish action button\">Publish</span>\n</div>\n</div>\n<div aria-hidden=\"true\" class=\"dialog-card\" data-dialog-state=\"submitting\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-4-2-1-1-4\" data-name=\"submitting state dialog card\" data-reason=\"shown/hidden driven by current state selection\" hidden=\"\">\n<h4 class=\"dialog-title\" data-kid=\"1-2-3-2-2-4-2-1-1-4-1\" data-name=\"dialog card title\">Publish library changes?</h4>\n<p class=\"dialog-desc\" data-kid=\"1-2-3-2-2-4-2-1-1-4-2\" data-name=\"dialog card description\">14 components will be updated for every workspace.</p>\n<span class=\"dialog-field-label\" data-kid=\"1-2-3-2-2-4-2-1-1-4-3\" data-name=\"release note field label\">Release note</span>\n<div class=\"field field-static\" data-kid=\"1-2-3-2-2-4-2-1-1-4-4\" data-name=\"static release note field value\">Align dialog spacing with the 8px scale</div>\n<div class=\"dialog-actions\" data-kid=\"1-2-3-2-2-4-2-1-1-4-5\" data-name=\"dialog card action buttons\">\n<span class=\"btn btn-secondary\" data-kid=\"1-2-3-2-2-4-2-1-1-4-5-1\" data-name=\"cancel action button\">Cancel</span>\n<span class=\"btn btn-primary\" data-kid=\"1-2-3-2-2-4-2-1-1-4-5-2\" data-name=\"loading state publish button\"><span aria-hidden=\"true\" class=\"spinner\" data-kid=\"1-2-3-2-2-4-2-1-1-4-5-2-1\" data-name=\"loading spinner icon\"></span>Publishing…</span>\n</div>\n</div>\n<div aria-hidden=\"true\" class=\"dialog-card\" data-dialog-state=\"success\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-4-2-1-1-5\" data-name=\"success state dialog card\" data-reason=\"shown/hidden driven by current state selection\" hidden=\"\">\n<div class=\"success-mark\" data-kid=\"1-2-3-2-2-4-2-1-1-5-1\" data-name=\"success checkmark circle\"><i aria-hidden=\"true\" class=\"icon icon-check\" data-kid=\"1-2-3-2-2-4-2-1-1-5-1-1\" data-name=\"checkmark icon\"></i></div>\n<h4 class=\"dialog-title\" data-kid=\"1-2-3-2-2-4-2-1-1-5-2\" data-name=\"success dialog title\">Published</h4>\n<p class=\"dialog-desc\" data-kid=\"1-2-3-2-2-4-2-1-1-5-3\" data-name=\"success dialog description\">The dialog component is live in the shared library.</p>\n<div class=\"dialog-actions\" data-kid=\"1-2-3-2-2-4-2-1-1-5-4\" data-name=\"dialog card action buttons\">\n<span class=\"btn btn-primary\" data-kid=\"1-2-3-2-2-4-2-1-1-5-4-1\" data-name=\"done action button\">Done</span>\n</div>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"tab-code\" class=\"tab-panel\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-4-2-2\" data-name=\"code tab panel\" data-reason=\"panel visibility toggled via hidden attribute by tab-switching script\" hidden=\"\" id=\"panel-code\" role=\"tabpanel\" tabindex=\"0\">\n<div class=\"code-wrap\" data-kid=\"1-2-3-2-2-4-2-2-1\" data-name=\"code block wrapper\">\n<div class=\"code-head\" data-kid=\"1-2-3-2-2-4-2-2-1-1\" data-name=\"code block header bar\">\n<span data-kid=\"1-2-3-2-2-4-2-2-1-1-1\" data-name=\"filename label with icon\"><i aria-hidden=\"true\" class=\"icon icon-sm icon-code\" data-kid=\"1-2-3-2-2-4-2-2-1-1-1-1\" data-name=\"code icon\"></i>PublishDialog.tsx</span>\n<span data-kid=\"1-2-3-2-2-4-2-2-1-1-2\" data-name=\"language label\">React · TypeScript</span>\n</div>\n<pre class=\"code-pre\" data-kid=\"1-2-3-2-2-4-2-2-1-2\" data-name=\"code block container\"><code data-kid=\"1-2-3-2-2-4-2-2-1-2-1\" data-name=\"component source code\">import { useState } from 'react';\n\nexport function PublishDialog({ onClose, onConfirm }) {\n  const [note, setNote] = useState('');\n  const [error, setError] = useState(null);\n\n  function publish() {\n    if (!note.trim()) {\n      setError('Add a release note before publishing.');\n      return;\n    }\n    onConfirm({ note });\n  }\n\n  return (\n    &lt;Dialog role=\"dialog\" aria-modal=\"true\"&gt;\n      &lt;Dialog.Title&gt;Publish library changes?&lt;/Dialog.Title&gt;\n      &lt;Dialog.Description&gt;\n        14 components will be updated for every workspace.\n      &lt;/Dialog.Description&gt;\n\n      &lt;label htmlFor=\"release-note\"&gt;Release note&lt;/label&gt;\n      &lt;input\n        id=\"release-note\"\n        value={note}\n        aria-invalid={Boolean(error)}\n        aria-describedby={error ? 'release-note-error' : undefined}\n        onChange={(event) =&gt; setNote(event.target.value)}\n      /&gt;\n      {error &amp;&amp; &lt;p id=\"release-note-error\"&gt;{error}&lt;/p&gt;}\n\n      &lt;Dialog.Actions&gt;\n        &lt;button onClick={onClose}&gt;Cancel&lt;/button&gt;\n        &lt;button onClick={publish}&gt;Publish&lt;/button&gt;\n      &lt;/Dialog.Actions&gt;\n    &lt;/Dialog&gt;\n  );\n}</code></pre>\n</div>\n</section>\n<section aria-labelledby=\"tab-tests\" class=\"tab-panel\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2-4-2-3\" data-name=\"tests tab panel\" data-reason=\"panel visibility toggled via hidden attribute by tab-switching script\" hidden=\"\" id=\"panel-tests\" role=\"tabpanel\" tabindex=\"0\">\n<div class=\"tests\" data-kid=\"1-2-3-2-2-4-2-3-1\" data-name=\"tests results card\">\n<div class=\"test-row\" data-kid=\"1-2-3-2-2-4-2-3-1-1\" data-name=\"test result row\">\n<span class=\"test-check\" data-kid=\"1-2-3-2-2-4-2-3-1-1-1\" data-name=\"passing checkmark mark\"><i aria-hidden=\"true\" class=\"icon icon-check\" data-kid=\"1-2-3-2-2-4-2-3-1-1-1-1\" data-name=\"checkmark icon\"></i></span>\n<span data-kid=\"1-2-3-2-2-4-2-3-1-1-2\" data-name=\"test description text\">Focus moves to Cancel when the dialog opens</span>\n<span class=\"test-name\" data-kid=\"1-2-3-2-2-4-2-3-1-1-3\" data-name=\"test file name\">focus.test.tsx</span>\n</div>\n<div class=\"test-row\" data-kid=\"1-2-3-2-2-4-2-3-1-2\" data-name=\"test result row\">\n<span class=\"test-check\" data-kid=\"1-2-3-2-2-4-2-3-1-2-1\" data-name=\"passing checkmark mark\"><i aria-hidden=\"true\" class=\"icon icon-check\" data-kid=\"1-2-3-2-2-4-2-3-1-2-1-1\" data-name=\"checkmark icon\"></i></span>\n<span data-kid=\"1-2-3-2-2-4-2-3-1-2-2\" data-name=\"test description text\">Escape closes and restores focus to the trigger</span>\n<span class=\"test-name\" data-kid=\"1-2-3-2-2-4-2-3-1-2-3\" data-name=\"test file name\">escape.test.tsx</span>\n</div>\n<div class=\"test-row\" data-kid=\"1-2-3-2-2-4-2-3-1-3\" data-name=\"test result row\">\n<span class=\"test-check\" data-kid=\"1-2-3-2-2-4-2-3-1-3-1\" data-name=\"passing checkmark mark\"><i aria-hidden=\"true\" class=\"icon icon-check\" data-kid=\"1-2-3-2-2-4-2-3-1-3-1-1\" data-name=\"checkmark icon\"></i></span>\n<span data-kid=\"1-2-3-2-2-4-2-3-1-3-2\" data-name=\"test description text\">Invalid publish is announced once</span>\n<span class=\"test-name\" data-kid=\"1-2-3-2-2-4-2-3-1-3-3\" data-name=\"test file name\">validation.test.tsx</span>\n</div>\n<div class=\"test-row\" data-kid=\"1-2-3-2-2-4-2-3-1-4\" data-name=\"test result row\">\n<span class=\"test-check\" data-kid=\"1-2-3-2-2-4-2-3-1-4-1\" data-name=\"passing checkmark mark\"><i aria-hidden=\"true\" class=\"icon icon-check\" data-kid=\"1-2-3-2-2-4-2-3-1-4-1-1\" data-name=\"checkmark icon\"></i></span>\n<span data-kid=\"1-2-3-2-2-4-2-3-1-4-2\" data-name=\"test description text\">Tab order stays inside the dialog</span>\n<span class=\"test-name\" data-kid=\"1-2-3-2-2-4-2-3-1-4-3\" data-name=\"test file name\">trap.test.tsx</span>\n</div>\n<div aria-label=\"ARIA attributes\" class=\"aria-row\" data-kid=\"1-2-3-2-2-4-2-3-1-5\" data-name=\"ARIA attributes token row\">\n<span class=\"token\" data-kid=\"1-2-3-2-2-4-2-3-1-5-1\" data-name=\"ARIA token aria-modal\">aria-modal</span>\n<span class=\"token\" data-kid=\"1-2-3-2-2-4-2-3-1-5-2\" data-name=\"ARIA token aria-labelledby\">aria-labelledby</span>\n<span class=\"token\" data-kid=\"1-2-3-2-2-4-2-3-1-5-3\" data-name=\"ARIA token aria-describedby\">aria-describedby</span>\n<span class=\"token\" data-kid=\"1-2-3-2-2-4-2-3-1-5-4\" data-name=\"ARIA token aria-live\">aria-live</span>\n</div>\n</div>\n</section>\n</div>\n</div>\n</div>\n<div class=\"attribution\" data-kid=\"1-2-3-2-3\" data-name=\"project attribution grid\">\n<div data-kid=\"1-2-3-2-3-1\" data-name=\"attribution role block\">\n<h4 data-kid=\"1-2-3-2-3-1-1\" data-name=\"attribution role heading\">Role</h4>\n<p data-kid=\"1-2-3-2-3-1-2\" data-name=\"attribution role description\">Design systems engineer</p>\n</div>\n<div data-kid=\"1-2-3-2-3-2\" data-name=\"attribution contribution block\">\n<h4 data-kid=\"1-2-3-2-3-2-1\" data-name=\"attribution contribution heading\">Contribution</h4>\n<p data-kid=\"1-2-3-2-3-2-2\" data-name=\"attribution contribution description\">Component API, state handling, token export, accessibility tests</p>\n</div>\n<div data-kid=\"1-2-3-2-3-3\" data-name=\"attribution stack block\">\n<h4 data-kid=\"1-2-3-2-3-3-1\" data-name=\"attribution stack heading\">Stack</h4>\n<p data-kid=\"1-2-3-2-3-3-2\" data-name=\"attribution stack description\">React, TypeScript, Vite, CSS custom properties, axe-core</p>\n</div>\n</div>\n<div class=\"impl-notes\" data-kid=\"1-2-3-2-4\" data-name=\"implementation notes block\">\n<div data-kid=\"1-2-3-2-4-1\" data-name=\"implementation focus note\">\n<h4 data-kid=\"1-2-3-2-4-1-1\" data-name=\"implementation note heading focus\">Focus</h4>\n<p data-kid=\"1-2-3-2-4-1-2\" data-name=\"implementation note text focus behavior\">Focus moves to Cancel on open. Escape closes the dialog and returns focus to the trigger.</p>\n</div>\n<div data-kid=\"1-2-3-2-4-2\" data-name=\"implementation async note\">\n<h4 data-kid=\"1-2-3-2-4-2-1\" data-name=\"implementation note heading async\">Async</h4>\n<p data-kid=\"1-2-3-2-4-2-2\" data-name=\"implementation note text async behavior\">Publish validates the release note, then exposes a live status while the request runs.</p>\n</div>\n<button class=\"text-link\" data-kid=\"1-2-3-2-4-3\" data-name=\"view tests text link button\" data-open-tests=\"\" type=\"button\">\n            View tests\n            <i aria-hidden=\"true\" class=\"icon icon-sm icon-arrow-right\" data-kid=\"1-2-3-2-4-3-1\" data-name=\"arrow-right icon\"></i>\n</button>\n</div>\n</section>\n<section aria-labelledby=\"switchyard-title\" class=\"project wrap\" data-kid=\"1-2-3-3\" data-name=\"Switchyard project section\" id=\"switchyard\">\n<div class=\"project-head\" data-kid=\"1-2-3-3-1\" data-name=\"project heading block\">\n<div data-kid=\"1-2-3-3-1-1\" data-name=\"project title and description block\">\n<h2 data-kid=\"1-2-3-3-1-1-1\" data-name=\"project title heading\" id=\"switchyard-title\">Switchyard</h2>\n<p class=\"project-sub\" data-kid=\"1-2-3-3-1-1-2\" data-name=\"project summary description\">Release approvals and staged rollouts for a multi-tenant SaaS platform.</p>\n</div>\n<p class=\"project-meta\" data-kid=\"1-2-3-3-1-2\" data-name=\"project meta info column\">\n<span data-kid=\"1-2-3-3-1-2-1\" data-name=\"project meta category label\">Release infrastructure</span>\n<span data-kid=\"1-2-3-3-1-2-2\" data-name=\"project meta company label\">Tessellate</span>\n<span data-kid=\"1-2-3-3-1-2-3\" data-name=\"project meta date range label\">2023–Present</span>\n</p>\n</div>\n<div class=\"switch-grid\" data-kid=\"1-2-3-3-2\" data-name=\"Switchyard two-column grid\">\n<div aria-label=\"Switchyard release interface excerpt\" class=\"release-panel\" data-kid=\"1-2-3-3-2-1\" data-name=\"release interface panel\" role=\"group\">\n<div class=\"release-head\" data-kid=\"1-2-3-3-2-1-1\" data-name=\"release header bar\">\n<div data-kid=\"1-2-3-3-2-1-1-1\" data-name=\"release name block\">\n<span class=\"field-label\" data-kid=\"1-2-3-3-2-1-1-1-1\" data-name=\"release field label\">Release</span>\n<p class=\"release-name\" data-kid=\"1-2-3-3-2-1-1-1-2\" data-name=\"release name text\">checkout-api</p>\n</div>\n<span class=\"chip\" data-kid=\"1-2-3-3-2-1-1-2\" data-name=\"environment status chip\">Production</span>\n</div>\n<div class=\"release-status\" data-kid=\"1-2-3-3-2-1-2\" data-name=\"release status row\">\n<span aria-hidden=\"true\" class=\"status-dot\" data-kid=\"1-2-3-3-2-1-2-1\" data-name=\"status indicator dot\"></span>\n<span data-kid=\"1-2-3-3-2-1-2-2\" data-name=\"release status text\">Awaiting approval</span>\n<span class=\"release-count\" data-kid=\"1-2-3-3-2-1-2-3\" data-name=\"approval count text\">2 of 3</span>\n</div>\n<div class=\"rollout\" data-kid=\"1-2-3-3-2-1-3\" data-name=\"rollout progress section\">\n<div class=\"rollout-labels\" data-kid=\"1-2-3-3-2-1-3-1\" data-name=\"rollout progress labels\"><span data-kid=\"1-2-3-3-2-1-3-1-1\" data-name=\"rollout label\">Rollout</span><span data-kid=\"1-2-3-3-2-1-3-1-2\" data-name=\"rollout percentage value\">25%</span></div>\n<div aria-label=\"Rollout at 25 percent\" class=\"meter\" data-kid=\"1-2-3-3-2-1-3-2\" data-name=\"rollout progress meter\" role=\"img\"><span data-kid=\"1-2-3-3-2-1-3-2-1\" data-name=\"rollout progress fill bar\" style=\"width: 25%\"></span></div>\n</div>\n<div class=\"approvals\" data-kid=\"1-2-3-3-2-1-4\" data-name=\"approvals list\">\n<div class=\"approval-row\" data-kid=\"1-2-3-3-2-1-4-1\" data-name=\"approval row\">\n<span aria-hidden=\"true\" class=\"avatar\" data-kid=\"1-2-3-3-2-1-4-1-1\" data-name=\"approver avatar initials\">AO</span>\n<span data-kid=\"1-2-3-3-2-1-4-1-2\" data-name=\"approver name text\">A. Okafor</span>\n<span class=\"approval-state\" data-kid=\"1-2-3-3-2-1-4-1-3\" data-name=\"approval state text\">Approved</span>\n<time data-kid=\"1-2-3-3-2-1-4-1-4\" data-name=\"approval timestamp\">09:44</time>\n</div>\n<div class=\"approval-row\" data-kid=\"1-2-3-3-2-1-4-2\" data-name=\"approval row\">\n<span aria-hidden=\"true\" class=\"avatar\" data-kid=\"1-2-3-3-2-1-4-2-1\" data-name=\"approver avatar initials\">MK</span>\n<span data-kid=\"1-2-3-3-2-1-4-2-2\" data-name=\"approver name text\">M. Kaur</span>\n<span class=\"approval-state\" data-kid=\"1-2-3-3-2-1-4-2-3\" data-name=\"approval state text\">Approved</span>\n<time data-kid=\"1-2-3-3-2-1-4-2-4\" data-name=\"approval timestamp\">09:47</time>\n</div>\n<div class=\"approval-row\" data-kid=\"1-2-3-3-2-1-4-3\" data-name=\"approval row\">\n<span aria-hidden=\"true\" class=\"avatar\" data-kid=\"1-2-3-3-2-1-4-3-1\" data-name=\"approver avatar initials\">JR</span>\n<span data-kid=\"1-2-3-3-2-1-4-3-2\" data-name=\"approver name text\">J. Reyes</span>\n<span class=\"approval-state pending\" data-kid=\"1-2-3-3-2-1-4-3-3\" data-name=\"approval state text pending\">Pending</span>\n<time data-kid=\"1-2-3-3-2-1-4-3-4\" data-name=\"approval timestamp placeholder\">—</time>\n</div>\n</div>\n<div class=\"reconnect\" data-kid=\"1-2-3-3-2-1-5\" data-name=\"reconnect path section\">\n<span class=\"field-label\" data-kid=\"1-2-3-3-2-1-5-1\" data-name=\"reconnect path label\">Reconnect path</span>\n<div class=\"reconnect-flow\" data-kid=\"1-2-3-3-2-1-5-2\" data-name=\"reconnect flow steps\">\n<span class=\"flow-step\" data-kid=\"1-2-3-3-2-1-5-2-1\" data-name=\"flow step socket closed\">Socket closed</span>\n<span class=\"flow-arrow\" data-kid=\"1-2-3-3-2-1-5-2-2\" data-name=\"flow arrow separator\"><i aria-hidden=\"true\" class=\"icon icon-arrow-right\" data-kid=\"1-2-3-3-2-1-5-2-2-1\" data-name=\"arrow-right icon\"></i></span>\n<span class=\"flow-step\" data-kid=\"1-2-3-3-2-1-5-2-3\" data-name=\"flow step mutations queued\">3 mutations queued</span>\n<span class=\"flow-arrow\" data-kid=\"1-2-3-3-2-1-5-2-4\" data-name=\"flow arrow separator\"><i aria-hidden=\"true\" class=\"icon icon-arrow-right\" data-kid=\"1-2-3-3-2-1-5-2-4-1\" data-name=\"arrow-right icon\"></i></span>\n<span class=\"flow-step\" data-kid=\"1-2-3-3-2-1-5-2-5\" data-name=\"flow step replayed in order\">Replayed in order</span>\n</div>\n</div>\n</div>\n<aside aria-label=\"Switchyard ownership\" class=\"ownership\" data-kid=\"1-2-3-3-2-2\" data-name=\"ownership sidebar\">\n<span class=\"field-label\" data-kid=\"1-2-3-3-2-2-1\" data-name=\"ownership section label\">Ownership</span>\n<h3 data-kid=\"1-2-3-3-2-2-2\" data-name=\"ownership role heading\">Frontend lead, product engineer</h3>\n<ul data-kid=\"1-2-3-3-2-2-3\" data-name=\"ownership responsibility list\">\n<li data-kid=\"1-2-3-3-2-2-3-1\" data-name=\"ownership responsibility item approval UI\">Approval and rollout interface</li>\n<li data-kid=\"1-2-3-3-2-2-3-2\" data-name=\"ownership responsibility item release API\">Release-state API</li>\n<li data-kid=\"1-2-3-3-2-2-3-3\" data-name=\"ownership responsibility item optimistic updates\">Optimistic updates</li>\n<li data-kid=\"1-2-3-3-2-2-3-4\" data-name=\"ownership responsibility item reconnect recovery\">Reconnect recovery</li>\n</ul>\n<p class=\"impl-note\" data-kid=\"1-2-3-3-2-2-4\" data-name=\"implementation note text\">Optimistic approvals update the queue immediately. Mutations queue while the socket is down and replay in order on reconnect.</p>\n<div class=\"tech-row\" data-kid=\"1-2-3-3-2-2-5\" data-name=\"technology tags row\">\n<span class=\"tech\" data-kid=\"1-2-3-3-2-2-5-1\" data-name=\"tech tag React\">React</span>\n<span class=\"tech\" data-kid=\"1-2-3-3-2-2-5-2\" data-name=\"tech tag TypeScript\">TypeScript</span>\n<span class=\"tech\" data-kid=\"1-2-3-3-2-2-5-3\" data-name=\"tech tag Go\">Go</span>\n<span class=\"tech\" data-kid=\"1-2-3-3-2-2-5-4\" data-name=\"tech tag PostgreSQL\">PostgreSQL</span>\n<span class=\"tech\" data-kid=\"1-2-3-3-2-2-5-5\" data-name=\"tech tag Redis\">Redis</span>\n<span class=\"tech\" data-kid=\"1-2-3-3-2-2-5-6\" data-name=\"tech tag WebSockets\">WebSockets</span>\n</div>\n<details class=\"impl-disclosure\" data-kid=\"1-2-3-3-2-2-6\" data-name=\"implementation disclosure details\">\n<summary data-kid=\"1-2-3-3-2-2-6-1\" data-name=\"disclosure summary toggle with icon\">View implementation <i aria-hidden=\"true\" class=\"icon icon-sm icon-arrow-down\" data-kid=\"1-2-3-3-2-2-6-1-1\" data-name=\"arrow-down disclosure icon\"></i></summary>\n<p data-kid=\"1-2-3-3-2-2-6-2\" data-name=\"disclosure implementation text\">Release state is served from a Go API. Redis holds the active rollout lease, and the client keeps a mutation queue in IndexedDB until the socket reconnects.</p>\n</details>\n</aside>\n</div>\n</section>\n<section aria-labelledby=\"scaffold-title\" class=\"project wrap\" data-kid=\"1-2-3-4\" data-name=\"scaffold-a11y project section\" id=\"scaffold\">\n<div class=\"project-head\" data-kid=\"1-2-3-4-1\" data-name=\"project heading block\">\n<div data-kid=\"1-2-3-4-1-1\" data-name=\"project title and description block\">\n<h2 class=\"scaffold-title\" data-kid=\"1-2-3-4-1-1-1\" data-name=\"project title heading\" id=\"scaffold-title\">scaffold-a11y</h2>\n<p class=\"project-sub\" data-kid=\"1-2-3-4-1-1-2\" data-name=\"project summary description\">A CLI that generates accessible dialog components and their tests.</p>\n</div>\n<p class=\"project-meta\" data-kid=\"1-2-3-4-1-2\" data-name=\"project meta info column\">\n<span data-kid=\"1-2-3-4-1-2-1\" data-name=\"project meta category label false\">Open source · MIT</span>\n<span data-kid=\"1-2-3-4-1-2-2\" data-name=\"project meta role label\">Maintainer</span>\n<span data-kid=\"1-2-3-4-1-2-3\" data-name=\"project meta date range label\">2024–Present</span>\n</p>\n</div>\n<div class=\"scaffold-grid\" data-kid=\"1-2-3-4-2\" data-name=\"scaffold two-column grid\">\n<div class=\"terminal\" data-kid=\"1-2-3-4-2-1\" data-name=\"terminal window mockup\">\n<div class=\"terminal-head\" data-kid=\"1-2-3-4-2-1-1\" data-name=\"terminal header bar\">\n<span class=\"terminal-label\" data-kid=\"1-2-3-4-2-1-1-1\" data-name=\"terminal label text\">Example run</span>\n<button aria-label=\"Copy CLI command\" class=\"copy-btn\" data-dynamic=\"true\" data-kid=\"1-2-3-4-2-1-1-2\" data-name=\"copy command button\" data-reason=\"label text temporarily replaced with Copied feedback by copy script\" id=\"copy-command\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon icon-clipboard-copy\" data-kid=\"1-2-3-4-2-1-1-2-1\" data-name=\"clipboard copy icon\"></i>\n<span data-copy-label=\"\" data-dynamic=\"true\" data-kid=\"1-2-3-4-2-1-1-2-2\" data-name=\"copy button label\" data-reason=\"default label overwritten with Copied on copy action\">Copy</span>\n</button>\n</div>\n<pre class=\"terminal-body\" data-kid=\"1-2-3-4-2-1-2\" data-name=\"terminal code output\"><span class=\"term-prompt\" data-kid=\"1-2-3-4-2-1-2-1\" data-name=\"terminal prompt symbol\">$</span> <span class=\"term-cmd\" data-kid=\"1-2-3-4-2-1-2-2\" data-name=\"terminal command text\">npx scaffold-a11y dialog --variant confirm</span>\n<span class=\"term-check\" data-kid=\"1-2-3-4-2-1-2-3\" data-name=\"terminal success checkmark\">✔</span> <span class=\"term-file\" data-kid=\"1-2-3-4-2-1-2-4\" data-name=\"terminal output file Dialog.tsx\">Dialog.tsx</span>\n<span class=\"term-check\" data-kid=\"1-2-3-4-2-1-2-5\" data-name=\"terminal success checkmark\">✔</span> <span class=\"term-file\" data-kid=\"1-2-3-4-2-1-2-6\" data-name=\"terminal output file Dialog.test.tsx\">Dialog.test.tsx</span>\n<span class=\"term-check\" data-kid=\"1-2-3-4-2-1-2-7\" data-name=\"terminal success checkmark\">✔</span> <span class=\"term-file\" data-kid=\"1-2-3-4-2-1-2-8\" data-name=\"terminal output file dialog.css\">dialog.css</span>\n<span class=\"term-note\" data-kid=\"1-2-3-4-2-1-2-9\" data-name=\"terminal note text\">4 checks configured: focus trap, Escape, ARIA, async status</span></pre>\n</div>\n<div data-kid=\"1-2-3-4-2-2\" data-name=\"scaffold description sidebar\">\n<p class=\"scaffold-copy\" data-kid=\"1-2-3-4-2-2-1\" data-name=\"scaffold description text\">Generates a typed dialog component and its tests, with focus handling and ARIA wired into the scaffold.</p>\n<div class=\"files\" data-kid=\"1-2-3-4-2-2-2\" data-name=\"generated files list\">\n<div class=\"file-row\" data-kid=\"1-2-3-4-2-2-2-1\" data-name=\"file row\"><span data-dynamic=\"true\" data-kid=\"1-2-3-4-2-2-2-1-1\" data-name=\"generated filename\" data-reason=\"false\">Dialog.tsx</span><span data-kid=\"1-2-3-4-2-2-2-1-2\" data-name=\"generated file type label\">component</span></div>\n<div class=\"file-row\" data-kid=\"1-2-3-4-2-2-2-2\" data-name=\"file row\"><span data-kid=\"1-2-3-4-2-2-2-2-1\" data-name=\"generated filename text\">Dialog.test.tsx</span><span data-kid=\"1-2-3-4-2-2-2-2-2\" data-name=\"generated file type label\">Vitest suite</span></div>\n<div class=\"file-row\" data-kid=\"1-2-3-4-2-2-2-3\" data-name=\"file row\"><span data-kid=\"1-2-3-4-2-2-2-3-1\" data-name=\"generated filename text\">dialog.css</span><span data-kid=\"1-2-3-4-2-2-2-3-2\" data-name=\"generated file type label\">styles</span></div>\n</div>\n<div class=\"checks\" data-kid=\"1-2-3-4-2-2-3\" data-name=\"checks tokens row\">\n<span class=\"token\" data-kid=\"1-2-3-4-2-2-3-1\" data-name=\"check token Focus trap\">Focus trap</span>\n<span class=\"token\" data-kid=\"1-2-3-4-2-2-3-2\" data-name=\"check token Escape\">Escape</span>\n<span class=\"token\" data-kid=\"1-2-3-4-2-2-3-3\" data-name=\"check token ARIA\">ARIA</span>\n</div>\n<div class=\"tech-row\" data-kid=\"1-2-3-4-2-2-4\" data-name=\"technology tags row\">\n<span class=\"tech\" data-kid=\"1-2-3-4-2-2-4-1\" data-name=\"tech tag Node.js\">Node.js</span>\n<span class=\"tech\" data-kid=\"1-2-3-4-2-2-4-2\" data-name=\"tech tag TypeScript\">TypeScript</span>\n<span class=\"tech\" data-kid=\"1-2-3-4-2-2-4-3\" data-name=\"tech tag Vitest\">Vitest</span>\n<span class=\"tech\" data-kid=\"1-2-3-4-2-2-4-4\" data-name=\"tech tag GitHub Actions\">GitHub Actions</span>\n</div>\n<a class=\"scaffold-link\" data-kid=\"1-2-3-4-2-2-5\" data-name=\"GitHub profile link\" href=\"https://github.com/inezpark\" rel=\"noreferrer\" target=\"_blank\">\n              GitHub profile\n              <i aria-hidden=\"true\" class=\"icon icon-sm icon-arrow-up-right\" data-kid=\"1-2-3-4-2-2-5-1\" data-name=\"arrow-up-right icon\"></i>\n</a>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"stack-title\" class=\"project wrap\" data-kid=\"1-2-3-5\" data-name=\"Stack section\" id=\"stack\">\n<div class=\"project-head\" data-kid=\"1-2-3-5-1\" data-name=\"section heading block\">\n<div data-kid=\"1-2-3-5-1-1\" data-name=\"section title block\">\n<h2 data-kid=\"1-2-3-5-1-1-1\" data-name=\"section title heading\" id=\"stack-title\">Stack</h2>\n<p class=\"project-sub\" data-kid=\"1-2-3-5-1-1-2\" data-name=\"section subtitle description\">The tools behind the three projects.</p>\n</div>\n</div>\n<div class=\"stack-table\" data-kid=\"1-2-3-5-2\" data-name=\"stack table\">\n<div class=\"stack-row\" data-kid=\"1-2-3-5-2-1\" data-name=\"stack row Interface\">\n<div class=\"stack-key\" data-kid=\"1-2-3-5-2-1-1\" data-name=\"stack category label Interface\">Interface</div>\n<div class=\"stack-tools\" data-kid=\"1-2-3-5-2-1-2\" data-name=\"interface tools tokens\">\n<span class=\"tech\" data-kid=\"1-2-3-5-2-1-2-1\" data-name=\"tech tag React\">React</span>\n<span class=\"tech\" data-kid=\"1-2-3-5-2-1-2-2\" data-name=\"tech tag TypeScript\">TypeScript</span>\n<span class=\"tech\" data-kid=\"1-2-3-5-2-1-2-3\" data-name=\"tech tag CSS\">CSS</span>\n<span class=\"tech\" data-kid=\"1-2-3-5-2-1-2-4\" data-name=\"tech tag Vite\">Vite</span>\n<span class=\"tech\" data-kid=\"1-2-3-5-2-1-2-5\" data-name=\"tech tag Motion\">Motion</span>\n</div>\n<div class=\"stack-used\" data-kid=\"1-2-3-5-2-1-3\" data-name=\"used in projects text Interface\">Facet, Switchyard</div>\n</div>\n<div class=\"stack-row\" data-kid=\"1-2-3-5-2-2\" data-name=\"stack row Services\">\n<div class=\"stack-key\" data-kid=\"1-2-3-5-2-2-1\" data-name=\"stack category label Services\">Services</div>\n<div class=\"stack-tools\" data-kid=\"1-2-3-5-2-2-2\" data-name=\"services tools tokens\">\n<span class=\"tech\" data-kid=\"1-2-3-5-2-2-2-1\" data-name=\"tech tag Node.js\">Node.js</span>\n<span class=\"tech\" data-kid=\"1-2-3-5-2-2-2-2\" data-name=\"tech tag Go\">Go</span>\n<span class=\"tech\" data-kid=\"1-2-3-5-2-2-2-3\" data-name=\"tech tag PostgreSQL\">PostgreSQL</span>\n<span class=\"tech\" data-kid=\"1-2-3-5-2-2-2-4\" data-name=\"tech tag Redis\">Redis</span>\n<span class=\"tech\" data-kid=\"1-2-3-5-2-2-2-5\" data-name=\"tech tag WebSockets\">WebSockets</span>\n</div>\n<div class=\"stack-used\" data-kid=\"1-2-3-5-2-2-3\" data-name=\"used in projects text Services\">Switchyard, scaffold-a11y</div>\n</div>\n<div class=\"stack-row\" data-kid=\"1-2-3-5-2-3\" data-name=\"stack row Quality\">\n<div class=\"stack-key\" data-kid=\"1-2-3-5-2-3-1\" data-name=\"stack category label Quality\">Quality</div>\n<div class=\"stack-tools\" data-kid=\"1-2-3-5-2-3-2\" data-name=\"quality tools tokens\">\n<span class=\"tech\" data-kid=\"1-2-3-5-2-3-2-1\" data-name=\"tech tag Playwright\">Playwright</span>\n<span class=\"tech\" data-kid=\"1-2-3-5-2-3-2-2\" data-name=\"tech tag Vitest\">Vitest</span>\n<span class=\"tech\" data-kid=\"1-2-3-5-2-3-2-3\" data-name=\"tech tag axe-core\">axe-core</span>\n<span class=\"tech\" data-kid=\"1-2-3-5-2-3-2-4\" data-name=\"tech tag GitHub Actions\">GitHub Actions</span>\n</div>\n<div class=\"stack-used\" data-kid=\"1-2-3-5-2-3-3\" data-name=\"used in projects text Quality\">Facet, scaffold-a11y</div>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"experience-title\" class=\"project wrap\" data-kid=\"1-2-3-6\" data-name=\"Experience section\" id=\"experience\">\n<div class=\"project-head\" data-kid=\"1-2-3-6-1\" data-name=\"section heading block\">\n<div data-kid=\"1-2-3-6-1-1\" data-name=\"section title block\">\n<h2 data-kid=\"1-2-3-6-1-1-1\" data-name=\"section title heading\" id=\"experience-title\">Experience</h2>\n</div>\n</div>\n<div class=\"exp-table\" data-kid=\"1-2-3-6-2\" data-name=\"experience table\">\n<div class=\"exp-row\" data-kid=\"1-2-3-6-2-1\" data-name=\"experience entry row\">\n<p class=\"exp-period\" data-kid=\"1-2-3-6-2-1-1\" data-name=\"experience date range\">2022–Present</p>\n<div data-kid=\"1-2-3-6-2-1-2\" data-name=\"experience details block\">\n<h3 class=\"exp-role\" data-kid=\"1-2-3-6-2-1-2-1\" data-name=\"experience role title\">Senior Full Stack Engineer</h3>\n<p class=\"exp-company\" data-kid=\"1-2-3-6-2-1-2-2\" data-name=\"experience company name\">Tessellate</p>\n<p class=\"exp-desc\" data-kid=\"1-2-3-6-2-1-2-3\" data-name=\"experience description\">Release tooling used by four product teams; frontend lead for Switchyard.</p>\n</div>\n</div>\n<div class=\"exp-row\" data-kid=\"1-2-3-6-2-2\" data-name=\"experience entry row\">\n<p class=\"exp-period\" data-kid=\"1-2-3-6-2-2-1\" data-name=\"experience date range\">2019–2022</p>\n<div data-kid=\"1-2-3-6-2-2-2\" data-name=\"experience details block\">\n<h3 class=\"exp-role\" data-kid=\"1-2-3-6-2-2-2-1\" data-name=\"experience role title\">Frontend Engineer</h3>\n<p class=\"exp-company\" data-kid=\"1-2-3-6-2-2-2-2\" data-name=\"experience company name\">Copperline</p>\n<p class=\"exp-desc\" data-kid=\"1-2-3-6-2-2-2-3\" data-name=\"experience description\">Customer billing portal and internal support tools.</p>\n</div>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"contact-title\" class=\"contact\" data-kid=\"1-2-3-7\" data-name=\"contact section\" id=\"contact\">\n<div class=\"wrap contact-inner\" data-kid=\"1-2-3-7-1\" data-name=\"contact two-column layout\">\n<div data-kid=\"1-2-3-7-1-1\" data-name=\"contact info block\">\n<h2 data-kid=\"1-2-3-7-1-1-1\" data-name=\"contact heading\" id=\"contact-title\">Contact</h2>\n<p class=\"contact-role\" data-kid=\"1-2-3-7-1-1-2\" data-name=\"contact role subtitle\">Inez Park, Full Stack &amp; Frontend Engineer</p>\n<a class=\"contact-email\" data-kid=\"1-2-3-7-1-1-3\" data-name=\"email address link\" href=\"mailto:inez@inezpark.dev\">\n            inez@inezpark.dev\n            <i aria-hidden=\"true\" class=\"icon icon-arrow-up-right\" data-kid=\"1-2-3-7-1-1-3-1\" data-name=\"arrow-up-right icon\"></i>\n</a>\n</div>\n<div class=\"contact-actions\" data-kid=\"1-2-3-7-1-2\" data-name=\"contact action buttons column\">\n<button aria-label=\"Copy email address\" class=\"contact-copy\" data-dynamic=\"true\" data-kid=\"1-2-3-7-1-2-1\" data-name=\"copy email button\" data-reason=\"label text temporarily replaced with Copied feedback by copy script\" id=\"copy-email\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon icon-clipboard-copy\" data-kid=\"1-2-3-7-1-2-1-1\" data-name=\"clipboard copy icon\"></i>\n<span data-copy-label=\"\" data-dynamic=\"true\" data-kid=\"1-2-3-7-1-2-1-2\" data-name=\"copy email button label\" data-reason=\"default label overwritten with Copied on copy action\">Copy email</span>\n</button>\n<div class=\"contact-links\" data-kid=\"1-2-3-7-1-2-2\" data-name=\"contact social and résumé links\">\n<a data-kid=\"1-2-3-7-1-2-2-1\" data-name=\"GitHub profile link\" href=\"https://github.com/inezpark\" rel=\"noreferrer\" target=\"_blank\">GitHub <i aria-hidden=\"true\" class=\"icon icon-sm icon-arrow-up-right\" data-kid=\"1-2-3-7-1-2-2-1-1\" data-name=\"arrow-up-right icon\"></i></a>\n<a data-kid=\"1-2-3-7-1-2-2-2\" data-name=\"LinkedIn profile link\" href=\"https://linkedin.com/in/inezpark\" rel=\"noreferrer\" target=\"_blank\">LinkedIn <i aria-hidden=\"true\" class=\"icon icon-sm icon-arrow-up-right\" data-kid=\"1-2-3-7-1-2-2-2-1\" data-name=\"arrow-up-right icon\"></i></a>\n<a data-kid=\"1-2-3-7-1-2-2-3\" data-name=\"resume request link\" href=\"mailto:inez@inezpark.dev?subject=R%C3%A9sum%C3%A9%20request\">Request résumé <i aria-hidden=\"true\" class=\"icon icon-sm icon-arrow-up-right\" data-kid=\"1-2-3-7-1-2-2-3-1\" data-name=\"arrow-up-right icon\"></i></a>\n</div>\n</div>\n</div>\n<footer class=\"wrap contact-foot\" data-kid=\"1-2-3-7-2\" data-name=\"footer bar\">\n<span data-kid=\"1-2-3-7-2-1\" data-name=\"footer copyright and location text\">Brooklyn, NY · © 2026 Inez Park</span>\n<a data-kid=\"1-2-3-7-2-2\" data-name=\"back to top link\" href=\"#top\">Back to top <i aria-hidden=\"true\" class=\"icon icon-sm icon-arrow-up-right\" data-kid=\"1-2-3-7-2-2-1\" data-name=\"arrow-up-right icon\"></i></a>\n</footer>\n<p aria-live=\"polite\" class=\"sr-only\" data-dynamic=\"true\" data-kid=\"1-2-3-7-3\" data-name=\"screen reader command status\" data-reason=\"textContent populated by copy script for status announcement\" id=\"command-status\"></p>\n<p aria-live=\"polite\" class=\"sr-only\" data-dynamic=\"true\" data-kid=\"1-2-3-7-4\" data-name=\"screen reader email status\" data-reason=\"textContent populated by copy script for status announcement\" id=\"email-status\"></p>\n</section>\n</main>\n</div>\n<div class=\"dialog-layer\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"live dialog overlay layer\" data-reason=\"hidden attribute toggled when opening/closing dialog\" hidden=\"\" id=\"live-dialog\">\n<div aria-hidden=\"true\" class=\"dialog-backdrop\" data-close-dialog=\"\" data-kid=\"1-3-1\" data-name=\"dialog backdrop overlay\"></div>\n<div aria-describedby=\"live-dialog-desc\" aria-labelledby=\"live-dialog-title\" aria-modal=\"true\" class=\"live-dialog\" data-dynamic=\"true\" data-kid=\"1-3-2\" data-name=\"live dialog\" data-reason=\"aria-labelledby and aria-describedby changed to point to form or success view titles as well as hidden attribute\" role=\"dialog\">\n<div class=\"live-dialog-head\" data-kid=\"1-3-2-1\" data-name=\"dialog header bar\">\n<button aria-label=\"Close dialog\" class=\"icon-btn\" data-close-dialog=\"\" data-kid=\"1-3-2-1-1\" data-name=\"close dialog button\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon icon-x\" data-kid=\"1-3-2-1-1-1\" data-name=\"close X icon\"></i>\n</button>\n</div>\n<div class=\"live-dialog-body\" data-dynamic=\"true\" data-kid=\"1-3-2-2\" data-live-view=\"form\" data-name=\"live form view\" data-reason=\"panel visibility driven by hidden attribute during form/success toggling\">\n<h2 class=\"dialog-title\" data-kid=\"1-3-2-2-1\" data-name=\"live dialog title\" id=\"live-dialog-title\">Publish library changes?</h2>\n<p class=\"dialog-desc\" data-kid=\"1-3-2-2-2\" data-name=\"live dialog description\" id=\"live-dialog-desc\">14 components will be updated for every workspace.</p>\n<label class=\"dialog-field-label\" data-kid=\"1-3-2-2-3\" data-name=\"release note field label\" for=\"release-note\">Release note</label>\n<input aria-describedby=\"release-note-error\" autocomplete=\"off\" class=\"field\" data-dynamic=\"true\" data-kid=\"1-3-2-2-4\" data-name=\"release note input field\" data-reason=\"value restored and aria-invalid rewritten by dialog script on each open/submit\" id=\"release-note\" name=\"release-note\" type=\"text\"/>\n<p class=\"field-error\" data-dynamic=\"true\" data-kid=\"1-3-2-2-5\" data-name=\"field error message\" data-reason=\"hidden attribute toggled by validation logic\" hidden=\"\" id=\"release-note-error\">Add a release note before publishing.</p>\n<div class=\"dialog-actions\" data-kid=\"1-3-2-2-6\" data-name=\"dialog action buttons\">\n<button class=\"btn btn-secondary\" data-cancel=\"\" data-kid=\"1-3-2-2-6-1\" data-name=\"cancel button\" type=\"button\">Cancel</button>\n<button class=\"btn btn-primary\" data-confirm=\"\" data-dynamic=\"true\" data-kid=\"1-3-2-2-6-2\" data-name=\"confirm publish button\" data-reason=\"innerHTML replaced with spinner when submitting, then textContent restored on reset\" type=\"button\">Publish</button>\n</div>\n</div>\n<div class=\"live-dialog-body\" data-dynamic=\"true\" data-kid=\"1-3-2-3\" data-live-view=\"success\" data-name=\"live success view\" data-reason=\"panel visibility driven by hidden attribute during form/success toggling\" hidden=\"\">\n<div class=\"success-mark\" data-kid=\"1-3-2-3-1\" data-name=\"success checkmark circle\"><i aria-hidden=\"true\" class=\"icon icon-check\" data-kid=\"1-3-2-3-1-1\" data-name=\"checkmark icon\"></i></div>\n<h2 class=\"dialog-title\" data-kid=\"1-3-2-3-2\" data-name=\"success dialog title\" id=\"live-dialog-success-title\">Published</h2>\n<p class=\"dialog-desc\" data-kid=\"1-3-2-3-3\" data-name=\"success dialog description\" id=\"live-dialog-success-desc\">The dialog component is live in the shared library.</p>\n<div class=\"dialog-actions\" data-kid=\"1-3-2-3-4\" data-name=\"dialog action buttons\">\n<button class=\"btn btn-primary\" data-done=\"\" data-kid=\"1-3-2-3-4-1\" data-name=\"done button\" type=\"button\">Done</button>\n</div>\n</div>\n<p aria-live=\"polite\" class=\"sr-only\" data-dynamic=\"true\" data-kid=\"1-3-2-4\" data-name=\"screen reader live dialog status\" data-reason=\"textContent populated by dialog script for status announcement\" id=\"live-status\"></p>\n</div>\n</div>\n</div>\n<script>\n(function () {\n  const root = document.querySelector('.gt');\n  if (!root) return;\n\n  const specimen = root.querySelector('.specimen');\n  const tabs = Array.from(root.querySelectorAll('.tab'));\n  const panels = Array.from(root.querySelectorAll('.tab-panel'));\n\n  function setMobileView(view) {\n    if (!specimen) return;\n    specimen.classList.toggle('show-controls', view === 'controls');\n    Array.from(root.querySelectorAll('[data-mobile-view]')).forEach(function (btn) {\n      const active = btn.dataset.mobileView === view;\n      btn.classList.toggle('active', active);\n      btn.setAttribute('aria-pressed', active ? 'true' : 'false');\n    });\n  }\n\n  function selectTab(tab, focus) {\n    if (!tab || !specimen) return;\n    tabs.forEach(function (t) {\n      const selected = t === tab;\n      t.setAttribute('aria-selected', selected ? 'true' : 'false');\n      t.tabIndex = selected ? 0 : -1;\n    });\n    panels.forEach(function (p) {\n      p.hidden = p.id !== tab.getAttribute('aria-controls');\n    });\n    specimen.dataset.tab = tab.dataset.tab;\n    if (focus) tab.focus();\n    if (tab.dataset.tab === 'preview') setMobileView('preview');\n  }\n\n  tabs.forEach(function (tab, index) {\n    tab.addEventListener('click', function () { selectTab(tab, false); });\n    tab.addEventListener('keydown', function (event) {\n      let next = null;\n      if (event.key === 'ArrowRight') next = tabs[(index + 1) % tabs.length];\n      if (event.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];\n      if (event.key === 'Home') next = tabs[0];\n      if (event.key === 'End') next = tabs[tabs.length - 1];\n      if (next) {\n        event.preventDefault();\n        selectTab(next, true);\n      }\n    });\n  });\n\n  const stateInputs = Array.from(root.querySelectorAll('input[name=\"dialog-state\"]'));\n  const previewCards = Array.from(root.querySelectorAll('[data-dialog-state]'));\n  const previewLabel = root.querySelector('#preview-state-label');\n  const stateNames = { default: 'Default', validation: 'Validation error', submitting: 'Submitting', success: 'Success' };\n\n  function setState(value) {\n    previewCards.forEach(function (card) {\n      card.hidden = card.dataset.dialogState !== value;\n    });\n    if (previewLabel) previewLabel.textContent = 'Dialog preview: ' + stateNames[value] + ' state.';\n  }\n\n  stateInputs.forEach(function (input) {\n    input.addEventListener('change', function () {\n      setState(input.value);\n      const previewTab = tabs.find(function (t) { return t.dataset.tab === 'preview'; });\n      if (specimen && specimen.dataset.tab !== 'preview') selectTab(previewTab, false);\n      if (window.matchMedia('(max-width: 980px)').matches) setMobileView('preview');\n    });\n  });\n\n  Array.from(root.querySelectorAll('[data-mobile-view]')).forEach(function (btn) {\n    btn.addEventListener('click', function () { setMobileView(btn.dataset.mobileView); });\n  });\n\n  Array.from(root.querySelectorAll('[data-open-tests]')).forEach(function (button) {\n    button.addEventListener('click', function () {\n      const testsTab = tabs.find(function (t) { return t.dataset.tab === 'tests'; });\n      selectTab(testsTab, true);\n      if (testsTab) testsTab.scrollIntoView({ block: 'nearest', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });\n    });\n  });\n\n  function fallbackCopy(text, done) {\n    const area = document.createElement('textarea');\n    area.value = text;\n    area.setAttribute('readonly', '');\n    area.style.position = 'fixed';\n    area.style.opacity = '0';\n    document.body.appendChild(area);\n    area.select();\n    try { document.execCommand('copy'); done(); } catch (error) { /* no-op */ }\n    document.body.removeChild(area);\n  }\n\n  function copyText(text, button, statusEl, labelEl, doneLabel) {\n    const originalLabel = labelEl ? (labelEl.dataset.defaultLabel || labelEl.textContent) : 'Copy';\n    if (labelEl) labelEl.dataset.defaultLabel = originalLabel;\n    function done() {\n      if (labelEl) labelEl.textContent = doneLabel;\n      if (statusEl) statusEl.textContent = 'Copied to clipboard.';\n      button.classList.add('is-copied');\n      window.setTimeout(function () {\n        if (labelEl) labelEl.textContent = originalLabel;\n        button.classList.remove('is-copied');\n      }, 1800);\n    }\n    if (navigator.clipboard && navigator.clipboard.writeText) {\n      navigator.clipboard.writeText(text).then(done).catch(function () { fallbackCopy(text, done); });\n    } else {\n      fallbackCopy(text, done);\n    }\n  }\n\n  const commandButton = root.querySelector('#copy-command');\n  if (commandButton) {\n    commandButton.addEventListener('click', function () {\n      copyText('npx scaffold-a11y dialog --variant confirm', commandButton, root.querySelector('#command-status'), commandButton.querySelector('[data-copy-label]'), 'Copied');\n    });\n  }\n\n  const emailButton = root.querySelector('#copy-email');\n  if (emailButton) {\n    emailButton.addEventListener('click', function () {\n      copyText('inez@inezpark.dev', emailButton, root.querySelector('#email-status'), emailButton.querySelector('[data-copy-label]'), 'Copied');\n    });\n  }\n\n  const trigger = root.querySelector('#try-dialog');\n  const layer = root.querySelector('#live-dialog');\n  const dialog = layer ? layer.querySelector('.live-dialog') : null;\n  const formView = layer ? layer.querySelector('[data-live-view=\"form\"]') : null;\n  const successView = layer ? layer.querySelector('[data-live-view=\"success\"]') : null;\n  const note = layer ? layer.querySelector('#release-note') : null;\n  const error = layer ? layer.querySelector('#release-note-error') : null;\n  const confirmButton = layer ? layer.querySelector('[data-confirm]') : null;\n  const cancelButton = layer ? layer.querySelector('[data-cancel]') : null;\n  const doneButton = layer ? layer.querySelector('[data-done]') : null;\n  const liveStatus = layer ? layer.querySelector('#live-status') : null;\n  let lastFocus = null;\n  let submitTimer = null;\n\n  function currentState() {\n    const checked = root.querySelector('input[name=\"dialog-state\"]:checked');\n    return checked ? checked.value : 'default';\n  }\n\n  function showForm() {\n    formView.hidden = false;\n    successView.hidden = true;\n    dialog.setAttribute('aria-labelledby', 'live-dialog-title');\n    dialog.setAttribute('aria-describedby', 'live-dialog-desc');\n  }\n\n  function showSuccess() {\n    formView.hidden = true;\n    successView.hidden = false;\n    dialog.setAttribute('aria-labelledby', 'live-dialog-success-title');\n    dialog.setAttribute('aria-describedby', 'live-dialog-success-desc');\n    liveStatus.textContent = 'Changes published.';\n    doneButton.focus();\n  }\n\n  function resetDialog() {\n    if (submitTimer) {\n      window.clearTimeout(submitTimer);\n      submitTimer = null;\n    }\n    showForm();\n    note.value = '';\n    note.removeAttribute('aria-invalid');\n    error.hidden = true;\n    confirmButton.disabled = false;\n    confirmButton.textContent = 'Publish';\n    liveStatus.textContent = '';\n  }\n\n  function submitLive(skipValidation) {\n    if (!skipValidation && !note.value.trim()) {\n      error.hidden = false;\n      note.setAttribute('aria-invalid', 'true');\n      liveStatus.textContent = 'Add a release note before publishing.';\n      note.focus();\n      return;\n    }\n    error.hidden = true;\n    note.removeAttribute('aria-invalid');\n    confirmButton.disabled = true;\n    confirmButton.innerHTML = '<span class=\"spinner\" aria-hidden=\"true\"></span>Publishing…';\n    liveStatus.textContent = 'Publishing changes.';\n    cancelButton.focus();\n    submitTimer = window.setTimeout(showSuccess, 900);\n  }\n\n  function openDialog() {\n    lastFocus = document.activeElement;\n    resetDialog();\n    layer.hidden = false;\n    document.documentElement.style.overflow = 'hidden';\n    document.body.style.overflow = 'hidden';\n    document.addEventListener('keydown', onKeydown);\n    const state = currentState();\n    if (state === 'validation') {\n      error.hidden = false;\n      note.setAttribute('aria-invalid', 'true');\n      window.setTimeout(function () { note.focus(); }, 20);\n    } else if (state === 'submitting') {\n      submitLive(true);\n    } else if (state === 'success') {\n      showSuccess();\n    } else {\n      window.setTimeout(function () { cancelButton.focus(); }, 20);\n    }\n  }\n\n  function closeDialog() {\n    if (submitTimer) {\n      window.clearTimeout(submitTimer);\n      submitTimer = null;\n    }\n    layer.hidden = true;\n    document.documentElement.style.overflow = '';\n    document.body.style.overflow = '';\n    document.removeEventListener('keydown', onKeydown);\n    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();\n  }\n\n  function onKeydown(event) {\n    if (event.key === 'Escape') {\n      event.preventDefault();\n      closeDialog();\n      return;\n    }\n    if (event.key !== 'Tab') return;\n    const items = focusables();\n    if (!items.length) return;\n    const first = items[0];\n    const last = items[items.length - 1];\n    if (event.shiftKey && document.activeElement === first) {\n      event.preventDefault();\n      last.focus();\n    } else if (!event.shiftKey && document.activeElement === last) {\n      event.preventDefault();\n      first.focus();\n    } else if (!dialog.contains(document.activeElement)) {\n      event.preventDefault();\n      first.focus();\n    }\n  }\n\n  function focusables() {\n    return Array.from(dialog.querySelectorAll('button, input, a[href]')).filter(function (el) {\n      return !el.disabled && el.getClientRects().length > 0;\n    });\n  }\n\n  if (trigger && layer) {\n    trigger.addEventListener('click', openDialog);\n    layer.querySelectorAll('[data-close-dialog]').forEach(function (el) {\n      el.addEventListener('click', closeDialog);\n    });\n    cancelButton.addEventListener('click', closeDialog);\n    doneButton.addEventListener('click', closeDialog);\n    confirmButton.addEventListener('click', function () { submitLive(false); });\n    note.addEventListener('input', function () {\n      if (note.value.trim()) {\n        error.hidden = true;\n        note.removeAttribute('aria-invalid');\n      }\n    });\n  }\n})();\n</script>\n",
      "comments": [],
      "created": "2026-11-02T20:53:44.990292+00:00",
      "modified": "2026-11-02T21:01:37.003786+00:00",
      "id": "var_9fb6d04340dc",
      "contentHeight": 3544
    },
    "var_863e63ae3b9b": {
      "type": "variant",
      "label": "Glass Terminal — Ownership Record",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fragment+Mono:ital@0;1&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\nhtml, body {\n  margin: 0;\n  padding: 0;\n  background: #0b0e10;\n  scroll-behavior: smooth;\n}\n\n.gt-page {\n  --ground: #0b0e10;\n  --ink: #edf4f6;\n  --copy: #b3bfc4;\n  --muted: #87949a;\n  --line: rgba(198, 225, 235, 0.13);\n  --line-strong: rgba(198, 225, 235, 0.22);\n  --ice: #8fd3e8;\n  --glacier: #5aa6c4;\n  --ember: #e59a6f;\n  --sans: 'Instrument Sans', system-ui, sans-serif;\n  --mono: 'Fragment Mono', 'IBM Plex Mono', monospace;\n  --ease: cubic-bezier(0.16, 1, 0.3, 1);\n\n  position: relative;\n  min-height: 100vh;\n  overflow-x: clip;\n  background: var(--ground);\n  color: var(--ink);\n  font-family: var(--sans);\n  font-size: 16px;\n  line-height: 1.5;\n  -webkit-font-smoothing: antialiased;\n}\n\n.gt-page::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  background:\n    linear-gradient(180deg, rgba(58, 120, 148, 0.14) 0%, rgba(32, 72, 90, 0.06) 26%, rgba(40, 95, 118, 0.08) 60%, rgba(11, 14, 16, 0.02) 80%, rgba(196, 124, 82, 0.06) 100%),\n    radial-gradient(1120px 720px at 16% -6%, rgba(102, 178, 208, 0.32), transparent 62%),\n    radial-gradient(900px 760px at 104% 10%, rgba(96, 160, 190, 0.19), transparent 68%),\n    radial-gradient(1000px 850px at 46% 34%, rgba(62, 128, 158, 0.15), transparent 70%),\n    radial-gradient(820px 700px at 94% 64%, rgba(196, 124, 82, 0.11), transparent 72%),\n    radial-gradient(1000px 900px at 6% 92%, rgba(80, 150, 180, 0.15), transparent 70%);\n}\n\n.gt-page *,\n.gt-page *::before,\n.gt-page *::after {\n  box-sizing: border-box;\n}\n\n.gt-page a {\n  color: inherit;\n  text-decoration: none;\n}\n\n.gt-page button {\n  font: inherit;\n}\n\n.gt-sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.gt-skip {\n  position: absolute;\n  z-index: 20;\n  top: 12px;\n  left: 12px;\n  padding: 10px 14px;\n  border-radius: 6px;\n  background: var(--ink);\n  color: var(--ground);\n  font: 600 12px var(--sans);\n  transform: translateY(-200%);\n  transition: transform 0.2s var(--ease);\n}\n\n.gt-skip:focus {\n  transform: translateY(0);\n}\n\n.gt-shell {\n  position: relative;\n  z-index: 1;\n  display: grid;\n  grid-template-columns: 272px minmax(0, 1fr);\n  gap: 32px;\n  align-items: start;\n  width: 100%;\n  max-width: 1320px;\n  margin: 0 auto;\n  padding: 32px;\n}\n\n/* ── Index rail ─────────────────────────────────────────── */\n\n.gt-rail {\n  position: sticky;\n  top: 32px;\n  padding: 20px;\n  border: 1px solid rgba(178, 222, 236, 0.19);\n  border-radius: 16px;\n  background: linear-gradient(158deg, rgba(150, 210, 232, 0.11), rgba(255, 255, 255, 0.03) 38%, rgba(8, 12, 14, 0.24));\n  box-shadow: 0 28px 70px -32px rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.07);\n  backdrop-filter: blur(22px) saturate(120%);\n}\n\n.gt-ident {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.gt-mark {\n  display: grid;\n  place-items: center;\n  width: 32px;\n  height: 32px;\n  flex: 0 0 auto;\n  border: 1px solid rgba(143, 211, 232, 0.35);\n  border-radius: 8px;\n  background: rgba(143, 211, 232, 0.07);\n  color: var(--ice);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  letter-spacing: 0.03em;\n}\n\n.gt-name {\n  display: block;\n  color: var(--ink);\n  font-size: 18px;\n  font-weight: 600;\n  letter-spacing: -0.025em;\n  line-height: 1.1;\n}\n\n.gt-role {\n  display: block;\n  margin-top: 3px;\n  color: var(--muted);\n  font-size: 11.5px;\n  line-height: 1.35;\n}\n\n.gt-rail-contact {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  margin-top: 16px;\n  padding-top: 14px;\n  border-top: 1px solid var(--line);\n}\n\n.gt-loc {\n  color: var(--muted);\n  font-size: 11.5px;\n}\n\n.gt-mail {\n  width: fit-content;\n  color: var(--copy);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  text-decoration: underline;\n  text-decoration-color: rgba(143, 211, 232, 0.35);\n  text-underline-offset: 3px;\n  transition: color 0.2s ease, text-decoration-color 0.2s ease;\n}\n\n.gt-mail:hover {\n  color: var(--ink);\n  text-decoration-color: var(--ice);\n}\n\n.gt-work {\n  margin-top: 22px;\n}\n\n.gt-label {\n  margin: 0 0 8px;\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 10px;\n  font-weight: 400;\n}\n\n.gt-rail-project {\n  position: relative;\n  display: block;\n  margin: 0 -8px;\n  padding: 9px 8px 10px;\n  border-top: 1px solid rgba(198, 225, 235, 0.1);\n  border-radius: 8px;\n  transition: background 0.22s ease, border-color 0.22s ease;\n}\n\n.gt-rail-project:hover {\n  background: rgba(255, 255, 255, 0.035);\n}\n\n.gt-rail-project[aria-current=\"location\"] {\n  border-color: transparent;\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.gt-rp-name {\n  position: relative;\n  display: inline-block;\n  color: var(--copy);\n  font-size: 13.5px;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  transition: color 0.2s ease;\n}\n\n.gt-rail-project:hover .gt-rp-name,\n.gt-rail-project[aria-current=\"location\"] .gt-rp-name {\n  color: var(--ink);\n}\n\n.gt-rail-project[aria-current=\"location\"] .gt-rp-name::after {\n  content: '';\n  position: absolute;\n  right: 0;\n  bottom: -4px;\n  left: 0;\n  height: 1px;\n  background: var(--ember);\n}\n\n.gt-rp-meta {\n  display: block;\n  margin-top: 3px;\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 10px;\n  line-height: 1.45;\n}\n\n.gt-rp-role,\n.gt-rp-years {\n  display: none;\n}\n\n.gt-rail-nav {\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  margin-top: 14px;\n  padding-top: 12px;\n  border-top: 1px solid var(--line);\n}\n\n.gt-rail-nav a {\n  display: flex;\n  align-items: center;\n  min-height: 32px;\n  padding: 4px 0;\n  color: var(--muted);\n  font-size: 12.5px;\n  transition: color 0.2s ease;\n}\n\n.gt-rail-nav a:hover {\n  color: var(--ink);\n}\n\n.gt-rail-nav a[aria-current=\"location\"] {\n  color: var(--ink);\n  text-decoration: underline;\n  text-decoration-color: var(--ember);\n  text-decoration-thickness: 1px;\n  text-underline-offset: 5px;\n}\n\n.gt-resume {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  width: 100%;\n  margin-top: 14px;\n  padding-top: 13px;\n  border-top: 1px solid var(--line);\n  color: var(--ice);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  transition: color 0.2s ease;\n}\n\n.gt-resume:hover {\n  color: var(--ink);\n}\n\n/* ── Document ───────────────────────────────────────────── */\n\n.gt-doc {\n  min-width: 0;\n  padding: 6px 0 64px;\n}\n\n.gt-doc-head {\n  padding-bottom: 30px;\n  border-bottom: 1px solid var(--line);\n}\n\n.gt-doc h1 {\n  margin: 0;\n  color: var(--ink);\n  font-size: clamp(38px, 3.7vw, 48px);\n  font-weight: 600;\n  letter-spacing: -0.045em;\n  line-height: 0.98;\n}\n\n.gt-doc-role {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 14px;\n  margin: 12px 0 0;\n  color: var(--copy);\n  font-size: 13px;\n}\n\n.gt-doc-role span {\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 10.5px;\n}\n\n.gt-profile {\n  max-width: 64ch;\n  margin: 18px 0 0;\n  color: var(--copy);\n  font-size: 15.5px;\n  line-height: 1.7;\n}\n\n.gt-index {\n  padding-top: 22px;\n  border-bottom: 1px solid var(--line);\n}\n\n.gt-index-head,\n.gt-index-row {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 166px 104px 20px;\n  gap: 14px;\n}\n\n.gt-index-head {\n  padding-bottom: 9px;\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-index-row {\n  align-items: center;\n  min-height: 64px;\n  padding: 12px 0;\n  border-top: 1px solid var(--line);\n}\n\n.gt-index-name {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  color: var(--ink);\n  font-size: 18px;\n  font-weight: 500;\n  letter-spacing: -0.025em;\n  transition: color 0.2s ease;\n}\n\n.gt-index-role {\n  color: var(--muted);\n  font-size: 11.5px;\n  font-weight: 400;\n  letter-spacing: 0;\n}\n\n.gt-index-type {\n  color: var(--copy);\n  font-family: var(--mono);\n  font-size: 10.5px;\n}\n\n.gt-index-years {\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 10.5px;\n}\n\n.gt-index-arrow {\n  justify-self: end;\n  color: var(--muted);\n  transition: color 0.2s ease, transform 0.2s var(--ease);\n}\n\n.gt-index-row:hover .gt-index-arrow {\n  color: var(--ember);\n  transform: translateY(2px);\n}\n\n/* ── Chapters ───────────────────────────────────────────── */\n\n.gt-chapter {\n  padding-top: 44px;\n  scroll-margin-top: 28px;\n}\n\n.gt-chapter + .gt-chapter {\n  margin-top: 36px;\n  padding-top: 40px;\n  border-top: 1px solid var(--line);\n}\n\n.gt-chapter-head {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 316px;\n  gap: 40px;\n  align-items: start;\n}\n\n.gt-chapter h2 {\n  margin: 0;\n  color: var(--ink);\n  font-size: 34px;\n  font-weight: 600;\n  letter-spacing: -0.04em;\n  line-height: 1;\n}\n\n.gt-purpose {\n  max-width: 46ch;\n  margin: 12px 0 0;\n  color: var(--copy);\n  font-size: 14.5px;\n  line-height: 1.65;\n}\n\n.gt-meta {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px 18px;\n  margin: 0;\n  padding-top: 12px;\n  border-top: 1px solid var(--line);\n}\n\n.gt-meta dt {\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-meta dd {\n  margin: 3px 0 0;\n  color: var(--ink);\n  font-size: 12px;\n  line-height: 1.4;\n}\n\n.gt-evidence {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 208px;\n  gap: 32px;\n  align-items: start;\n  margin-top: 28px;\n}\n\n/* ── Glass windows ──────────────────────────────────────── */\n\n.gt-window {\n  min-width: 0;\n  margin: 0;\n  overflow: hidden;\n  border: 1px solid rgba(178, 222, 236, 0.19);\n  border-radius: 14px;\n  background: linear-gradient(158deg, rgba(138, 196, 218, 0.11), rgba(255, 255, 255, 0.035) 45%, rgba(10, 14, 16, 0.26));\n  box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.07);\n  backdrop-filter: blur(22px) saturate(115%);\n}\n\n.gt-window-bar {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-height: 46px;\n  padding: 8px 15px;\n  border-bottom: 1px solid rgba(198, 225, 235, 0.12);\n  background: rgba(255, 255, 255, 0.018);\n}\n\n.gt-window-app {\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-window-title {\n  color: var(--ink);\n  font-family: var(--mono);\n  font-size: 12px;\n  letter-spacing: 0.01em;\n}\n\n.gt-env {\n  margin-left: auto;\n  padding: 3px 8px;\n  border: 1px solid rgba(143, 211, 232, 0.22);\n  border-radius: 999px;\n  background: rgba(143, 211, 232, 0.07);\n  color: var(--ice);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-window-count {\n  margin-left: auto;\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n/* Release console */\n\n.gt-release {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 206px;\n}\n\n.gt-release-main {\n  min-width: 0;\n  padding: 18px 18px 16px;\n}\n\n.gt-state {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--ink);\n  font-size: 12.5px;\n}\n\n.gt-state-dot {\n  width: 6px;\n  height: 6px;\n  flex: 0 0 auto;\n  border-radius: 50%;\n  background: var(--ember);\n  box-shadow: 0 0 0 3px rgba(229, 154, 111, 0.1);\n}\n\n.gt-rollout {\n  margin-top: 18px;\n  padding-top: 14px;\n  border-top: 1px solid var(--line);\n}\n\n.gt-rollout-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.gt-rollout-head span {\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-rollout-head strong {\n  color: var(--ink);\n  font-family: var(--mono);\n  font-size: 22px;\n  font-weight: 400;\n  letter-spacing: -0.04em;\n  font-variant-numeric: tabular-nums;\n}\n\n.gt-track {\n  height: 6px;\n  margin-top: 9px;\n  overflow: hidden;\n  border-radius: 99px;\n  background: rgba(255, 255, 255, 0.08);\n}\n\n.gt-track-fill {\n  display: block;\n  height: 100%;\n  border-radius: inherit;\n  background: linear-gradient(90deg, var(--glacier), var(--ice));\n}\n\n.gt-rollout-note {\n  margin: 7px 0 0;\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-approvals {\n  margin-top: 18px;\n  padding-top: 13px;\n  border-top: 1px solid var(--line);\n}\n\n.gt-block-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.gt-block-head span:first-child {\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-count {\n  color: var(--copy);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-approval-list {\n  margin: 8px 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.gt-approval-list li {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 6px 0;\n  border-top: 1px solid rgba(198, 225, 235, 0.08);\n  color: var(--copy);\n  font-size: 11.5px;\n}\n\n.gt-approval-list li:first-child {\n  border-top: 0;\n}\n\n.gt-approved {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  color: var(--ice);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-pending {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  color: var(--ember);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-pending::before {\n  content: '';\n  width: 5px;\n  height: 5px;\n  border: 1px solid var(--ember);\n  border-radius: 50%;\n}\n\n.gt-release-actions {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 16px;\n}\n\n.gt-btn {\n  min-height: 36px;\n  padding: 0 12px;\n  border: 1px solid rgba(198, 225, 235, 0.14);\n  border-radius: 7px;\n  background: rgba(255, 255, 255, 0.04);\n  color: var(--muted);\n  font-family: var(--sans);\n  font-size: 11px;\n  font-weight: 500;\n  cursor: not-allowed;\n}\n\n.gt-remaining {\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-release-audit {\n  min-width: 0;\n  padding: 18px 15px;\n  border-left: 1px solid rgba(198, 225, 235, 0.1);\n  background: rgba(4, 8, 10, 0.18);\n}\n\n.gt-audit {\n  margin: 10px 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.gt-audit li {\n  padding: 9px 0;\n  border-top: 1px solid rgba(198, 225, 235, 0.08);\n}\n\n.gt-audit li:first-child {\n  padding-top: 0;\n  border-top: 0;\n}\n\n.gt-audit time {\n  display: block;\n  color: var(--ice);\n  font-family: var(--mono);\n  font-size: 9.5px;\n  font-variant-numeric: tabular-nums;\n}\n\n.gt-audit span {\n  display: block;\n  margin-top: 3px;\n  color: var(--copy);\n  font-size: 11px;\n  line-height: 1.45;\n}\n\n/* Ownership */\n\n.gt-owned {\n  min-width: 0;\n}\n\n.gt-owned h3 {\n  margin: 0 0 8px;\n  color: var(--ink);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.gt-owned ul {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.gt-owned li {\n  padding: 8px 0;\n  border-top: 1px solid var(--line);\n  color: var(--copy);\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n.gt-stackline {\n  margin: 16px 0 0;\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n  line-height: 1.65;\n}\n\n.gt-stackline span {\n  display: block;\n  margin-bottom: 4px;\n}\n\n.gt-notes {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 36px;\n  margin-top: 30px;\n  padding-top: 18px;\n  border-top: 1px solid var(--line);\n}\n\n.gt-notes h3 {\n  margin: 0;\n  color: var(--ink);\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.gt-notes p {\n  margin: 6px 0 0;\n  color: var(--copy);\n  font-size: 13px;\n  line-height: 1.65;\n}\n\n/* Facet matrix */\n\n.gt-matrix {\n  width: 100%;\n  border-collapse: collapse;\n}\n\n.gt-matrix thead th {\n  padding: 9px 14px;\n  border-bottom: 1px solid rgba(198, 225, 235, 0.1);\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9px;\n  font-weight: 400;\n  text-align: left;\n}\n\n.gt-matrix tbody th {\n  width: 76px;\n  padding: 12px 14px;\n  border-bottom: 1px solid rgba(198, 225, 235, 0.08);\n  color: var(--ink);\n  font-size: 11.5px;\n  font-weight: 500;\n  text-align: left;\n  vertical-align: top;\n}\n\n.gt-matrix td {\n  padding: 12px 14px;\n  border-bottom: 1px solid rgba(198, 225, 235, 0.08);\n  color: var(--copy);\n  font-size: 11px;\n  line-height: 1.5;\n  vertical-align: top;\n}\n\n.gt-matrix tbody tr:last-child th,\n.gt-matrix tbody tr:last-child td {\n  border-bottom: 0;\n}\n\n.gt-matrix-preview {\n  width: 43%;\n}\n\n.gt-matrix-focus {\n  width: 68px;\n  color: var(--ice) !important;\n  font-family: var(--mono);\n  font-size: 9.5px !important;\n}\n\n.gt-matrix-notes {\n  color: var(--muted) !important;\n  font-size: 10.5px !important;\n}\n\n.gt-dialog {\n  max-width: 252px;\n  padding: 9px 10px;\n  border: 1px solid rgba(178, 222, 236, 0.16);\n  border-radius: 7px;\n  background: rgba(5, 9, 11, 0.34);\n}\n\n.gt-dialog-title {\n  margin: 0;\n  color: var(--ink);\n  font-size: 11.5px;\n  font-weight: 600;\n  line-height: 1.3;\n}\n\n.gt-dialog-msg {\n  margin: 3px 0 0;\n  color: var(--muted);\n  font-size: 10px;\n  line-height: 1.45;\n}\n\n.gt-dialog-msg--error {\n  color: var(--ember);\n}\n\n.gt-dialog-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 5px;\n  margin-top: 8px;\n}\n\n.gt-dialog-btn {\n  padding: 2px 7px;\n  border: 1px solid rgba(198, 225, 235, 0.14);\n  border-radius: 4px;\n  color: var(--copy);\n  font-size: 9.5px;\n}\n\n.gt-dialog-btn--primary {\n  border-color: rgba(143, 211, 232, 0.24);\n  background: rgba(143, 211, 232, 0.14);\n  color: var(--ink);\n}\n\n.gt-dialog-btn--disabled {\n  border-style: dashed;\n  color: var(--muted);\n}\n\n.gt-api {\n  padding: 13px 15px 14px;\n  border-top: 1px solid rgba(198, 225, 235, 0.1);\n  background: rgba(4, 8, 10, 0.16);\n}\n\n.gt-api-head {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9px;\n}\n\n.gt-api pre {\n  margin: 8px 0 0;\n  overflow-x: auto;\n  color: var(--copy);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  line-height: 1.7;\n}\n\n.gt-api code {\n  font-family: inherit;\n}\n\n.gt-tokens {\n  margin: 9px 0 0;\n  padding-top: 8px;\n  border-top: 1px solid rgba(198, 225, 235, 0.08);\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9px;\n  line-height: 1.6;\n}\n\n/* CLI */\n\n.gt-term-body {\n  padding: 16px 16px 14px;\n  background: rgba(4, 8, 10, 0.3);\n  font-family: var(--mono);\n  font-size: 11px;\n  line-height: 1.8;\n}\n\n.gt-cmd {\n  margin: 0;\n  overflow-x: auto;\n  color: var(--ink);\n  white-space: nowrap;\n}\n\n.gt-prompt {\n  margin-right: 7px;\n  color: var(--ice);\n}\n\n.gt-tree {\n  margin: 12px 0 0;\n  color: var(--copy);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  line-height: 1.75;\n  white-space: pre;\n}\n\n.gt-checks {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px 16px;\n  margin-top: 14px;\n  padding-top: 11px;\n  border-top: 1px solid rgba(198, 225, 235, 0.08);\n}\n\n.gt-check {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  color: var(--copy);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-check i {\n  color: var(--ice);\n  font-size: 11px;\n}\n\n.gt-term-foot {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 11px 15px;\n  border-top: 1px solid rgba(198, 225, 235, 0.1);\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-term-foot a {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  color: var(--copy);\n  transition: color 0.2s ease;\n}\n\n.gt-term-foot a:hover {\n  color: var(--ink);\n}\n\n.gt-copy {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-height: 36px;\n  margin-left: auto;\n  padding: 0 10px;\n  border: 1px solid rgba(198, 225, 235, 0.16);\n  border-radius: 6px;\n  background: rgba(255, 255, 255, 0.03);\n  color: var(--copy);\n  font-family: var(--mono);\n  font-size: 9.5px;\n  cursor: pointer;\n  transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;\n}\n\n.gt-copy:hover {\n  border-color: rgba(143, 211, 232, 0.35);\n  background: rgba(143, 211, 232, 0.07);\n  color: var(--ink);\n}\n\n.gt-copy .gt-ico {\n  color: var(--ice);\n}\n\n/* Stack */\n\n.gt-section {\n  padding-top: 44px;\n  scroll-margin-top: 28px;\n}\n\n.gt-section + .gt-section {\n  margin-top: 32px;\n  padding-top: 40px;\n  border-top: 1px solid var(--line);\n}\n\n.gt-section h2 {\n  margin: 0;\n  color: var(--ink);\n  font-size: 30px;\n  font-weight: 600;\n  letter-spacing: -0.04em;\n  line-height: 1;\n}\n\n.gt-stack {\n  width: 100%;\n  margin-top: 20px;\n  border-collapse: collapse;\n}\n\n.gt-stack thead th {\n  padding: 0 14px 9px;\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n  font-weight: 400;\n  text-align: left;\n}\n\n.gt-stack tbody th {\n  width: 112px;\n  padding: 14px;\n  border-top: 1px solid var(--line);\n  color: var(--ink);\n  font-size: 12px;\n  font-weight: 500;\n  text-align: left;\n  vertical-align: top;\n}\n\n.gt-stack tbody td {\n  padding: 14px;\n  border-top: 1px solid var(--line);\n  color: var(--copy);\n  font-size: 12px;\n  line-height: 1.55;\n  vertical-align: top;\n}\n\n.gt-stack-mobile {\n  display: none;\n  margin-top: 20px;\n}\n\n.gt-stack-group {\n  padding: 14px 0;\n  border-top: 1px solid var(--line);\n}\n\n.gt-stack-group:last-child {\n  border-bottom: 1px solid var(--line);\n}\n\n.gt-stack-group h3 {\n  margin: 0;\n  color: var(--ink);\n  font-size: 15px;\n  font-weight: 500;\n}\n\n.gt-stack-group dl {\n  display: grid;\n  grid-template-columns: 86px minmax(0, 1fr);\n  gap: 6px 14px;\n  margin: 8px 0 0;\n}\n\n.gt-stack-group dt {\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-stack-group dd {\n  margin: 0;\n  color: var(--copy);\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n/* Experience */\n\n.gt-exp {\n  margin-top: 18px;\n}\n\n.gt-exp-row {\n  display: grid;\n  grid-template-columns: 112px minmax(0, 1fr) 110px;\n  gap: 24px;\n  padding: 20px 0;\n  border-top: 1px solid var(--line);\n}\n\n.gt-exp-row:last-child {\n  border-bottom: 1px solid var(--line);\n}\n\n.gt-exp-dates {\n  margin: 2px 0 0;\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-exp h3 {\n  margin: 0;\n  color: var(--ink);\n  font-size: 17px;\n  font-weight: 500;\n  letter-spacing: -0.02em;\n}\n\n.gt-exp-co {\n  margin: 4px 0 0;\n  color: var(--copy);\n  font-size: 12px;\n}\n\n.gt-exp-desc {\n  max-width: 54ch;\n  margin: 7px 0 0;\n  color: var(--muted);\n  font-size: 12.5px;\n  line-height: 1.65;\n}\n\n.gt-exp-link {\n  justify-self: end;\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  margin-top: 2px;\n  color: var(--ice);\n  font-family: var(--mono);\n  font-size: 9.5px;\n  transition: color 0.2s ease;\n}\n\n.gt-exp-link:hover {\n  color: var(--ink);\n}\n\n/* Contact */\n\n.gt-contact {\n  margin-top: 40px;\n  padding-top: 40px;\n  border-top: 1px solid var(--line);\n  scroll-margin-top: 28px;\n}\n\n.gt-contact h2 {\n  margin: 0;\n  color: var(--ink);\n  font-size: 30px;\n  font-weight: 600;\n  letter-spacing: -0.04em;\n  line-height: 1;\n}\n\n.gt-contact-lead {\n  margin: 8px 0 0;\n  color: var(--muted);\n  font-size: 13px;\n}\n\n.gt-contact-email-row {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 16px 24px;\n  margin-top: 20px;\n}\n\n.gt-contact-email {\n  display: inline-block;\n  padding-bottom: 5px;\n  border-bottom: 1px solid var(--ember);\n  color: var(--ink);\n  font-size: clamp(25px, 2.9vw, 32px);\n  font-weight: 500;\n  letter-spacing: -0.035em;\n  line-height: 1.1;\n  transition: color 0.2s ease, border-color 0.2s ease;\n}\n\n.gt-contact-email:hover {\n  border-color: var(--ink);\n  color: var(--ember);\n}\n\n.gt-copyBtn {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  min-height: 44px;\n  padding: 0 14px;\n  border: 1px solid rgba(198, 225, 235, 0.18);\n  border-radius: 8px;\n  background: rgba(255, 255, 255, 0.03);\n  color: var(--copy);\n  font-family: var(--mono);\n  font-size: 10px;\n  cursor: pointer;\n  transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;\n}\n\n.gt-copyBtn:hover {\n  border-color: rgba(143, 211, 232, 0.35);\n  background: rgba(143, 211, 232, 0.07);\n  color: var(--ink);\n}\n\n.gt-copyBtn .gt-ico {\n  color: var(--ice);\n}\n\n.gt-contact-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px 20px;\n  margin-top: 18px;\n}\n\n.gt-contact-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  color: var(--copy);\n  font-family: var(--mono);\n  font-size: 10px;\n  transition: color 0.2s ease;\n}\n\n.gt-contact-link:hover {\n  color: var(--ink);\n}\n\n.gt-foot {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  margin-top: 44px;\n  padding-top: 16px;\n  border-top: 1px solid var(--line);\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 9.5px;\n}\n\n.gt-foot a {\n  color: var(--copy);\n  transition: color 0.2s ease;\n}\n\n.gt-foot a:hover {\n  color: var(--ink);\n}\n\n.gt-ico {\n  display: inline-block;\n  font-size: 13px;\n  font-style: normal;\n  line-height: 1;\n}\n\n.gt-page a:focus-visible,\n.gt-page button:focus-visible {\n  outline: 2px solid var(--ice);\n  outline-offset: 3px;\n  border-radius: 4px;\n}\n\n/* Compact metadata scale, kept legible at desktop sizes */\n.gt-mail,\n.gt-label,\n.gt-rp-meta,\n.gt-index-type,\n.gt-index-years,\n.gt-meta dt,\n.gt-window-app,\n.gt-env,\n.gt-window-count,\n.gt-rollout-head span,\n.gt-rollout-note,\n.gt-block-head span:first-child,\n.gt-count,\n.gt-approved,\n.gt-pending,\n.gt-remaining,\n.gt-audit time,\n.gt-audit span,\n.gt-stackline,\n.gt-matrix thead th,\n.gt-api-head,\n.gt-tokens,\n.gt-check,\n.gt-term-foot,\n.gt-copy,\n.gt-stack thead th,\n.gt-exp-dates,\n.gt-exp-link,\n.gt-contact-link,\n.gt-foot {\n  font-size: 10.5px;\n}\n\n.gt-index-head,\n.gt-meta dt,\n.gt-matrix thead th,\n.gt-api-head,\n.gt-tokens {\n  font-size: 10px;\n}\n\n.gt-index-type,\n.gt-index-years,\n.gt-matrix td {\n  font-size: 11.5px;\n}\n\n.gt-state,\n.gt-approval-list li {\n  font-size: 12.5px;\n}\n\n.gt-matrix-focus {\n  font-size: 10.5px !important;\n}\n\n.gt-matrix-notes {\n  font-size: 11px !important;\n}\n\n.gt-dialog-title { font-size: 12px; }\n.gt-dialog-msg { font-size: 10.5px; }\n.gt-dialog-btn { font-size: 10px; }\n.gt-api pre { font-size: 11px; }\n.gt-term-body { font-size: 11.5px; }\n.gt-tree { font-size: 11px; }\n.gt-stack tbody th,\n.gt-stack tbody td { font-size: 12.5px; }\n.gt-exp-desc { font-size: 13px; }\n\n/* ── Responsive ─────────────────────────────────────────── */\n\n@media (max-width: 1180px) {\n  .gt-shell {\n    grid-template-columns: 240px minmax(0, 1fr);\n    gap: 24px;\n    padding: 24px;\n  }\n\n  .gt-chapter-head {\n    grid-template-columns: minmax(0, 1fr) 280px;\n    gap: 28px;\n  }\n\n  .gt-evidence {\n    grid-template-columns: 1fr;\n    gap: 22px;\n  }\n\n  .gt-owned {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 220px;\n    column-gap: 28px;\n    align-items: start;\n  }\n\n  .gt-owned h3 {\n    grid-column: 1 / -1;\n  }\n\n  .gt-owned ul {\n    grid-column: 1;\n  }\n\n  .gt-stackline {\n    grid-column: 2;\n    margin-top: 0;\n  }\n}\n\n@media (max-width: 900px) {\n  .gt-shell {\n    grid-template-columns: 1fr;\n    gap: 0;\n    padding: 20px 20px 0;\n  }\n\n  .gt-rail {\n    position: static;\n    top: auto;\n    padding: 0 0 20px;\n    border: 0;\n    border-bottom: 1px solid var(--line);\n    border-radius: 0;\n    background: none;\n    box-shadow: none;\n    backdrop-filter: none;\n  }\n\n  .gt-rail-contact {\n    flex-direction: row;\n    align-items: center;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    gap: 8px 16px;\n    margin-top: 12px;\n    padding-top: 12px;\n  }\n\n  .gt-work {\n    margin-top: 18px;\n  }\n\n  .gt-rail-project {\n    margin: 0;\n    padding: 10px 0 11px;\n    border-radius: 0;\n  }\n\n  .gt-rail-project[aria-current=\"location\"] {\n    background: transparent;\n  }\n\n  .gt-rail-project[aria-current=\"location\"] .gt-rp-name::after {\n    right: auto;\n    width: 20px;\n  }\n\n  .gt-rp-name {\n    font-size: 14px;\n  }\n\n  .gt-rp-meta {\n    font-size: 10.5px;\n  }\n\n  .gt-rp-role {\n    display: inline;\n  }\n\n  .gt-rp-years {\n    display: none;\n  }\n\n  .gt-rail-nav {\n    flex-direction: row;\n    flex-wrap: wrap;\n    gap: 6px 22px;\n    padding-top: 14px;\n  }\n\n  .gt-rail-nav a {\n    min-height: 36px;\n  }\n\n  .gt-resume {\n    display: none;\n  }\n\n  .gt-doc {\n    padding: 26px 0 48px;\n  }\n\n  .gt-doc-name {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n\n  .gt-doc-role {\n    display: none;\n  }\n\n  .gt-doc-head {\n    padding-bottom: 22px;\n  }\n\n  .gt-profile {\n    margin-top: 0;\n    max-width: 60ch;\n  }\n\n  .gt-index {\n    display: none;\n  }\n\n  .gt-chapter {\n    padding-top: 38px;\n  }\n\n  .gt-chapter + .gt-chapter {\n    margin-top: 42px;\n    padding-top: 38px;\n  }\n\n  .gt-chapter-head {\n    grid-template-columns: 1fr;\n    gap: 18px;\n  }\n\n  .gt-chapter h2 {\n    font-size: 30px;\n  }\n\n  .gt-meta {\n    max-width: 420px;\n  }\n\n  .gt-evidence {\n    grid-template-columns: 1fr;\n  }\n\n  .gt-notes {\n    grid-template-columns: 1fr;\n    gap: 18px;\n  }\n\n  .gt-stack {\n    display: none;\n  }\n\n  .gt-stack-mobile {\n    display: block;\n  }\n\n  .gt-exp-row {\n    grid-template-columns: 100px minmax(0, 1fr);\n    gap: 16px;\n  }\n\n  .gt-exp-link {\n    grid-column: 2;\n    justify-self: start;\n  }\n\n  .gt-section {\n    padding-top: 44px;\n  }\n}\n\n@media (max-width: 600px) {\n  .gt-shell {\n    padding: 16px 16px 0;\n  }\n\n  .gt-rail-contact {\n    margin-top: 10px;\n    padding-top: 10px;\n  }\n\n  .gt-rail-nav {\n    gap: 4px 18px;\n  }\n\n  .gt-doc {\n    padding-top: 22px;\n  }\n\n  .gt-profile {\n    font-size: 15px;\n  }\n\n  .gt-chapter {\n    padding-top: 34px;\n  }\n\n  .gt-chapter + .gt-chapter {\n    margin-top: 36px;\n    padding-top: 34px;\n  }\n\n  .gt-chapter h2 {\n    font-size: 28px;\n  }\n\n  .gt-meta {\n    gap: 10px 14px;\n  }\n\n  .gt-window-bar {\n    flex-wrap: wrap;\n    gap: 6px 8px;\n    padding: 10px 12px;\n  }\n\n  .gt-env,\n  .gt-window-count {\n    margin-left: 0;\n  }\n\n  .gt-release {\n    grid-template-columns: 1fr;\n  }\n\n  .gt-release-main {\n    padding: 15px 14px;\n  }\n\n  .gt-release-audit {\n    padding: 15px 14px;\n    border-top: 1px solid rgba(198, 225, 235, 0.1);\n    border-left: 0;\n  }\n\n  .gt-matrix thead {\n    display: none;\n  }\n\n  .gt-matrix,\n  .gt-matrix tbody,\n  .gt-matrix tr,\n  .gt-matrix th,\n  .gt-matrix td {\n    display: block;\n    width: 100%;\n  }\n\n  .gt-matrix tbody tr {\n    padding: 11px 14px;\n    border-top: 1px solid rgba(198, 225, 235, 0.08);\n  }\n\n  .gt-matrix tbody th {\n    padding: 0 0 7px;\n    border: 0;\n    font-size: 12.5px;\n  }\n\n  .gt-matrix td {\n    padding: 0 0 6px;\n    border: 0;\n  }\n\n  .gt-matrix td::before {\n    content: attr(data-label);\n    display: block;\n    margin-bottom: 2px;\n    color: var(--muted);\n    font-family: var(--mono);\n    font-size: 8.5px;\n  }\n\n  .gt-dialog {\n    max-width: none;\n  }\n\n  .gt-api pre {\n    font-size: 10px;\n  }\n\n  .gt-owned {\n    display: block;\n  }\n\n  .gt-stackline {\n    grid-column: auto;\n    margin-top: 14px;\n  }\n\n  .gt-term-body {\n    padding: 14px 12px;\n    font-size: 10.5px;\n  }\n\n  .gt-tree {\n    font-size: 9.5px;\n  }\n\n  .gt-cmd {\n    white-space: normal;\n    overflow-wrap: anywhere;\n  }\n\n  .gt-checks {\n    gap: 8px 12px;\n  }\n\n  .gt-exp h3 {\n    font-size: 16px;\n  }\n\n  .gt-contact-email {\n    font-size: 24px;\n  }\n\n  .gt-foot {\n    flex-direction: column;\n    gap: 6px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  html {\n    scroll-behavior: auto;\n  }\n\n  .gt-page *,\n  .gt-page *::before,\n  .gt-page *::after {\n    animation-duration: 0.01ms !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n</style>\n<div class=\"gt-page\" data-kid=\"1\" data-name=\"page layout container with gradient background\" id=\"top\">\n<a class=\"gt-skip\" data-kid=\"1-1\" data-name=\"skip to content link\" href=\"#gt-document\">Skip to content</a>\n<div class=\"gt-shell\" data-kid=\"1-2\" data-name=\"page grid with sidebar and document\">\n<aside aria-label=\"Portfolio index\" class=\"gt-rail\" data-kid=\"1-2-1\" data-name=\"portfolio index sidebar\">\n<header class=\"gt-rail-head\" data-kid=\"1-2-1-1\" data-name=\"sidebar identity header\">\n<a class=\"gt-ident\" data-kid=\"1-2-1-1-1\" data-name=\"identity link to top of page\" href=\"#top\">\n<span aria-hidden=\"true\" class=\"gt-mark\" data-kid=\"1-2-1-1-1-1\" data-name=\"monogram badge\">IP</span>\n<span data-kid=\"1-2-1-1-1-2\" data-name=\"identity text wrapper\">\n<span class=\"gt-name\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"display name\">Inez Park</span>\n<span class=\"gt-role\" data-kid=\"1-2-1-1-1-2-2\" data-name=\"role subtitle\">Full Stack &amp; Frontend Engineer</span>\n</span>\n</a>\n<div class=\"gt-rail-contact\" data-kid=\"1-2-1-1-2\" data-name=\"contact info block\">\n<span class=\"gt-loc\" data-kid=\"1-2-1-1-2-1\" data-name=\"location text\">Brooklyn, NY</span>\n<a class=\"gt-mail\" data-kid=\"1-2-1-1-2-2\" data-name=\"email address link\" href=\"mailto:inez@inezpark.dev\">inez@inezpark.dev</a>\n</div>\n</header>\n<nav aria-label=\"Project chapters\" class=\"gt-work\" data-kid=\"1-2-1-2\" data-name=\"project section navigation\">\n<p class=\"gt-label\" data-kid=\"1-2-1-2-1\" data-name=\"section label\">Work</p>\n<a aria-current=\"location\" class=\"gt-rail-project\" data-kid=\"1-2-1-2-2\" data-name=\"Switchyard project link\" data-project-link=\"switchyard\" href=\"#switchyard\">\n<span class=\"gt-rp-name\" data-kid=\"1-2-1-2-2-1\" data-name=\"project name\">Switchyard</span>\n<span class=\"gt-rp-meta\" data-kid=\"1-2-1-2-2-2\" data-name=\"project meta text wrapper\"><span class=\"gt-rp-type\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"project type label\">Release infrastructure</span><span class=\"gt-rp-role\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"project role label\">, Frontend lead</span><span class=\"gt-rp-years\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"project years label\">, 2023–Present</span></span>\n</a>\n<a class=\"gt-rail-project\" data-kid=\"1-2-1-2-3\" data-name=\"Facet project link\" data-project-link=\"facet\" href=\"#facet\">\n<span class=\"gt-rp-name\" data-kid=\"1-2-1-2-3-1\" data-name=\"project name\">Facet</span>\n<span class=\"gt-rp-meta\" data-kid=\"1-2-1-2-3-2\" data-name=\"project meta text wrapper\"><span class=\"gt-rp-type\" data-kid=\"1-2-1-2-3-2-1\" data-name=\"project type label\">Design systems</span><span class=\"gt-rp-role\" data-kid=\"1-2-1-2-3-2-2\" data-name=\"project role label\">, Design systems engineer</span><span class=\"gt-rp-years\" data-kid=\"1-2-1-2-3-2-3\" data-name=\"project years label\">, 2022–Present</span></span>\n</a>\n<a class=\"gt-rail-project\" data-kid=\"1-2-1-2-4\" data-name=\"scaffold-a11y project link\" data-project-link=\"scaffold-a11y\" href=\"#scaffold-a11y\">\n<span class=\"gt-rp-name\" data-kid=\"1-2-1-2-4-1\" data-name=\"project name\">scaffold-a11y</span>\n<span class=\"gt-rp-meta\" data-kid=\"1-2-1-2-4-2\" data-name=\"project meta text wrapper\"><span class=\"gt-rp-type\" data-kid=\"1-2-1-2-4-2-1\" data-name=\"project type label\">Open source CLI</span><span class=\"gt-rp-role\" data-kid=\"1-2-1-2-4-2-2\" data-name=\"project role label\">, Maintainer</span><span class=\"gt-rp-years\" data-kid=\"1-2-1-2-4-2-3\" data-name=\"project years label\">, 2024–Present</span></span>\n</a>\n</nav>\n<nav aria-label=\"Portfolio sections\" class=\"gt-rail-nav\" data-kid=\"1-2-1-3\" data-name=\"portfolio sections navigation\">\n<a data-dynamic=\"true\" data-kid=\"1-2-1-3-1\" data-name=\"navigation link to stack section\" data-reason=\"aria-current attribute set and removed by scroll-spy script\" data-section-link=\"stack\" href=\"#stack\">Stack</a>\n<a data-dynamic=\"true\" data-kid=\"1-2-1-3-2\" data-name=\"navigation link to experience section\" data-reason=\"aria-current attribute set and removed by scroll-spy script\" data-section-link=\"experience\" href=\"#experience\">Experience</a>\n<a data-dynamic=\"true\" data-kid=\"1-2-1-3-3\" data-name=\"navigation link to contact section\" data-reason=\"aria-current attribute set and removed by scroll-spy script\" data-section-link=\"contact\" href=\"#contact\">Contact</a>\n</nav>\n<a class=\"gt-resume\" data-kid=\"1-2-1-4\" data-name=\"request resume link with arrow icon\" href=\"mailto:inez@inezpark.dev?subject=R%C3%A9sum%C3%A9%20request\">\n        Request résumé\n        <i aria-hidden=\"true\" class=\"icon-arrow-up-right gt-ico\" data-kid=\"1-2-1-4-1\" data-name=\"arrow up right icon\"></i>\n</a>\n</aside>\n<main class=\"gt-doc\" data-kid=\"1-2-2\" data-name=\"main document area\" id=\"gt-document\" tabindex=\"-1\">\n<header class=\"gt-doc-head\" data-kid=\"1-2-2-1\" data-name=\"document header\">\n<h1 class=\"gt-doc-name\" data-kid=\"1-2-2-1-1\" data-name=\"document name heading\">Inez Park</h1>\n<p class=\"gt-doc-role\" data-kid=\"1-2-2-1-2\" data-name=\"role and location line\">Full Stack &amp; Frontend Engineer <span data-kid=\"1-2-2-1-2-1\" data-name=\"location label in role line\">Brooklyn, NY</span></p>\n<p class=\"gt-profile\" data-kid=\"1-2-2-1-3\" data-name=\"profile summary text\">I build product interfaces and the services behind them. Six years across release tooling, design systems, and billing software.</p>\n</header>\n<section aria-labelledby=\"gt-index-heading\" class=\"gt-index\" data-kid=\"1-2-2-2\" data-name=\"selected work index section\">\n<h2 class=\"gt-sr-only\" data-kid=\"1-2-2-2-1\" data-name=\"screen reader only heading\" id=\"gt-index-heading\">Selected work</h2>\n<div aria-hidden=\"true\" class=\"gt-index-head\" data-kid=\"1-2-2-2-2\" data-name=\"index column headers\">\n<span data-kid=\"1-2-2-2-2-1\" data-name=\"column header for project\">Project</span>\n<span data-kid=\"1-2-2-2-2-2\" data-name=\"column header for type\">Type</span>\n<span data-kid=\"1-2-2-2-2-3\" data-name=\"column header for years\">Years</span>\n<span data-kid=\"1-2-2-2-2-4\" data-name=\"empty column header for arrow\"></span>\n</div>\n<a class=\"gt-index-row\" data-kid=\"1-2-2-2-3\" data-name=\"Switchyard index row link\" href=\"#switchyard\">\n<span class=\"gt-index-name\" data-kid=\"1-2-2-2-3-1\" data-name=\"project name and role\">Switchyard<span class=\"gt-index-role\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"project role subtitle\">Frontend lead, product engineer</span></span>\n<span class=\"gt-index-type\" data-kid=\"1-2-2-2-3-2\" data-name=\"project type value\">Release infrastructure</span>\n<span class=\"gt-index-years\" data-kid=\"1-2-2-2-3-3\" data-name=\"project years value\">2023–Present</span>\n<i aria-hidden=\"true\" class=\"icon-arrow-down gt-index-arrow gt-ico\" data-kid=\"1-2-2-2-3-4\" data-name=\"arrow down icon\"></i>\n</a>\n<a class=\"gt-index-row\" data-dynamic=\"true\" data-kid=\"1-2-2-2-4\" data-name=\"Facet index row link\" data-reason=\"aria-current set by scroll-spy when section in view\" href=\"#facet\">\n<span class=\"gt-index-name\" data-kid=\"1-2-2-2-4-1\" data-name=\"project name and role\">Facet<span class=\"gt-index-role\" data-kid=\"1-2-2-2-4-1-1\" data-name=\"project role subtitle\">Design systems engineer</span></span>\n<span class=\"gt-index-type\" data-kid=\"1-2-2-2-4-2\" data-name=\"project type value\">Design systems</span>\n<span class=\"gt-index-years\" data-kid=\"1-2-2-2-4-3\" data-name=\"project years value\">2022–Present</span>\n<i aria-hidden=\"true\" class=\"icon-arrow-down gt-index-arrow gt-ico\" data-kid=\"1-2-2-2-4-4\" data-name=\"arrow down icon\"></i>\n</a>\n<a class=\"gt-index-row\" data-dynamic=\"true\" data-kid=\"1-2-2-2-5\" data-name=\"scaffold-a11y index row link\" data-reason=\"aria-current set by scroll-spy when section in view\" href=\"#scaffold-a11y\">\n<span class=\"gt-index-name\" data-kid=\"1-2-2-2-5-1\" data-name=\"project name and role\">scaffold-a11y<span class=\"gt-index-role\" data-kid=\"1-2-2-2-5-1-1\" data-name=\"project role subtitle\">Maintainer</span></span>\n<span class=\"gt-index-type\" data-kid=\"1-2-2-2-5-2\" data-name=\"project type value\">Open source CLI</span>\n<span class=\"gt-index-years\" data-kid=\"1-2-2-2-5-3\" data-name=\"project years value\">2024–Present</span>\n<i aria-hidden=\"true\" class=\"icon-arrow-down gt-index-arrow gt-ico\" data-kid=\"1-2-2-2-5-4\" data-name=\"arrow down icon\"></i>\n</a>\n</section>\n<section aria-labelledby=\"switchyard-title\" class=\"gt-chapter\" data-kid=\"1-2-2-3\" data-name=\"Switchyard project chapter\" id=\"switchyard\">\n<div class=\"gt-chapter-head\" data-kid=\"1-2-2-3-1\" data-name=\"chapter header with meta grid\">\n<div data-kid=\"1-2-2-3-1-1\" data-name=\"chapter title and purpose container\">\n<h2 data-kid=\"1-2-2-3-1-1-1\" data-name=\"chapter heading\" id=\"switchyard-title\">Switchyard</h2>\n<p class=\"gt-purpose\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"chapter purpose description\">Release control for SaaS teams. Approvals, staged rollout, and the release state behind both.</p>\n</div>\n<dl class=\"gt-meta\" data-kid=\"1-2-2-3-1-2\" data-name=\"project metadata definition list\">\n<div data-kid=\"1-2-2-3-1-2-1\" data-name=\"metadata pair for type\"><dt data-kid=\"1-2-2-3-1-2-1-1\" data-name=\"metadata term type\">Type</dt><dd data-kid=\"1-2-2-3-1-2-1-2\" data-name=\"metadata value type\">Release infrastructure</dd></div>\n<div data-kid=\"1-2-2-3-1-2-2\" data-name=\"metadata pair for company\"><dt data-kid=\"1-2-2-3-1-2-2-1\" data-name=\"metadata term company\">Company</dt><dd data-kid=\"1-2-2-3-1-2-2-2\" data-name=\"metadata value company\">Tessellate</dd></div>\n<div data-kid=\"1-2-2-3-1-2-3\" data-name=\"metadata pair for role\"><dt data-kid=\"1-2-2-3-1-2-3-1\" data-name=\"metadata term role\">Role</dt><dd data-kid=\"1-2-2-3-1-2-3-2\" data-name=\"metadata value role\">Frontend lead, product engineer</dd></div>\n<div data-kid=\"1-2-2-3-1-2-4\" data-name=\"metadata pair for years\"><dt data-kid=\"1-2-2-3-1-2-4-1\" data-name=\"metadata term years\">Years</dt><dd data-kid=\"1-2-2-3-1-2-4-2\" data-name=\"metadata value years\">2023–Present</dd></div>\n</dl>\n</div>\n<div class=\"gt-evidence\" data-kid=\"1-2-2-3-2\" data-name=\"evidence area with window and ownership\">\n<figure aria-labelledby=\"release-title\" class=\"gt-window gt-window--release\" data-kid=\"1-2-2-3-2-1\" data-name=\"release console window mockup\">\n<div class=\"gt-window-bar\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"window title bar\">\n<span class=\"gt-window-app\" data-kid=\"1-2-2-3-2-1-1-1\" data-name=\"window app name\">Switchyard</span>\n<span class=\"gt-window-title\" data-kid=\"1-2-2-3-2-1-1-2\" data-name=\"window document title\" id=\"release-title\">checkout-api</span>\n<span class=\"gt-env\" data-kid=\"1-2-2-3-2-1-1-3\" data-name=\"environment badge\">Production</span>\n</div>\n<div class=\"gt-release\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"release console body grid\">\n<div class=\"gt-release-main\" data-kid=\"1-2-2-3-2-1-2-1\" data-name=\"release main panel\">\n<div class=\"gt-state\" data-kid=\"1-2-2-3-2-1-2-1-1\" data-name=\"release state indicator\"><span aria-hidden=\"true\" class=\"gt-state-dot\" data-kid=\"1-2-2-3-2-1-2-1-1-1\" data-name=\"state indicator dot\"></span>Awaiting approval</div>\n<div class=\"gt-rollout\" data-kid=\"1-2-2-3-2-1-2-1-2\" data-name=\"rollout progress block\">\n<div class=\"gt-rollout-head\" data-kid=\"1-2-2-3-2-1-2-1-2-1\" data-name=\"rollout header with label and percentage\">\n<span data-kid=\"1-2-2-3-2-1-2-1-2-1-1\" data-name=\"rollout label\">Rollout</span>\n<strong data-kid=\"1-2-2-3-2-1-2-1-2-1-2\" data-name=\"rollout percentage value\">25%</strong>\n</div>\n<div aria-label=\"Rollout at 25 percent\" class=\"gt-track\" data-kid=\"1-2-2-3-2-1-2-1-2-2\" data-name=\"rollout progress track\" role=\"img\">\n<span class=\"gt-track-fill\" data-kid=\"1-2-2-3-2-1-2-1-2-2-1\" data-name=\"rollout progress fill bar\" style=\"width: 25%\"></span>\n</div>\n<p class=\"gt-rollout-note\" data-kid=\"1-2-2-3-2-1-2-1-2-3\" data-name=\"rollout note text\">25% of production traffic</p>\n</div>\n<div class=\"gt-approvals\" data-kid=\"1-2-2-3-2-1-2-1-3\" data-name=\"approvals block\">\n<div class=\"gt-block-head\" data-kid=\"1-2-2-3-2-1-2-1-3-1\" data-name=\"approvals header\">\n<span data-kid=\"1-2-2-3-2-1-2-1-3-1-1\" data-name=\"approvals label\">Approvals</span>\n<span class=\"gt-count\" data-kid=\"1-2-2-3-2-1-2-1-3-1-2\" data-name=\"approvals count\">2 of 3</span>\n</div>\n<ul class=\"gt-approval-list\" data-kid=\"1-2-2-3-2-1-2-1-3-2\" data-name=\"approvals list\">\n<li data-kid=\"1-2-2-3-2-1-2-1-3-2-1\" data-name=\"approval row for Platform\"><span data-kid=\"1-2-2-3-2-1-2-1-3-2-1-1\" data-name=\"approval role name\">Platform</span><span class=\"gt-approved\" data-kid=\"1-2-2-3-2-1-2-1-3-2-1-2\" data-name=\"approved status with check\"><i aria-hidden=\"true\" class=\"icon-check gt-ico\" data-kid=\"1-2-2-3-2-1-2-1-3-2-1-2-1\" data-name=\"checkmark icon\"></i>Approved</span></li>\n<li data-kid=\"1-2-2-3-2-1-2-1-3-2-2\" data-name=\"approval row for Security\"><span data-kid=\"1-2-2-3-2-1-2-1-3-2-2-1\" data-name=\"approval role name\">Security</span><span class=\"gt-approved\" data-kid=\"1-2-2-3-2-1-2-1-3-2-2-2\" data-name=\"approved status with check\"><i aria-hidden=\"true\" class=\"icon-check gt-ico\" data-kid=\"1-2-2-3-2-1-2-1-3-2-2-2-1\" data-name=\"checkmark icon\"></i>Approved</span></li>\n<li data-kid=\"1-2-2-3-2-1-2-1-3-2-3\" data-name=\"approval row for Product\"><span data-kid=\"1-2-2-3-2-1-2-1-3-2-3-1\" data-name=\"approval role name\">Product</span><span class=\"gt-pending\" data-kid=\"1-2-2-3-2-1-2-1-3-2-3-2\" data-name=\"pending status with dot\">Pending</span></li>\n</ul>\n</div>\n<div class=\"gt-release-actions\" data-kid=\"1-2-2-3-2-1-2-1-4\" data-name=\"release actions bar\">\n<button class=\"gt-btn\" data-kid=\"1-2-2-3-2-1-2-1-4-1\" data-name=\"approve release button (disabled)\" disabled=\"\" type=\"button\">Approve release</button>\n<span class=\"gt-remaining\" data-kid=\"1-2-2-3-2-1-2-1-4-2\" data-name=\"remaining approvals note\">1 approval remaining</span>\n</div>\n</div>\n<div class=\"gt-release-audit\" data-kid=\"1-2-2-3-2-1-2-2\" data-name=\"release audit panel\">\n<div class=\"gt-block-head\" data-kid=\"1-2-2-3-2-1-2-2-1\" data-name=\"audit block header\"><span data-kid=\"1-2-2-3-2-1-2-2-1-1\" data-name=\"audit label\">Audit</span></div>\n<ol class=\"gt-audit\" data-kid=\"1-2-2-3-2-1-2-2-2\" data-name=\"audit timeline list\">\n<li data-kid=\"1-2-2-3-2-1-2-2-2-1\" data-name=\"audit item for release creation\"><time data-kid=\"1-2-2-3-2-1-2-2-2-1-1\" data-name=\"audit item timestamp\">09:12</time><span data-kid=\"1-2-2-3-2-1-2-2-2-1-2\" data-name=\"audit item description\">Release created</span></li>\n<li data-kid=\"1-2-2-3-2-1-2-2-2-2\" data-name=\"audit item for rollout change\"><time data-kid=\"1-2-2-3-2-1-2-2-2-2-1\" data-name=\"audit item timestamp\">10:04</time><span data-kid=\"1-2-2-3-2-1-2-2-2-2-2\" data-name=\"audit item description\">Rollout increased to 25%</span></li>\n<li data-kid=\"1-2-2-3-2-1-2-2-2-3\" data-name=\"audit item for approval request\"><time data-kid=\"1-2-2-3-2-1-2-2-2-3-1\" data-name=\"audit item timestamp\">10:22</time><span data-kid=\"1-2-2-3-2-1-2-2-2-3-2\" data-name=\"audit item description\">Approval requested from Product</span></li>\n</ol>\n</div>\n</div>\n</figure>\n<aside aria-label=\"Ownership for Switchyard\" class=\"gt-owned\" data-kid=\"1-2-2-3-2-2\" data-name=\"Switchyard ownership sidebar\">\n<h3 data-kid=\"1-2-2-3-2-2-1\" data-name=\"ownership heading\">Ownership</h3>\n<ul data-kid=\"1-2-2-3-2-2-2\" data-name=\"ownership list\">\n<li data-kid=\"1-2-2-3-2-2-2-1\" data-name=\"ownership item approval UI\">Approval and rollout interface</li>\n<li data-kid=\"1-2-2-3-2-2-2-2\" data-name=\"ownership item API\">Release-state API</li>\n<li data-kid=\"1-2-2-3-2-2-2-3\" data-name=\"ownership item updates\">Optimistic updates</li>\n<li data-kid=\"1-2-2-3-2-2-2-4\" data-name=\"ownership item recovery\">Reconnect recovery</li>\n</ul>\n<p class=\"gt-stackline\" data-kid=\"1-2-2-3-2-2-3\" data-name=\"stack line\"><span data-kid=\"1-2-2-3-2-2-3-1\" data-name=\"stack label\">Stack</span>React, TypeScript, Go, PostgreSQL, Redis, WebSockets</p>\n</aside>\n</div>\n<div class=\"gt-notes\" data-kid=\"1-2-2-3-3\" data-name=\"chapter notes grid\">\n<div data-kid=\"1-2-2-3-3-1\" data-name=\"optimistic updates note container\">\n<h3 data-kid=\"1-2-2-3-3-1-1\" data-name=\"note heading\">Optimistic updates</h3>\n<p data-kid=\"1-2-2-3-3-1-2\" data-name=\"note description\">Approval and rollout changes render immediately, then reconcile with the release-state response. A failed write restores the last confirmed state.</p>\n</div>\n<div data-kid=\"1-2-2-3-3-2\" data-name=\"reconnect recovery note container\">\n<h3 data-kid=\"1-2-2-3-3-2-1\" data-name=\"note heading\">Reconnect recovery</h3>\n<p data-kid=\"1-2-2-3-3-2-2\" data-name=\"note description\">After a dropped WebSocket, the client re-requests release state before accepting new events, so a stale rollout percentage does not survive the reconnect.</p>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"facet-title\" class=\"gt-chapter\" data-kid=\"1-2-2-4\" data-name=\"Facet project chapter\" id=\"facet\">\n<div class=\"gt-chapter-head\" data-kid=\"1-2-2-4-1\" data-name=\"chapter header with meta grid\">\n<div data-kid=\"1-2-2-4-1-1\" data-name=\"chapter title and purpose container\">\n<h2 data-kid=\"1-2-2-4-1-1-1\" data-name=\"chapter heading\" id=\"facet-title\">Facet</h2>\n<p class=\"gt-purpose\" data-kid=\"1-2-2-4-1-1-2\" data-name=\"chapter purpose description\">A workbench for product engineers to inspect component APIs, states, and token output.</p>\n</div>\n<dl class=\"gt-meta\" data-kid=\"1-2-2-4-1-2\" data-name=\"project metadata definition list\">\n<div data-kid=\"1-2-2-4-1-2-1\" data-name=\"metadata pair for type\"><dt data-kid=\"1-2-2-4-1-2-1-1\" data-name=\"metadata term type\">Type</dt><dd data-kid=\"1-2-2-4-1-2-1-2\" data-name=\"metadata value type\">Design systems</dd></div>\n<div data-kid=\"1-2-2-4-1-2-2\" data-name=\"metadata pair for company\"><dt data-kid=\"1-2-2-4-1-2-2-1\" data-name=\"metadata term company\">Company</dt><dd data-kid=\"1-2-2-4-1-2-2-2\" data-name=\"metadata value company\">Tessellate</dd></div>\n<div data-kid=\"1-2-2-4-1-2-3\" data-name=\"metadata pair for role\"><dt data-kid=\"1-2-2-4-1-2-3-1\" data-name=\"metadata term role\">Role</dt><dd data-kid=\"1-2-2-4-1-2-3-2\" data-name=\"metadata value role\">Design systems engineer</dd></div>\n<div data-kid=\"1-2-2-4-1-2-4\" data-name=\"metadata pair for years\"><dt data-kid=\"1-2-2-4-1-2-4-1\" data-name=\"metadata term years\">Years</dt><dd data-kid=\"1-2-2-4-1-2-4-2\" data-name=\"metadata value years\">2022–Present</dd></div>\n</dl>\n</div>\n<div class=\"gt-evidence\" data-kid=\"1-2-2-4-2\" data-name=\"evidence area with window and ownership\">\n<figure aria-labelledby=\"facet-window-title\" class=\"gt-window gt-window--facet\" data-kid=\"1-2-2-4-2-1\" data-name=\"design systems window mockup\">\n<div class=\"gt-window-bar\" data-kid=\"1-2-2-4-2-1-1\" data-name=\"window title bar\">\n<span class=\"gt-window-app\" data-kid=\"1-2-2-4-2-1-1-1\" data-name=\"window app name\">Facet</span>\n<span class=\"gt-window-title\" data-kid=\"1-2-2-4-2-1-1-2\" data-name=\"window document title\" id=\"facet-window-title\">Dialog, confirm variant</span>\n<span class=\"gt-window-count\" data-kid=\"1-2-2-4-2-1-1-3\" data-name=\"state count badge\">4 states</span>\n</div>\n<table class=\"gt-matrix\" data-kid=\"1-2-2-4-2-1-2\" data-name=\"dialog states matrix table\">\n<caption class=\"gt-sr-only\" data-kid=\"1-2-2-4-2-1-2-1\" data-name=\"table caption for screen readers\">Dialog states, preview, focus target, and implementation notes</caption>\n<thead data-kid=\"1-2-2-4-2-1-2-2\" data-name=\"table header row\">\n<tr data-kid=\"1-2-2-4-2-1-2-2-1\" data-name=\"header row cells\">\n<th data-kid=\"1-2-2-4-2-1-2-2-1-1\" data-name=\"column header state\" scope=\"col\">State</th>\n<th data-kid=\"1-2-2-4-2-1-2-2-1-2\" data-name=\"column header preview\" scope=\"col\">Preview</th>\n<th data-kid=\"1-2-2-4-2-1-2-2-1-3\" data-name=\"column header focus\" scope=\"col\">Focus</th>\n<th data-kid=\"1-2-2-4-2-1-2-2-1-4\" data-name=\"column header notes\" scope=\"col\">Notes</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-2-2-4-2-1-2-3\" data-name=\"table body\">\n<tr data-kid=\"1-2-2-4-2-1-2-3-1\" data-name=\"default state row\">\n<th data-kid=\"1-2-2-4-2-1-2-3-1-1\" data-name=\"row header default\" scope=\"row\">Default</th>\n<td class=\"gt-matrix-preview\" data-kid=\"1-2-2-4-2-1-2-3-1-2\" data-label=\"Preview\" data-name=\"default state preview cell\">\n<div aria-hidden=\"true\" class=\"gt-dialog\" data-kid=\"1-2-2-4-2-1-2-3-1-2-1\" data-name=\"dialog mockup default\">\n<p class=\"gt-dialog-title\" data-kid=\"1-2-2-4-2-1-2-3-1-2-1-1\" data-name=\"dialog title\">Confirm changes</p>\n<div class=\"gt-dialog-actions\" data-kid=\"1-2-2-4-2-1-2-3-1-2-1-2\" data-name=\"dialog action buttons\"><span class=\"gt-dialog-btn\" data-kid=\"1-2-2-4-2-1-2-3-1-2-1-2-1\" data-name=\"cancel button mock\">Cancel</span><span class=\"gt-dialog-btn gt-dialog-btn--primary\" data-kid=\"1-2-2-4-2-1-2-3-1-2-1-2-2\" data-name=\"continue button mock\">Continue</span></div>\n</div>\n</td>\n<td class=\"gt-matrix-focus\" data-kid=\"1-2-2-4-2-1-2-3-1-3\" data-label=\"Focus\" data-name=\"focus target value\">Cancel</td>\n<td class=\"gt-matrix-notes\" data-kid=\"1-2-2-4-2-1-2-3-1-4\" data-label=\"Notes\" data-name=\"implementation note\">Initial focus on the cancel action.</td>\n</tr>\n<tr data-kid=\"1-2-2-4-2-1-2-3-2\" data-name=\"validation error state row\">\n<th data-kid=\"1-2-2-4-2-1-2-3-2-1\" data-name=\"row header validation error\" scope=\"row\">Validation error</th>\n<td class=\"gt-matrix-preview\" data-kid=\"1-2-2-4-2-1-2-3-2-2\" data-label=\"Preview\" data-name=\"validation error preview cell\">\n<div aria-hidden=\"true\" class=\"gt-dialog\" data-kid=\"1-2-2-4-2-1-2-3-2-2-1\" data-name=\"dialog mockup error\">\n<p class=\"gt-dialog-title\" data-kid=\"1-2-2-4-2-1-2-3-2-2-1-1\" data-name=\"dialog title\">Choose a workspace</p>\n<p class=\"gt-dialog-msg gt-dialog-msg--error\" data-kid=\"1-2-2-4-2-1-2-3-2-2-1-2\" data-name=\"dialog error message\">Select a workspace to continue.</p>\n<div class=\"gt-dialog-actions\" data-kid=\"1-2-2-4-2-1-2-3-2-2-1-3\" data-name=\"dialog action buttons\"><span class=\"gt-dialog-btn\" data-kid=\"1-2-2-4-2-1-2-3-2-2-1-3-1\" data-name=\"cancel button mock\">Cancel</span><span class=\"gt-dialog-btn gt-dialog-btn--primary\" data-kid=\"1-2-2-4-2-1-2-3-2-2-1-3-2\" data-name=\"continue button mock\">Continue</span></div>\n</div>\n</td>\n<td class=\"gt-matrix-focus\" data-kid=\"1-2-2-4-2-1-2-3-2-3\" data-label=\"Focus\" data-name=\"focus target value\">Cancel</td>\n<td class=\"gt-matrix-notes\" data-kid=\"1-2-2-4-2-1-2-3-2-4\" data-label=\"Notes\" data-name=\"implementation note\">Error linked with aria-describedby.</td>\n</tr>\n<tr data-kid=\"1-2-2-4-2-1-2-3-3\" data-name=\"submitting state row\">\n<th data-kid=\"1-2-2-4-2-1-2-3-3-1\" data-name=\"row header submitting\" scope=\"row\">Submitting</th>\n<td class=\"gt-matrix-preview\" data-kid=\"1-2-2-4-2-1-2-3-3-2\" data-label=\"Preview\" data-name=\"submitting state preview cell\">\n<div aria-hidden=\"true\" class=\"gt-dialog\" data-kid=\"1-2-2-4-2-1-2-3-3-2-1\" data-name=\"dialog mockup submitting\">\n<p class=\"gt-dialog-title\" data-kid=\"1-2-2-4-2-1-2-3-3-2-1-1\" data-name=\"dialog title\">Updating workspace</p>\n<p class=\"gt-dialog-msg\" data-kid=\"1-2-2-4-2-1-2-3-3-2-1-2\" data-name=\"dialog info message\">Changes are being applied.</p>\n<div class=\"gt-dialog-actions\" data-kid=\"1-2-2-4-2-1-2-3-3-2-1-3\" data-name=\"dialog action buttons disabled\"><span class=\"gt-dialog-btn gt-dialog-btn--disabled\" data-kid=\"1-2-2-4-2-1-2-3-3-2-1-3-1\" data-name=\"cancel button disabled mock\">Cancel</span><span class=\"gt-dialog-btn gt-dialog-btn--disabled\" data-kid=\"1-2-2-4-2-1-2-3-3-2-1-3-2\" data-name=\"updating button disabled mock\">Updating</span></div>\n</div>\n</td>\n<td class=\"gt-matrix-focus\" data-kid=\"1-2-2-4-2-1-2-3-3-3\" data-label=\"Focus\" data-name=\"focus target value\">Cancel</td>\n<td class=\"gt-matrix-notes\" data-kid=\"1-2-2-4-2-1-2-3-3-4\" data-label=\"Notes\" data-name=\"implementation note\">Both actions disabled while pending.</td>\n</tr>\n<tr data-kid=\"1-2-2-4-2-1-2-3-4\" data-name=\"success state row\">\n<th data-kid=\"1-2-2-4-2-1-2-3-4-1\" data-name=\"row header success\" scope=\"row\">Success</th>\n<td class=\"gt-matrix-preview\" data-kid=\"1-2-2-4-2-1-2-3-4-2\" data-label=\"Preview\" data-name=\"success state preview cell\">\n<div aria-hidden=\"true\" class=\"gt-dialog\" data-kid=\"1-2-2-4-2-1-2-3-4-2-1\" data-name=\"dialog mockup success\">\n<p class=\"gt-dialog-title\" data-kid=\"1-2-2-4-2-1-2-3-4-2-1-1\" data-name=\"dialog title\">Changes saved</p>\n<p class=\"gt-dialog-msg\" data-kid=\"1-2-2-4-2-1-2-3-4-2-1-2\" data-name=\"dialog success message\">The workspace is up to date.</p>\n<div class=\"gt-dialog-actions\" data-kid=\"1-2-2-4-2-1-2-3-4-2-1-3\" data-name=\"dialog action button\"><span class=\"gt-dialog-btn gt-dialog-btn--primary\" data-kid=\"1-2-2-4-2-1-2-3-4-2-1-3-1\" data-name=\"done button mock\">Done</span></div>\n</div>\n</td>\n<td class=\"gt-matrix-focus\" data-kid=\"1-2-2-4-2-1-2-3-4-3\" data-label=\"Focus\" data-name=\"focus target value\">Done</td>\n<td class=\"gt-matrix-notes\" data-kid=\"1-2-2-4-2-1-2-3-4-4\" data-label=\"Notes\" data-name=\"implementation note\">Focus returns to the trigger on close.</td>\n</tr>\n</tbody>\n</table>\n<div class=\"gt-api\" data-kid=\"1-2-2-4-2-1-3\" data-name=\"API reference block\">\n<div class=\"gt-api-head\" data-kid=\"1-2-2-4-2-1-3-1\" data-name=\"API header labels\"><span data-kid=\"1-2-2-4-2-1-3-1-1\" data-name=\"API block label\">API</span><span data-kid=\"1-2-2-4-2-1-3-1-2\" data-name=\"API component name\">Dialog</span></div>\n<pre data-kid=\"1-2-2-4-2-1-3-2\" data-name=\"API code sample container\"><code data-kid=\"1-2-2-4-2-1-3-2-1\" data-name=\"JSX code snippet\">&lt;Dialog\n  open={open}\n  title=\"Confirm changes\"\n  onConfirm={save}\n  confirmLabel=\"Continue\"\n/&gt;</code></pre>\n<p class=\"gt-tokens\" data-kid=\"1-2-2-4-2-1-3-3\" data-name=\"design tokens list\">Token export: --dialog-radius, --dialog-surface, --dialog-focus</p>\n</div>\n</figure>\n<aside aria-label=\"Ownership for Facet\" class=\"gt-owned\" data-kid=\"1-2-2-4-2-2\" data-name=\"Facet ownership sidebar\">\n<h3 data-kid=\"1-2-2-4-2-2-1\" data-name=\"ownership heading\">Ownership</h3>\n<ul data-kid=\"1-2-2-4-2-2-2\" data-name=\"ownership list\">\n<li data-kid=\"1-2-2-4-2-2-2-1\" data-name=\"ownership item false\">Component API</li>\n<li data-kid=\"1-2-2-4-2-2-2-2\" data-name=\"ownership item state matrix\">State matrix</li>\n<li data-kid=\"1-2-2-4-2-2-2-3\" data-name=\"ownership item token export\">Token export</li>\n<li data-kid=\"1-2-2-4-2-2-2-4\" data-name=\"ownership item a11y checks\">Accessibility checks</li>\n</ul>\n<p class=\"gt-stackline\" data-kid=\"1-2-2-4-2-2-3\" data-name=\"stack line\"><span data-kid=\"1-2-2-4-2-2-3-1\" data-name=\"stack label\">Stack</span>React, TypeScript, Vite, CSS custom properties, axe-core</p>\n</aside>\n</div>\n</section>\n<section aria-labelledby=\"scaffold-title\" class=\"gt-chapter\" data-kid=\"1-2-2-5\" data-name=\"scaffold-a11y project chapter\" id=\"scaffold-a11y\">\n<div class=\"gt-chapter-head\" data-kid=\"1-2-2-5-1\" data-name=\"chapter header with meta grid\">\n<div data-kid=\"1-2-2-5-1-1\" data-name=\"chapter title and purpose container\">\n<h2 data-kid=\"1-2-2-5-1-1-1\" data-name=\"chapter heading\" id=\"scaffold-title\">scaffold-a11y</h2>\n<p class=\"gt-purpose\" data-kid=\"1-2-2-5-1-1-2\" data-name=\"chapter purpose description\">A CLI that scaffolds an accessible confirm dialog, its tests, and its styles.</p>\n</div>\n<dl class=\"gt-meta\" data-kid=\"1-2-2-5-1-2\" data-name=\"project metadata definition list\">\n<div data-kid=\"1-2-2-5-1-2-1\" data-name=\"metadata pair for type\"><dt data-kid=\"1-2-2-5-1-2-1-1\" data-name=\"metadata term type\">Type</dt><dd data-kid=\"1-2-2-5-1-2-1-2\" data-name=\"metadata value type\">Open source CLI</dd></div>\n<div data-kid=\"1-2-2-5-1-2-2\" data-name=\"metadata pair for license\"><dt data-kid=\"1-2-2-5-1-2-2-1\" data-name=\"metadata term license\">License</dt><dd data-kid=\"1-2-2-5-1-2-2-2\" data-name=\"metadata value license\">MIT</dd></div>\n<div data-kid=\"1-2-2-5-1-2-3\" data-name=\"metadata pair for role\"><dt data-kid=\"1-2-2-5-1-2-3-1\" data-name=\"metadata term role\">Role</dt><dd data-kid=\"1-2-2-5-1-2-3-2\" data-name=\"metadata value role\">Maintainer</dd></div>\n<div data-kid=\"1-2-2-5-1-2-4\" data-name=\"metadata pair for years\"><dt data-kid=\"1-2-2-5-1-2-4-1\" data-name=\"metadata term years\">Years</dt><dd data-kid=\"1-2-2-5-1-2-4-2\" data-name=\"metadata value years\">2024–Present</dd></div>\n</dl>\n</div>\n<div class=\"gt-evidence\" data-kid=\"1-2-2-5-2\" data-name=\"evidence area with terminal window\">\n<figure aria-labelledby=\"term-title\" class=\"gt-window gt-window--term\" data-kid=\"1-2-2-5-2-1\" data-name=\"terminal window mockup\">\n<div class=\"gt-window-bar\" data-kid=\"1-2-2-5-2-1-1\" data-name=\"window title bar\">\n<span class=\"gt-window-app\" data-kid=\"1-2-2-5-2-1-1-1\" data-name=\"window app name\">CLI</span>\n<span class=\"gt-window-title\" data-kid=\"1-2-2-5-2-1-1-2\" data-name=\"window document title\" id=\"term-title\">scaffold-a11y</span>\n<button class=\"gt-copy\" data-copy=\"npx scaffold-a11y dialog --variant confirm\" data-dynamic=\"true\" data-kid=\"1-2-2-5-2-1-1-3\" data-name=\"copy command button\" data-reason=\"label text and icon swapped to 'Copied' on click for 2 seconds\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon-clipboard-copy gt-ico\" data-kid=\"1-2-2-5-2-1-1-3-1\" data-name=\"clipboard copy icon\"></i>\n<span data-copy-label=\"\" data-kid=\"1-2-2-5-2-1-1-3-2\" data-name=\"button label\">Copy command</span>\n</button>\n</div>\n<div class=\"gt-term-body\" data-kid=\"1-2-2-5-2-1-2\" data-name=\"terminal content body\">\n<p class=\"gt-cmd\" data-kid=\"1-2-2-5-2-1-2-1\" data-name=\"command line\"><span aria-hidden=\"true\" class=\"gt-prompt\" data-kid=\"1-2-2-5-2-1-2-1-1\" data-name=\"prompts symbol\">$</span>npx scaffold-a11y dialog --variant confirm</p>\n<pre class=\"gt-tree\" data-kid=\"1-2-2-5-2-1-2-2\" data-name=\"file tree output\">src/components/Dialog/\n  Dialog.tsx\n  Dialog.test.tsx\n  dialog.css</pre>\n<div class=\"gt-checks\" data-kid=\"1-2-2-5-2-1-2-3\" data-name=\"feature check pills\">\n<span class=\"gt-check\" data-kid=\"1-2-2-5-2-1-2-3-1\" data-name=\"focus trap check pill\"><i aria-hidden=\"true\" class=\"icon-check gt-ico\" data-kid=\"1-2-2-5-2-1-2-3-1-1\" data-name=\"checkmark icon\"></i>focus trap</span>\n<span class=\"gt-check\" data-kid=\"1-2-2-5-2-1-2-3-2\" data-name=\"escape key check pill\"><i aria-hidden=\"true\" class=\"icon-check gt-ico\" data-kid=\"1-2-2-5-2-1-2-3-2-1\" data-name=\"checkmark icon\"></i>Escape</span>\n<span class=\"gt-check\" data-kid=\"1-2-2-5-2-1-2-3-3\" data-name=\"ARIA check pill\"><i aria-hidden=\"true\" class=\"icon-check gt-ico\" data-kid=\"1-2-2-5-2-1-2-3-3-1\" data-name=\"checkmark icon\"></i>ARIA</span>\n</div>\n</div>\n<div class=\"gt-term-foot\" data-kid=\"1-2-2-5-2-1-3\" data-name=\"terminal footer with link and meta\">\n<a data-kid=\"1-2-2-5-2-1-3-1\" data-name=\"GitHub link with arrow icon\" href=\"https://github.com/inezpark\" rel=\"noreferrer\" target=\"_blank\">github.com/inezpark <i aria-hidden=\"true\" class=\"icon-arrow-up-right gt-ico\" data-kid=\"1-2-2-5-2-1-3-1-1\" data-name=\"arrow up right icon\"></i></a>\n<span data-kid=\"1-2-2-5-2-1-3-2\" data-name=\"file count and license note\">3 files created · MIT</span>\n</div>\n</figure>\n<aside aria-label=\"Ownership for scaffold-a11y\" class=\"gt-owned\" data-kid=\"1-2-2-5-2-2\" data-name=\"scaffold-a11y ownership sidebar\">\n<h3 data-kid=\"1-2-2-5-2-2-1\" data-name=\"ownership heading\">Ownership</h3>\n<ul data-kid=\"1-2-2-5-2-2-2\" data-name=\"ownership list\">\n<li data-kid=\"1-2-2-5-2-2-2-1\" data-name=\"ownership item scaffolding\">CLI scaffolding</li>\n<li data-kid=\"1-2-2-5-2-2-2-2\" data-name=\"ownership item templates\">Component templates</li>\n<li data-kid=\"1-2-2-5-2-2-2-3\" data-name=\"ownership item assertions\">Accessibility assertions</li>\n<li data-kid=\"1-2-2-5-2-2-2-4\" data-name=\"ownership item CI\">Continuous integration</li>\n</ul>\n<p class=\"gt-stackline\" data-kid=\"1-2-2-5-2-2-3\" data-name=\"stack line\"><span data-kid=\"1-2-2-5-2-2-3-1\" data-name=\"stack label\">Stack</span>Node.js, TypeScript, Vitest, GitHub Actions</p>\n</aside>\n</div>\n</section>\n<section aria-labelledby=\"stack-title\" class=\"gt-section\" data-kid=\"1-2-2-6\" data-name=\"tech stack section\" id=\"stack\">\n<h2 data-kid=\"1-2-2-6-1\" data-name=\"section heading\" id=\"stack-title\">Stack</h2>\n<table class=\"gt-stack\" data-kid=\"1-2-2-6-2\" data-name=\"stack comparison table\">\n<caption class=\"gt-sr-only\" data-kid=\"1-2-2-6-2-1\" data-name=\"table caption for screen readers\">Technologies used across Switchyard, Facet, and scaffold-a11y</caption>\n<thead data-kid=\"1-2-2-6-2-2\" data-name=\"table header row\">\n<tr data-kid=\"1-2-2-6-2-2-1\" data-name=\"header row cells\">\n<th data-kid=\"1-2-2-6-2-2-1-1\" data-name=\"column header layer\" scope=\"col\">Layer</th>\n<th data-kid=\"1-2-2-6-2-2-1-2\" data-name=\"column header switchyard\" scope=\"col\">Switchyard</th>\n<th data-kid=\"1-2-2-6-2-2-1-3\" data-name=\"column header facet\" scope=\"col\">Facet</th>\n<th data-kid=\"1-2-2-6-2-2-1-4\" data-name=\"column header scaffold a11y\" scope=\"col\">scaffold-a11y</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-2-2-6-2-3\" data-name=\"table body\">\n<tr data-kid=\"1-2-2-6-2-3-1\" data-name=\"interface layer row\">\n<th data-kid=\"1-2-2-6-2-3-1-1\" data-name=\"row header interface\" scope=\"row\">Interface</th>\n<td data-kid=\"1-2-2-6-2-3-1-2\" data-name=\"switchyard interface stack\">React, TypeScript, CSS, Vite, Motion</td>\n<td data-kid=\"1-2-2-6-2-3-1-3\" data-name=\"facet interface stack\">React, TypeScript, CSS custom properties, Vite</td>\n<td data-kid=\"1-2-2-6-2-3-1-4\" data-name=\"scaffold a11y interface stack\">TypeScript, Node.js</td>\n</tr>\n<tr data-kid=\"1-2-2-6-2-3-2\" data-name=\"services layer row\">\n<th data-kid=\"1-2-2-6-2-3-2-1\" data-name=\"row header services\" scope=\"row\">Services</th>\n<td data-kid=\"1-2-2-6-2-3-2-2\" data-name=\"switchyard services stack\">Node.js, Go, PostgreSQL, Redis, WebSockets</td>\n<td data-kid=\"1-2-2-6-2-3-2-3\" data-name=\"facet services cell dash\">—</td>\n<td data-kid=\"1-2-2-6-2-3-2-4\" data-name=\"scaffold a11y services cell dash\">—</td>\n</tr>\n<tr data-kid=\"1-2-2-6-2-3-3\" data-name=\"quality layer row\">\n<th data-kid=\"1-2-2-6-2-3-3-1\" data-name=\"row header quality\" scope=\"row\">Quality</th>\n<td data-kid=\"1-2-2-6-2-3-3-2\" data-name=\"switchyard quality stack\">