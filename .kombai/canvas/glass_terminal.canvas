\"gt-ico gt-ico--sm\" data-kid=\"1-4-2-1-4-3-1-1-1-3-1\" data-name=\"copy icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><rect height=\"14\" rx=\"2\" width=\"14\" x=\"8\" y=\"8\"></rect><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"></path></svg>\n<span data-copy-label=\"\" data-dynamic=\"true\" data-kid=\"1-4-2-1-4-3-1-1-1-3-2\" data-name=\"button label copy\" data-reason=\"label text replaced with Copied on click by copy script\">Copy</span>\n</button>\n</div>\n<div class=\"gt-cli-body\" data-kid=\"1-4-2-1-4-3-1-1-2\" data-name=\"CLI command output body\">\n<div class=\"gt-cmd\" data-kid=\"1-4-2-1-4-3-1-1-2-1\" data-name=\"CLI command line\"><span class=\"gt-prompt\" data-kid=\"1-4-2-1-4-3-1-1-2-1-1\" data-name=\"terminal prompt symbol\">$</span>npx scaffold-a11y dialog --variant confirm</div>\n<div class=\"gt-output\" data-kid=\"1-4-2-1-4-3-1-1-2-2\" data-name=\"CLI output lines\">\n<div data-kid=\"1-4-2-1-4-3-1-1-2-2-1\" data-name=\"output line created Dialog.tsx\"><span class=\"gt-created\" data-kid=\"1-4-2-1-4-3-1-1-2-2-1-1\" data-name=\"created status label\">created</span>  src/components/Dialog.tsx</div>\n<div data-kid=\"1-4-2-1-4-3-1-1-2-2-2\" data-name=\"output line created test\"><span class=\"gt-created\" data-kid=\"1-4-2-1-4-3-1-1-2-2-2-1\" data-name=\"created status label\">created</span>  src/components/Dialog.test.tsx</div>\n<div data-kid=\"1-4-2-1-4-3-1-1-2-2-3\" data-name=\"output line created css\"><span class=\"gt-created\" data-kid=\"1-4-2-1-4-3-1-1-2-2-3-1\" data-name=\"created status label\">created</span>  src/styles/dialog.css</div>\n</div>\n</div>\n<div class=\"gt-cli-checks\" data-kid=\"1-4-2-1-4-3-1-1-3\" data-name=\"CLI feature checks strip\">\n<span class=\"gt-check\" data-kid=\"1-4-2-1-4-3-1-1-3-1\" data-name=\"check item focus trap\"><svg aria-hidden=\"true\" class=\"gt-ico gt-ico--sm\" data-kid=\"1-4-2-1-4-3-1-1-3-1-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Focus trap</span>\n<span class=\"gt-check\" data-kid=\"1-4-2-1-4-3-1-1-3-2\" data-name=\"check item escape\"><svg aria-hidden=\"true\" class=\"gt-ico gt-ico--sm\" data-kid=\"1-4-2-1-4-3-1-1-3-2-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Escape</span>\n<span class=\"gt-check\" data-kid=\"1-4-2-1-4-3-1-1-3-3\" data-name=\"check item ARIA\"><svg aria-hidden=\"true\" class=\"gt-ico gt-ico--sm\" data-kid=\"1-4-2-1-4-3-1-1-3-3-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg>ARIA</span>\n</div>\n</div>\n</div>\n<div class=\"gt-oss-side\" data-kid=\"1-4-2-1-4-3-2\" data-name=\"open source side info\">\n<h4 data-kid=\"1-4-2-1-4-3-2-1\" data-name=\"open source side headline\">What the command writes</h4>\n<p data-kid=\"1-4-2-1-4-3-2-2\" data-name=\"open source description\">The generated component includes a focus trap, an Escape handler, labelled controls, and a test file that covers focus return.</p>\n<dl class=\"gt-oss-facts\" data-kid=\"1-4-2-1-4-3-2-3\" data-name=\"open source facts list\">\n<div class=\"gt-kv\" data-kid=\"1-4-2-1-4-3-2-3-1\" data-name=\"fact row maintainer\"><dt data-kid=\"1-4-2-1-4-3-2-3-1-1\" data-name=\"fact label maintainer\">Maintainer</dt><dd data-kid=\"1-4-2-1-4-3-2-3-1-2\" data-name=\"fact value\">Inez Park</dd></div>\n<div class=\"gt-kv\" data-kid=\"1-4-2-1-4-3-2-3-2\" data-name=\"fact row license\"><dt data-kid=\"1-4-2-1-4-3-2-3-2-1\" data-name=\"fact label license\">License</dt><dd data-kid=\"1-4-2-1-4-3-2-3-2-2\" data-name=\"fact value\">MIT</dd></div>\n<div class=\"gt-kv\" data-kid=\"1-4-2-1-4-3-2-3-3\" data-name=\"fact row stack\"><dt data-kid=\"1-4-2-1-4-3-2-3-3-1\" data-name=\"fact label stack\">Stack</dt><dd data-kid=\"1-4-2-1-4-3-2-3-3-2\" data-name=\"fact value\">Node.js, TypeScript, Vitest, GitHub Actions</dd></div>\n</dl>\n<a class=\"gt-link\" data-kid=\"1-4-2-1-4-3-2-4\" data-name=\"link to GitHub repository\" href=\"https://github.com/inezpark/scaffold-a11y\" rel=\"noreferrer\" target=\"_blank\">\n                Open repository\n                <svg aria-hidden=\"true\" class=\"gt-ico\" data-kid=\"1-4-2-1-4-3-2-4-1\" data-name=\"external-link arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M7 17 17 7\"></path><path d=\"M7 7h10v10\"></path></svg>\n</a>\n</div>\n</div>\n</article>\n</div>\n</section>\n<section aria-labelledby=\"stack-title\" class=\"gt-section\" data-kid=\"1-4-3\" data-name=\"stack section\" id=\"stack\">\n<div class=\"gt-shell\" data-kid=\"1-4-3-1\" data-name=\"stack section shell\">\n<div class=\"gt-section-head\" data-kid=\"1-4-3-1-1\" data-name=\"stack section heading row\">\n<h2 data-kid=\"1-4-3-1-1-1\" data-name=\"section title\" id=\"stack-title\">Stack</h2>\n</div>\n<div class=\"gt-stack-table\" data-kid=\"1-4-3-1-2\" data-name=\"stack table container\">\n<div class=\"gt-stack-row\" data-kid=\"1-4-3-1-2-1\" data-name=\"stack row interface\">\n<h3 data-kid=\"1-4-3-1-2-1-1\" data-name=\"stack category interface\">Interface</h3>\n<div class=\"gt-tech\" data-kid=\"1-4-3-1-2-1-2\" data-name=\"interface tech tags\"><span data-kid=\"1-4-3-1-2-1-2-1\" data-name=\"tech tag React\">React</span><span data-kid=\"1-4-3-1-2-1-2-2\" data-name=\"tech tag TypeScript\">TypeScript</span><span data-kid=\"1-4-3-1-2-1-2-3\" data-name=\"tech tag CSS\">CSS</span><span data-kid=\"1-4-3-1-2-1-2-4\" data-name=\"tech tag Vite\">Vite</span><span data-kid=\"1-4-3-1-2-1-2-5\" data-name=\"tech tag Motion\">Motion</span></div>\n<div class=\"gt-refs\" data-kid=\"1-4-3-1-2-1-3\" data-name=\"interface project references\"><a data-kid=\"1-4-3-1-2-1-3-1\" data-name=\"reference link Switchyard\" href=\"#switchyard-title\">Switchyard</a><br data-kid=\"1-4-3-1-2-1-3-2\" data-name=\"line break between refs\"/><a data-kid=\"1-4-3-1-2-1-3-3\" data-name=\"reference link Facet\" href=\"#facet\">Facet</a></div>\n</div>\n<div class=\"gt-stack-row\" data-kid=\"1-4-3-1-2-2\" data-name=\"stack row services\">\n<h3 data-kid=\"1-4-3-1-2-2-1\" data-name=\"stack category services\">Services</h3>\n<div class=\"gt-tech\" data-kid=\"1-4-3-1-2-2-2\" data-name=\"services tech tags\"><span data-kid=\"1-4-3-1-2-2-2-1\" data-name=\"tech tag Node.js\">Node.js</span><span data-kid=\"1-4-3-1-2-2-2-2\" data-name=\"tech tag Go\">Go</span><span data-kid=\"1-4-3-1-2-2-2-3\" data-name=\"tech tag PostgreSQL\">PostgreSQL</span><span data-kid=\"1-4-3-1-2-2-2-4\" data-name=\"tech tag Redis\">Redis</span><span data-kid=\"1-4-3-1-2-2-2-5\" data-name=\"tech tag WebSockets\">WebSockets</span></div>\n<div class=\"gt-refs\" data-kid=\"1-4-3-1-2-2-3\" data-name=\"services project references\"><a data-kid=\"1-4-3-1-2-2-3-1\" data-name=\"reference link Switchyard\" href=\"#switchyard-title\">Switchyard</a></div>\n</div>\n<div class=\"gt-stack-row\" data-kid=\"1-4-3-1-2-3\" data-name=\"stack row quality\">\n<h3 data-kid=\"1-4-3-1-2-3-1\" data-name=\"stack category quality\">Quality</h3>\n<div class=\"gt-tech\" data-kid=\"1-4-3-1-2-3-2\" data-name=\"quality tech tags\"><span data-kid=\"1-4-3-1-2-3-2-1\" data-name=\"tech tag Playwright\">Playwright</span><span data-kid=\"1-4-3-1-2-3-2-2\" data-name=\"tech tag Vitest\">Vitest</span><span data-kid=\"1-4-3-1-2-3-2-3\" data-name=\"tech tag axe-core\">axe-core</span><span data-kid=\"1-4-3-1-2-3-2-4\" data-name=\"tech tag GitHub Actions\">GitHub Actions</span></div>\n<div class=\"gt-refs\" data-kid=\"1-4-3-1-2-3-3\" data-name=\"quality project references\"><a data-kid=\"1-4-3-1-2-3-3-1\" data-name=\"reference link Facet\" href=\"#facet\">Facet</a><br data-kid=\"1-4-3-1-2-3-3-2\" data-name=\"line break between refs\"/><a data-kid=\"1-4-3-1-2-3-3-3\" data-name=\"reference link scaffold-a11y\" href=\"#open-source\">scaffold-a11y</a></div>\n</div>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"experience-title\" class=\"gt-section\" data-kid=\"1-4-4\" data-name=\"experience section\" id=\"experience\">\n<div class=\"gt-shell\" data-kid=\"1-4-4-1\" data-name=\"experience section shell\">\n<div class=\"gt-section-head\" data-kid=\"1-4-4-1-1\" data-name=\"experience section heading row\">\n<h2 data-kid=\"1-4-4-1-1-1\" data-name=\"section title\" id=\"experience-title\">Experience</h2>\n</div>\n<div class=\"gt-exp-row\" data-kid=\"1-4-4-1-2\" data-name=\"experience entry Tessellate\">\n<p class=\"gt-exp-period\" data-kid=\"1-4-4-1-2-1\" data-name=\"experience date range\">2022–Present</p>\n<div data-kid=\"1-4-4-1-2-2\" data-name=\"experience role and company block\">\n<h3 class=\"gt-exp-role\" data-kid=\"1-4-4-1-2-2-1\" data-name=\"experience role title\">Senior Full Stack Engineer</h3>\n<p class=\"gt-exp-company\" data-kid=\"1-4-4-1-2-2-2\" data-name=\"experience company name\">Tessellate</p>\n</div>\n<p class=\"gt-exp-desc\" data-kid=\"1-4-4-1-2-3\" data-name=\"experience summary\">Release tooling used by four product teams; frontend lead for Switchyard.</p>\n</div>\n<div class=\"gt-exp-row\" data-kid=\"1-4-4-1-3\" data-name=\"experience entry Copperline\">\n<p class=\"gt-exp-period\" data-kid=\"1-4-4-1-3-1\" data-name=\"experience date range\">2019–2022</p>\n<div data-kid=\"1-4-4-1-3-2\" data-name=\"experience role and company block\">\n<h3 class=\"gt-exp-role\" data-kid=\"1-4-4-1-3-2-1\" data-name=\"experience role title\">Frontend Engineer</h3>\n<p class=\"gt-exp-company\" data-kid=\"1-4-4-1-3-2-2\" data-name=\"experience company name\">Copperline</p>\n</div>\n<p class=\"gt-exp-desc\" data-kid=\"1-4-4-1-3-3\" data-name=\"experience summary\">Customer billing portal and internal support tools.</p>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"contact-title\" class=\"gt-section\" data-kid=\"1-4-5\" data-name=\"contact section\" id=\"contact\">\n<div class=\"gt-shell gt-contact\" data-kid=\"1-4-5-1\" data-name=\"contact section grid\">\n<div data-kid=\"1-4-5-1-1\" data-name=\"contact left column\">\n<h2 data-kid=\"1-4-5-1-1-1\" data-name=\"contact headline\" id=\"contact-title\">Contact</h2>\n<p class=\"gt-contact-lede\" data-kid=\"1-4-5-1-1-2\" data-name=\"contact subhead\">For senior full stack and frontend engineering roles.</p>\n<div class=\"gt-email-row\" data-kid=\"1-4-5-1-1-3\" data-name=\"email contact row\">\n<a class=\"gt-email\" data-kid=\"1-4-5-1-1-3-1\" data-name=\"email address link\" href=\"mailto:inez@inezpark.dev\">inez@inezpark.dev</a>\n<button aria-label=\"Copy email address\" class=\"gt-copy\" data-copy=\"inez@inezpark.dev\" data-kid=\"1-4-5-1-1-3-2\" data-name=\"copy email button\" type=\"button\">\n<svg aria-hidden=\"true\" class=\"gt-ico gt-ico--sm\" data-kid=\"1-4-5-1-1-3-2-1\" data-name=\"copy icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><rect height=\"14\" rx=\"2\" width=\"14\" x=\"8\" y=\"8\"></rect><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"></path></svg>\n<span data-copy-label=\"\" data-dynamic=\"true\" data-kid=\"1-4-5-1-1-3-2-2\" data-name=\"button label copy email\" data-reason=\"label text replaced with Copied on click by copy script\">Copy email</span>\n</button>\n</div>\n<p class=\"gt-contact-loc\" data-kid=\"1-4-5-1-1-4\" data-name=\"contact location\">Brooklyn, NY</p>\n</div>\n<div class=\"gt-contact-links\" data-kid=\"1-4-5-1-2\" data-name=\"contact links list\">\n<a class=\"gt-contact-link\" data-kid=\"1-4-5-1-2-1\" data-name=\"contact link personal site\" href=\"https://inezpark.dev\" rel=\"noreferrer\" target=\"_blank\">\n            inezpark.dev\n            <svg aria-hidden=\"true\" class=\"gt-ico\" data-kid=\"1-4-5-1-2-1-1\" data-name=\"external-link arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M7 17 17 7\"></path><path d=\"M7 7h10v10\"></path></svg>\n</a>\n<a class=\"gt-contact-link\" data-kid=\"1-4-5-1-2-2\" data-name=\"contact link GitHub\" href=\"https://github.com/inezpark\" rel=\"noreferrer\" target=\"_blank\">\n            GitHub\n            <svg aria-hidden=\"true\" class=\"gt-ico\" data-kid=\"1-4-5-1-2-2-1\" data-name=\"external-link arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M7 17 17 7\"></path><path d=\"M7 7h10v10\"></path></svg>\n</a>\n<a class=\"gt-contact-link\" data-kid=\"1-4-5-1-2-3\" data-name=\"contact link LinkedIn\" href=\"https://linkedin.com/in/inezpark\" rel=\"noreferrer\" target=\"_blank\">\n            LinkedIn\n            <svg aria-hidden=\"true\" class=\"gt-ico\" data-kid=\"1-4-5-1-2-3-1\" data-name=\"external-link arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M7 17 17 7\"></path><path d=\"M7 7h10v10\"></path></svg>\n</a>\n<a class=\"gt-contact-link\" data-kid=\"1-4-5-1-2-4\" data-name=\"contact link request resume\" href=\"mailto:inez@inezpark.dev?subject=R%C3%A9sum%C3%A9%20request\">\n            Request résumé\n            <svg aria-hidden=\"true\" class=\"gt-ico\" data-kid=\"1-4-5-1-2-4-1\" data-name=\"external-link arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M7 17 17 7\"></path><path d=\"M7 7h10v10\"></path></svg>\n</a>\n</div>\n</div>\n</section>\n</main>\n<footer class=\"gt-footer\" data-kid=\"1-5\" data-name=\"site footer\">\n<div class=\"gt-shell gt-footer-inner\" data-kid=\"1-5-1\" data-name=\"footer inner row\">\n<span data-kid=\"1-5-1-1\" data-name=\"footer name text\">Inez Park</span>\n<span data-kid=\"1-5-1-2\" data-name=\"footer location text\">Brooklyn, NY</span>\n<span data-kid=\"1-5-1-3\" data-name=\"footer copyright text\">© 2026</span>\n</div>\n</footer>\n<p aria-live=\"polite\" class=\"gt-sr\" data-dynamic=\"true\" data-kid=\"1-6\" data-name=\"global clipboard live region\" data-reason=\"screen-reader text written and cleared by copy script\" id=\"gt-copy-status\" role=\"status\"></p>\n</div>\n<script>\n(() => {\n  const toggle = document.querySelector('[data-impl-toggle]');\n  const panel = document.getElementById('switchyard-impl');\n  if (toggle && panel) {\n    toggle.addEventListener('click', () => {\n      const isOpen = toggle.getAttribute('aria-expanded') === 'true';\n      toggle.setAttribute('aria-expanded', String(!isOpen));\n      panel.hidden = isOpen;\n    });\n  }\n\n  const stateInputs = document.querySelectorAll('input[name=\"facet-state\"]');\n  const stateStatus = document.getElementById('facet-state-status');\n  stateInputs.forEach((input) => {\n    input.addEventListener('change', () => {\n      const label = document.querySelector('label[for=\"' + input.id + '\"]');\n      if (stateStatus && label) {\n        stateStatus.textContent = 'Previewing ' + label.textContent.trim() + ' state.';\n      }\n    });\n  });\n\n  const status = document.getElementById('gt-copy-status');\n  document.querySelectorAll('[data-copy]').forEach((button) => {\n    const label = button.querySelector('[data-copy-label]');\n    const original = label ? label.textContent : '';\n    button.addEventListener('click', async () => {\n      const value = button.getAttribute('data-copy');\n      try {\n        await navigator.clipboard.writeText(value);\n      } catch (error) {\n        /* Clipboard may be unavailable in an embedded preview. */\n      }\n      if (label) label.textContent = 'Copied';\n      if (status) status.textContent = 'Copied to clipboard';\n      window.setTimeout(() => {\n        if (label) label.textContent = original;\n        if (status) status.textContent = '';\n      }, 2000);\n    });\n  });\n})();\n</script>\n",
