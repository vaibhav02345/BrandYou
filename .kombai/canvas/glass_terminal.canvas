    "var_f53b5ca97bf9": {
      "type": "variant",
      "label": "Glass Terminal — Release Artifact",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap');\n\nhtml { scroll-behavior: smooth; }\nbody { margin: 0; background: #080a0d; }\n\n.gt-page {\n  --ink: #080a0d;\n  --ink-2: #0b0e13;\n  --panel: #0e1218;\n  --panel-2: #141920;\n  --line: rgba(233, 231, 226, 0.09);\n  --line-strong: rgba(233, 231, 226, 0.16);\n  --text: #e9e7e2;\n  --text-2: #c3c1bc;\n  --muted: #9ba3ac;\n  --faint: #7d8792;\n  --signal: #f0a47a;\n  --signal-soft: rgba(240, 164, 122, 0.11);\n  --sea: #8ecbd2;\n  --sea-soft: rgba(142, 203, 210, 0.1);\n  --error: #e7907f;\n  --sans: 'Geist', 'Instrument Sans', system-ui, -apple-system, sans-serif;\n  --mono: 'Geist Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;\n  --shell: min(1240px, calc(100% - 80px));\n\n  position: relative;\n  min-height: 100vh;\n  overflow-x: clip;\n  background: var(--ink);\n  color: var(--text);\n  font-family: var(--sans);\n  font-weight: 400;\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\n\n.gt-page *,\n.gt-page *::before,\n.gt-page *::after { box-sizing: border-box; }\n\n.gt-page h1,\n.gt-page h2,\n.gt-page h3,\n.gt-page h4,\n.gt-page h5,\n.gt-page p,\n.gt-page figure,\n.gt-page dl,\n.gt-page dd,\n.gt-page ul { margin: 0; padding: 0; }\n\n.gt-page a { color: inherit; text-decoration: none; }\n.gt-page button { font: inherit; color: inherit; }\n.gt-page ul { list-style: none; }\n.gt-page svg { display: block; }\n.gt-shell { width: var(--shell); margin-inline: auto; }\n.gt-sr {\n  position: absolute !important;\n  width: 1px; height: 1px;\n  padding: 0; margin: -1px;\n  overflow: hidden; clip: rect(0 0 0 0);\n  white-space: nowrap; border: 0;\n}\n.gt-mono { font-family: var(--mono); }\n\n/* ambient depth */\n.gt-ambient {\n  position: fixed;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  overflow: clip;\n}\n.gt-ambient::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(180deg, rgba(24, 42, 48, 0.52) 0%, rgba(8, 10, 13, 0) 34%);\n}\n.gt-ambient span {\n  position: absolute;\n  display: block;\n  border-radius: 50%;\n  filter: blur(110px);\n  opacity: 0.62;\n  animation: gt-drift 26s ease-in-out infinite alternate;\n}\n.gt-ambient span:nth-child(1) {\n  width: 860px; height: 680px;\n  top: -300px; left: -200px;\n  background: rgba(44, 112, 122, 0.46);\n}\n.gt-ambient span:nth-child(2) {\n  width: 780px; height: 620px;\n  top: -250px; right: -170px;\n  background: rgba(60, 70, 130, 0.4);\n  animation-delay: -8s;\n}\n.gt-ambient span:nth-child(3) {\n  width: 680px; height: 460px;\n  top: 58%; right: 8%;\n  background: rgba(160, 95, 62, 0.16);\n  animation-delay: -14s;\n}\n@keyframes gt-drift {\n  from { transform: translate3d(0, 0, 0) scale(1); }\n  to { transform: translate3d(0, 34px, 0) scale(1.06); }\n}\n\n.gt-page > header,\n.gt-page > main,\n.gt-page > footer { position: relative; z-index: 1; }\n\n/* skip link */\n.gt-skip {\n  position: fixed;\n  top: 10px; left: 10px;\n  z-index: 80;\n  padding: 10px 14px;\n  border-radius: 7px;\n  background: var(--signal);\n  color: #1a120d;\n  font-size: 13px;\n  font-weight: 500;\n  transform: translateY(-160%);\n  transition: transform 180ms ease;\n}\n.gt-skip:focus { transform: translateY(0); }\n\n/* header */\n.gt-header {\n  position: sticky;\n  top: 0;\n  z-index: 40;\n  background: rgba(8, 10, 13, 0.82);\n  border-bottom: 1px solid var(--line);\n  backdrop-filter: blur(16px) saturate(120%);\n  -webkit-backdrop-filter: blur(16px) saturate(120%);\n}\n.gt-header-inner {\n  height: 64px;\n  display: flex;\n  align-items: center;\n  gap: 28px;\n}\n.gt-brand {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 14px;\n  font-weight: 500;\n  letter-spacing: -0.018em;\n  min-height: 44px;\n}\n.gt-mark {\n  width: 27px;\n  height: 27px;\n  display: grid;\n  place-items: center;\n  border: 1px solid var(--line-strong);\n  border-radius: 7px;\n  font-family: var(--mono);\n  font-size: 9.5px;\n  letter-spacing: 0.02em;\n  color: var(--signal);\n  background: rgba(255, 255, 255, 0.025);\n}\n.gt-nav {\n  margin-left: auto;\n  display: flex;\n  align-items: center;\n  gap: 26px;\n}\n.gt-nav a {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  min-height: 44px;\n  font-family: var(--mono);\n  font-size: 12px;\n  color: var(--muted);\n  transition: color 160ms ease;\n}\n.gt-nav a::after {\n  content: '';\n  position: absolute;\n  left: 0; right: 0; bottom: 8px;\n  height: 1px;\n  background: var(--signal);\n  transform: scaleX(0);\n  transform-origin: left;\n  transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);\n}\n.gt-nav a:hover { color: var(--text); }\n.gt-nav a:hover::after { transform: scaleX(1); }\n.gt-header-actions {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n}\n.gt-resume {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 44px;\n  font-size: 12.5px;\n  color: var(--muted);\n  transition: color 160ms ease;\n}\n.gt-resume:hover { color: var(--text); }\n.gt-ico { width: 14px; height: 14px; flex: none; }\n.gt-ico--sm { width: 12px; height: 12px; }\n.gt-header-email {\n  display: inline-flex;\n  align-items: center;\n  height: 34px;\n  padding: 0 13px;\n  border: 1px solid rgba(240, 164, 122, 0.42);\n  border-radius: 7px;\n  font-size: 12.5px;\n  font-weight: 500;\n  color: var(--signal);\n  background: rgba(240, 164, 122, 0.04);\n  transition: background 180ms ease, border-color 180ms ease;\n}\n.gt-header-email:hover { background: var(--signal-soft); border-color: var(--signal); }\n\n/* intro */\n.gt-intro { padding: 58px 0 46px; }\n.gt-intro-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);\n  gap: 72px;\n  align-items: end;\n}\n.gt-name {\n  font-size: clamp(3.6rem, 6.1vw, 5.3rem);\n  font-weight: 500;\n  letter-spacing: -0.058em;\n  line-height: 0.92;\n}\n.gt-role-line {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-top: 20px;\n  font-family: var(--mono);\n  font-size: 12px;\n  color: var(--muted);\n}\n.gt-role-line .gt-divider {\n  width: 1px;\n  height: 11px;\n  background: var(--line-strong);\n}\n.gt-loc { color: var(--faint); }\n.gt-intro-side { padding-bottom: 4px; }\n.gt-profile {\n  max-width: 47ch;\n  font-size: 16.5px;\n  line-height: 1.72;\n  color: var(--text-2);\n}\n.gt-anchor-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  margin-top: 24px;\n  padding-bottom: 3px;\n  border-bottom: 1px solid var(--line-strong);\n  font-size: 13px;\n  color: var(--text);\n  transition: color 160ms ease, border-color 160ms ease;\n}\n.gt-anchor-link svg { color: var(--signal); }\n.gt-anchor-link:hover { color: var(--signal); border-color: var(--signal); }\n\n/* sections */\n.gt-section {\n  border-top: 1px solid var(--line);\n  padding: 76px 0;\n  scroll-margin-top: 84px;\n}\n.gt-section--work { padding-top: 50px; }\n.gt-section-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 32px;\n  margin-bottom: 30px;\n}\n.gt-section-head h2 {\n  font-size: 32px;\n  font-weight: 500;\n  letter-spacing: -0.035em;\n  line-height: 1.1;\n}\n.gt-section-head p {\n  max-width: 52ch;\n  font-size: 13.5px;\n  line-height: 1.6;\n  color: var(--faint);\n  text-align: right;\n}\n\n/* project heading */\n.gt-project-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 24px;\n  margin-bottom: 18px;\n}\n.gt-project-head h3 {\n  font-size: clamp(1.6rem, 1.95vw, 1.75rem);\n  font-weight: 500;\n  letter-spacing: -0.035em;\n  line-height: 1.05;\n}\n.gt-project-meta {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n  font-family: var(--mono);\n  font-size: 10.5px;\n  color: var(--faint);\n}\n.gt-project-meta span + span {\n  padding-left: 12px;\n  border-left: 1px solid var(--line);\n}\n.gt-lede {\n  max-width: 66ch;\n  margin: -6px 0 26px;\n  font-size: 14.5px;\n  line-height: 1.7;\n  color: var(--muted);\n}\n.gt-project + .gt-project {\n  margin-top: 74px;\n  padding-top: 74px;\n  border-top: 1px solid var(--line);\n}\n\n/* glass */\n.gt-glass {\n  padding: 7px;\n  border: 1px solid rgba(198, 228, 232, 0.19);\n  border-radius: 18px;\n  background:\n    linear-gradient(150deg, rgba(92, 137, 146, 0.26), rgba(20, 27, 36, 0.78) 46%, rgba(75, 82, 134, 0.22) 100%);\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.16),\n    0 40px 90px -44px rgba(0, 0, 0, 0.95);\n  backdrop-filter: blur(20px) saturate(125%);\n  -webkit-backdrop-filter: blur(20px) saturate(125%);\n}\n\n/* artifact */\n.gt-artifact-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.64fr) minmax(300px, 1fr);\n  gap: 26px;\n  align-items: start;\n}\n.gt-artifact-inner {\n  border: 1px solid rgba(255, 255, 255, 0.06);\n  border-radius: 12px;\n  overflow: hidden;\n  background: var(--panel);\n}\n.gt-app-bar {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  height: 44px;\n  padding: 0 14px;\n  border-bottom: 1px solid var(--line);\n  background: rgba(255, 255, 255, 0.022);\n}\n.gt-app-brand {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12.5px;\n  font-weight: 500;\n  color: var(--text);\n}\n.gt-glyph {\n  width: 15px;\n  height: 15px;\n  border-radius: 4px;\n  background: linear-gradient(135deg, var(--signal) 0 46%, #5a7f86 46% 100%);\n}\n.gt-app-workspace {\n  padding-left: 12px;\n  border-left: 1px solid var(--line);\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--faint);\n}\n.gt-app-tabs {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  margin-left: 16px;\n  height: 44px;\n}\n.gt-app-tab {\n  display: flex;\n  align-items: center;\n  height: 44px;\n  border-bottom: 1.5px solid transparent;\n  font-size: 11px;\n  color: var(--faint);\n}\n.gt-app-tab.is-active { color: var(--text); border-color: var(--signal); }\n.gt-app-region {\n  margin-left: auto;\n  font-family: var(--mono);\n  font-size: 9.5px;\n  color: var(--faint);\n}\n\n.gt-release-head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 18px;\n  padding: 14px;\n  border-bottom: 1px solid var(--line);\n}\n.gt-release-title-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n.gt-release-title-row h4 {\n  font-size: 19px;\n  font-weight: 500;\n  letter-spacing: -0.025em;\n  line-height: 1.1;\n}\n.gt-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  height: 20px;\n  padding: 0 7px;\n  border: 1px solid var(--line-strong);\n  border-radius: 5px;\n  font-family: var(--mono);\n  font-size: 9.5px;\n  font-weight: 500;\n  color: var(--muted);\n  white-space: nowrap;\n}\n.gt-chip--env { color: var(--muted); }\n.gt-chip--env .gt-dot { background: var(--sea); }\n.gt-chip--wait {\n  border-color: rgba(240, 164, 122, 0.34);\n  background: var(--signal-soft);\n  color: var(--signal);\n}\n.gt-chip-num { color: rgba(240, 164, 122, 0.72); }\n.gt-dot {\n  width: 5px;\n  height: 5px;\n  border-radius: 50%;\n  background: currentColor;\n  flex: none;\n}\n.gt-release-sub {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-top: 7px;\n  font-size: 10.5px;\n  color: var(--faint);\n}\n.gt-sep { width: 1px; height: 10px; background: var(--line-strong); }\n.gt-release-actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }\n\n.gt-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  height: 30px;\n  padding: 0 10px;\n  border-radius: 6px;\n  font-size: 11px;\n  font-weight: 500;\n  white-space: nowrap;\n}\n.gt-btn--primary { background: var(--signal); color: #1c120c; }\n.gt-btn--ghost {\n  border: 1px solid var(--line-strong);\n  color: var(--muted);\n  background: rgba(255, 255, 255, 0.02);\n}\n.gt-btn--disabled { opacity: 0.55; }\n\n.gt-app-body {\n  display: grid;\n  grid-template-columns: minmax(0, 1.52fr) minmax(0, 1fr);\n}\n.gt-app-main {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  min-width: 0;\n  padding: 14px;\n  border-right: 1px solid var(--line);\n}\n.gt-app-side {\n  min-width: 0;\n  padding: 14px;\n}\n.gt-field-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--faint);\n}\n.gt-field-head b { font-weight: 500; color: var(--muted); }\n.gt-rollout {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 5px;\n  margin-top: 7px;\n}\n.gt-step {\n  padding: 7px 4px;\n  border: 1px solid var(--line);\n  border-radius: 5px;\n  background: rgba(255, 255, 255, 0.015);\n  text-align: center;\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--faint);\n}\n.gt-step.is-active {\n  border-color: rgba(240, 164, 122, 0.5);\n  background: var(--signal-soft);\n  color: var(--signal);\n}\n.gt-subhead {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--faint);\n}\n.gt-approval {\n  display: grid;\n  grid-template-columns: 22px minmax(0, 1fr) auto 36px;\n  align-items: center;\n  gap: 9px;\n  padding: 6px 0;\n  border-top: 1px solid rgba(255, 255, 255, 0.055);\n}\n.gt-approval:first-of-type { border-top: 0; }\n.gt-avatar {\n  width: 22px;\n  height: 22px;\n  display: grid;\n  place-items: center;\n  border: 1px solid var(--line);\n  border-radius: 5px;\n  background: rgba(255, 255, 255, 0.045);\n  font-family: var(--mono);\n  font-size: 8.5px;\n  color: var(--text-2);\n}\n.gt-approval-name { font-size: 11.5px; line-height: 1.25; }\n.gt-approval-team { font-family: var(--mono); font-size: 9px; color: var(--faint); }\n.gt-status {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-family: var(--mono);\n  font-size: 9.5px;\n  white-space: nowrap;\n}\n.gt-status--ok { color: var(--sea); }\n.gt-status--wait { color: var(--signal); }\n.gt-time {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--faint);\n  text-align: right;\n}\n.gt-checks {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px 14px;\n  padding-top: 11px;\n  border-top: 1px solid var(--line);\n}\n.gt-check {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  font-size: 10.5px;\n  color: var(--muted);\n}\n.gt-check svg { color: var(--sea); }\n.gt-kv {\n  display: grid;\n  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);\n  gap: 10px;\n  padding: 6px 0;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.055);\n  font-size: 10.5px;\n}\n.gt-kv:last-child { border-bottom: 0; }\n.gt-kv dt { color: var(--faint); }\n.gt-kv dd { color: var(--text-2); text-align: right; }\n.gt-audit {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 10px;\n  padding: 9px 14px;\n  border-top: 1px solid var(--line);\n  background: rgba(0, 0, 0, 0.22);\n}\n.gt-audit-item { display: flex; align-items: baseline; gap: 7px; min-width: 0; }\n.gt-audit time { font-family: var(--mono); font-size: 9.5px; color: var(--faint); flex: none; }\n.gt-audit strong { font-size: 10.5px; font-weight: 400; color: var(--text-2); }\n.gt-audit span { font-size: 9.5px; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n\n/* ownership */\n.gt-ownership { padding-top: 6px; }\n.gt-own-role {\n  font-size: 19px;\n  font-weight: 500;\n  line-height: 1.3;\n  letter-spacing: -0.02em;\n}\n.gt-own-meta {\n  margin-top: 7px;\n  font-family: var(--mono);\n  font-size: 10.5px;\n  color: var(--faint);\n}\n.gt-own-fields {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n  margin-top: 24px;\n}\n.gt-own-field span {\n  display: block;\n  margin-bottom: 4px;\n  font-family: var(--mono);\n  font-size: 9.5px;\n  color: var(--faint);\n}\n.gt-own-field p { font-size: 13.5px; line-height: 1.5; color: var(--text-2); }\n.gt-own-stack { margin-top: 24px; }\n.gt-own-stack > span {\n  display: block;\n  margin-bottom: 8px;\n  font-family: var(--mono);\n  font-size: 9.5px;\n  color: var(--faint);\n}\n.gt-tags { display: flex; flex-wrap: wrap; gap: 5px; }\n.gt-tags span {\n  padding: 4px 6px;\n  border: 1px solid var(--line);\n  border-radius: 4px;\n  font-family: var(--mono);\n  font-size: 9.5px;\n  color: var(--muted);\n  background: rgba(255, 255, 255, 0.02);\n}\n.gt-toggle {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 44px;\n  margin-top: 16px;\n  padding: 0;\n  border: 0;\n  border-bottom: 1px solid var(--line-strong);\n  background: none;\n  font-size: 12.5px;\n  color: var(--text-2);\n  cursor: pointer;\n  transition: color 160ms ease, border-color 160ms ease;\n}\n.gt-toggle .gt-ico { color: var(--signal); transition: transform 200ms ease; }\n.gt-toggle:hover { color: var(--text); border-color: var(--signal); }\n.gt-toggle[aria-expanded=\"true\"] .gt-ico { transform: rotate(180deg); }\n.gt-impl {\n  margin-top: 12px;\n  padding-top: 13px;\n  border-top: 1px solid var(--line);\n  animation: gt-panel-in 220ms cubic-bezier(0.16, 1, 0.3, 1) both;\n}\n.gt-impl[hidden] { display: none; }\n.gt-impl p { font-size: 12.5px; line-height: 1.7; color: var(--muted); }\n.gt-impl p + p { margin-top: 9px; }\n.gt-impl strong {\n  display: block;\n  margin-bottom: 2px;\n  font-family: var(--mono);\n  font-size: 9.5px;\n  font-weight: 500;\n  color: var(--faint);\n}\n.gt-impl code {\n  font-family: var(--mono);\n  font-size: 11px;\n  color: var(--signal);\n}\n@keyframes gt-panel-in {\n  from { opacity: 0; transform: translateY(-4px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* implementation notes */\n.gt-notes {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 32px;\n  margin-top: 30px;\n  padding-top: 26px;\n  border-top: 1px solid var(--line);\n}\n.gt-note h5 {\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text);\n}\n.gt-note p {\n  max-width: 58ch;\n  margin-top: 7px;\n  font-size: 13px;\n  line-height: 1.72;\n  color: var(--muted);\n}\n\n/* workbench */\n.gt-workbench {\n  border: 1px solid var(--line);\n  border-radius: 14px;\n  overflow: hidden;\n  background: var(--panel);\n}\n.gt-workbench-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 10px 14px;\n  border-bottom: 1px solid var(--line);\n  background: rgba(255, 255, 255, 0.018);\n}\n.gt-workbench-title {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12.5px;\n  color: var(--text-2);\n}\n.gt-workbench-title span:last-child {\n  font-family: var(--mono);\n  font-size: 9.5px;\n  color: var(--faint);\n}\n.gt-ui-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 2px;\n  background: var(--sea);\n}\n.gt-statebar {\n  display: flex;\n  gap: 3px;\n  margin: 0;\n  padding: 3px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: rgba(255, 255, 255, 0.025);\n  position: relative;\n}\n.gt-statebar input {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  opacity: 0;\n}\n.gt-statebar label {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 29px;\n  padding: 0 10px;\n  border-radius: 5px;\n  font-size: 10.5px;\n  color: var(--faint);\n  cursor: pointer;\n  transition: background 160ms ease, color 160ms ease;\n  white-space: nowrap;\n}\n.gt-statebar label:hover { color: var(--text-2); }\n.gt-statebar input:checked + label {\n  background: rgba(240, 164, 122, 0.13);\n  color: var(--signal);\n}\n.gt-statebar input:focus-visible + label {\n  outline: 2px solid var(--signal);\n  outline-offset: 2px;\n}\n.gt-workbench-body {\n  display: grid;\n  grid-template-columns: minmax(0, 1.38fr) minmax(280px, 0.9fr);\n}\n.gt-stage {\n  position: relative;\n  display: grid;\n  place-items: center;\n  min-height: 344px;\n  padding: 24px;\n  border-right: 1px solid var(--line);\n  background-color: #0c1016;\n  background-image: radial-gradient(rgba(255, 255, 255, 0.075) 1px, transparent 1px);\n  background-size: 19px 19px;\n}\n.gt-state { display: none; width: 100%; max-width: 362px; }\n.gt-state--default { display: block; }\n.gt-workbench:has(#facet-error:checked) .gt-state--default { display: none; }\n.gt-workbench:has(#facet-error:checked) .gt-state--error { display: block; }\n.gt-workbench:has(#facet-submitting:checked) .gt-state--default { display: none; }\n.gt-workbench:has(#facet-submitting:checked) .gt-state--submitting { display: block; }\n.gt-workbench:has(#facet-success:checked) .gt-state--default { display: none; }\n.gt-workbench:has(#facet-success:checked) .gt-state--success { display: block; }\n\n.gt-dialog {\n  width: 100%;\n  border: 1px solid var(--line-strong);\n  border-radius: 11px;\n  overflow: hidden;\n  background: var(--panel-2);\n  box-shadow: 0 24px 50px -22px rgba(0, 0, 0, 0.9);\n}\n.gt-dialog-head { padding: 15px 15px 0; }\n.gt-dialog-head h5 {\n  font-size: 15px;\n  font-weight: 500;\n  letter-spacing: -0.015em;\n  color: var(--text);\n}\n.gt-dialog-head p {\n  margin-top: 5px;\n  font-size: 11.5px;\n  line-height: 1.55;\n  color: var(--muted);\n}\n.gt-dialog-field { padding: 12px 15px 0; }\n.gt-dialog-field label {\n  display: block;\n  margin-bottom: 5px;\n  font-size: 10px;\n  color: var(--faint);\n}\n.gt-input {\n  display: flex;\n  align-items: center;\n  min-height: 32px;\n  padding: 0 9px;\n  border: 1px solid var(--line-strong);\n  border-radius: 6px;\n  background: rgba(255, 255, 255, 0.025);\n  font-size: 10.5px;\n  color: var(--faint);\n}\n.gt-input.is-error { border-color: rgba(231, 144, 127, 0.6); }\n.gt-field-error {\n  margin-top: 5px;\n  font-size: 10px;\n  color: var(--error);\n}\n.gt-dialog-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 6px;\n  padding: 13px 15px 15px;\n}\n.gt-dialog-actions .gt-btn { height: 29px; font-size: 10.5px; }\n.gt-spinner {\n  width: 11px;\n  height: 11px;\n  border: 1.5px solid rgba(28, 18, 12, 0.3);\n  border-top-color: #1c120c;\n  border-radius: 50%;\n  animation: gt-spin 700ms linear infinite;\n}\n@keyframes gt-spin { to { transform: rotate(360deg); } }\n.gt-success {\n  display: grid;\n  place-items: center;\n  padding: 22px 16px 18px;\n  text-align: center;\n}\n.gt-success-mark {\n  width: 34px;\n  height: 34px;\n  display: grid;\n  place-items: center;\n  margin-bottom: 10px;\n  border: 1px solid rgba(142, 203, 210, 0.45);\n  border-radius: 50%;\n  background: var(--sea-soft);\n  color: var(--sea);\n}\n.gt-success h5 { font-size: 14px; font-weight: 500; color: var(--text); }\n.gt-success p { max-width: 28ch; margin-top: 5px; font-size: 11px; line-height: 1.5; color: var(--muted); }\n.gt-success .gt-btn { margin-top: 14px; height: 29px; font-size: 10.5px; }\n\n.gt-inspector {\n  min-width: 0;\n  padding: 18px;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 18px 24px;\n  align-content: start;\n}\n.gt-inspector h5 {\n  margin-bottom: 7px;\n  font-family: var(--mono);\n  font-size: 9.5px;\n  font-weight: 500;\n  color: var(--faint);\n}\n.gt-inspector section + section { margin-top: 0; }\n.gt-inspector section:last-child { grid-column: 1 / -1; }\n.gt-prop {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 5px 0;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n  font-family: var(--mono);\n  font-size: 10px;\n}\n.gt-prop span:first-child { color: var(--muted); }\n.gt-prop span:last-child { color: var(--faint); }\n.gt-prop em { font-style: normal; color: var(--signal); }\n.gt-token {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 5px 0;\n  font-family: var(--mono);\n  font-size: 9.5px;\n  color: var(--faint);\n}\n.gt-swatch {\n  width: 14px;\n  height: 14px;\n  border: 1px solid var(--line-strong);\n  border-radius: 3px;\n  flex: none;\n}\n.gt-token span:last-child { margin-left: auto; color: var(--muted); }\n.gt-inspector .gt-check { font-size: 10.5px; }\n.gt-inspector .gt-checks {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  padding-top: 0;\n  border-top: 0;\n}\n.gt-attrib {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 20px;\n  padding: 14px 16px;\n  border-top: 1px solid var(--line);\n  background: rgba(255, 255, 255, 0.018);\n}\n.gt-attrib span {\n  display: block;\n  margin-bottom: 4px;\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--faint);\n}\n.gt-attrib p { font-size: 11.5px; line-height: 1.5; color: var(--text-2); }\n\n/* CLI */\n.gt-oss {\n  display: grid;\n  grid-template-columns: minmax(0, 1.46fr) minmax(260px, 0.84fr);\n  gap: 40px;\n  align-items: start;\n}\n.gt-cli-inner {\n  border: 1px solid rgba(255, 255, 255, 0.06);\n  border-radius: 12px;\n  overflow: hidden;\n  background: #090d12;\n}\n.gt-cli-bar {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 13px;\n  border-bottom: 1px solid var(--line);\n  background: rgba(255, 255, 255, 0.022);\n}\n.gt-cli-name { font-family: var(--mono); font-size: 11px; color: var(--text-2); }\n.gt-cli-license {\n  padding: 2px 5px;\n  border: 1px solid var(--line);\n  border-radius: 3px;\n  font-family: var(--mono);\n  font-size: 8.5px;\n  color: var(--faint);\n}\n.gt-copy {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-height: 32px;\n  margin-left: auto;\n  padding: 0 9px;\n  border: 1px solid var(--line-strong);\n  border-radius: 6px;\n  background: rgba(255, 255, 255, 0.025);\n  font-size: 10.5px;\n  color: var(--muted);\n  cursor: pointer;\n  transition: color 160ms ease, border-color 160ms ease, background 160ms ease;\n}\n.gt-copy:hover { color: var(--text); border-color: var(--signal); background: var(--signal-soft); }\n.gt-copy svg { color: var(--signal); }\n.gt-cli-body {\n  padding: 16px;\n  overflow-x: auto;\n  font-family: var(--mono);\n  font-size: 11.5px;\n  line-height: 1.95;\n  color: var(--text-2);\n  white-space: nowrap;\n}\n.gt-cmd .gt-prompt { color: var(--signal); margin-right: 8px; }\n.gt-output { margin-top: 8px; color: var(--faint); }\n.gt-created { color: var(--sea); }\n.gt-cli-checks {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px 18px;\n  padding: 12px 16px;\n  border-top: 1px solid var(--line);\n  background: rgba(0, 0, 0, 0.16);\n}\n.gt-oss-side h4 {\n  font-size: 17px;\n  font-weight: 500;\n  letter-spacing: -0.02em;\n  line-height: 1.35;\n}\n.gt-oss-side > p {\n  margin-top: 10px;\n  font-size: 13px;\n  line-height: 1.72;\n  color: var(--muted);\n}\n.gt-oss-facts { margin-top: 18px; }\n.gt-oss-facts .gt-kv { font-size: 10.5px; grid-template-columns: 0.8fr 1.2fr; padding: 7px 0; border-color: var(--line); }\n.gt-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  min-height: 44px;\n  margin-top: 14px;\n  border-bottom: 1px solid var(--line-strong);\n  font-size: 12.5px;\n  color: var(--text);\n  transition: color 160ms ease, border-color 160ms ease;\n}\n.gt-link svg { color: var(--signal); }\n.gt-link:hover { color: var(--signal); border-color: var(--signal); }\n\n/* stack */\n.gt-stack-table { border-top: 1px solid var(--line); }\n.gt-stack-row {\n  display: grid;\n  grid-template-columns: 150px minmax(0, 1fr) 210px;\n  gap: 24px;\n  align-items: start;\n  padding: 20px 0;\n  border-bottom: 1px solid var(--line);\n}\n.gt-stack-row h3 { font-size: 13.5px; font-weight: 500; color: var(--text); }\n.gt-tech { display: flex; flex-wrap: wrap; gap: 5px; }\n.gt-tech span {\n  padding: 4px 7px;\n  border: 1px solid var(--line);\n  border-radius: 4px;\n  background: rgba(255, 255, 255, 0.02);\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--muted);\n}\n.gt-refs {\n  font-family: var(--mono);\n  font-size: 9.5px;\n  line-height: 1.7;\n  color: var(--faint);\n  text-align: right;\n}\n.gt-refs a { color: var(--muted); border-bottom: 1px solid transparent; }\n.gt-refs a:hover { color: var(--signal); border-color: var(--signal); }\n\n/* experience */\n.gt-exp-row {\n  display: grid;\n  grid-template-columns: 144px minmax(0, 0.95fr) minmax(0, 1.05fr);\n  gap: 28px;\n  padding: 24px 0;\n  border-top: 1px solid var(--line);\n}\n.gt-exp-row:last-child { border-bottom: 1px solid var(--line); }\n.gt-exp-period { font-family: var(--mono); font-size: 10.5px; color: var(--faint); padding-top: 3px; }\n.gt-exp-role { font-size: 16px; font-weight: 500; letter-spacing: -0.015em; color: var(--text); }\n.gt-exp-company { margin-top: 3px; font-family: var(--mono); font-size: 10.5px; color: var(--signal); }\n.gt-exp-desc { max-width: 46ch; font-size: 13.5px; line-height: 1.7; color: var(--muted); }\n\n/* contact */\n.gt-contact {\n  display: grid;\n  grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);\n  gap: 64px;\n  align-items: start;\n}\n.gt-contact h2 {\n  font-size: 32px;\n  font-weight: 500;\n  letter-spacing: -0.035em;\n}\n.gt-contact-lede { margin-top: 8px; font-size: 13.5px; color: var(--faint); }\n.gt-email-row {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  flex-wrap: wrap;\n  margin-top: 26px;\n}\n.gt-email {\n  font-size: clamp(1.65rem, 3vw, 2.5rem);\n  font-weight: 400;\n  letter-spacing: -0.045em;\n  color: var(--text);\n  transition: color 160ms ease;\n}\n.gt-email:hover { color: var(--signal); }\n.gt-email-row .gt-copy { margin-left: 0; height: 34px; }\n.gt-contact-loc { margin-top: 16px; font-family: var(--mono); font-size: 10.5px; color: var(--faint); }\n.gt-contact-links { border-top: 1px solid var(--line); }\n.gt-contact-link {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  min-height: 50px;\n  border-bottom: 1px solid var(--line);\n  font-size: 13.5px;\n  color: var(--text-2);\n  transition: color 160ms ease;\n}\n.gt-contact-link svg { color: var(--faint); transition: color 160ms ease, transform 160ms ease; }\n.gt-contact-link:hover { color: var(--text); }\n.gt-contact-link:hover svg { color: var(--signal); transform: translate(1px, -1px); }\n\n/* footer */\n.gt-footer {\n  border-top: 1px solid var(--line);\n  padding: 20px 0 26px;\n}\n.gt-footer-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  font-family: var(--mono);\n  font-size: 9.5px;\n  color: var(--faint);\n}\n\n.gt-page :focus-visible {\n  outline: 2px solid var(--signal);\n  outline-offset: 3px;\n  border-radius: 2px;\n}\n\n/* tablet */\n@media (max-width: 1120px) {\n  .gt-artifact-grid { grid-template-columns: 1fr; }\n  .gt-ownership {\n    display: grid;\n    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);\n    gap: 0 32px;\n    padding-top: 22px;\n    border-top: 1px solid var(--line);\n  }\n  .gt-own-fields {\n    grid-row: span 2;\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 16px;\n    margin-top: 0;\n  }\n  .gt-own-stack { margin-top: 16px; }\n  .gt-toggle, .gt-impl { grid-column: 1 / -1; justify-self: start; }\n  .gt-impl { width: 100%; }\n  .gt-workbench-body { grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.85fr); }\n  .gt-oss { grid-template-columns: minmax(0, 1.3fr) minmax(250px, 0.7fr); gap: 30px; }\n}\n\n@media (max-width: 900px) {\n  .gt-header-inner {\n    height: auto;\n    flex-wrap: wrap;\n    padding: 10px 0;\n    gap: 10px 20px;\n  }\n  .gt-nav {\n    order: 3;\n    width: 100%;\n    margin-left: 0;\n    gap: 20px;\n    overflow-x: auto;\n  }\n  .gt-nav a { min-height: 36px; }\n  .gt-header-actions { margin-left: auto; }\n  .gt-resume { display: none; }\n  .gt-intro { padding: 42px 0 36px; }\n  .gt-intro-grid { grid-template-columns: 1fr; gap: 26px; }\n  .gt-profile { max-width: 58ch; }\n  .gt-section { padding: 56px 0; scroll-margin-top: 108px; }\n  .gt-section--work { padding-top: 40px; }\n  .gt-section-head { flex-direction: column; gap: 8px; align-items: flex-start; }\n  .gt-section-head p { text-align: left; }\n  .gt-project-head { flex-direction: column; align-items: flex-start; gap: 10px; }\n  .gt-project + .gt-project { margin-top: 56px; padding-top: 56px; }\n  .gt-workbench-body { grid-template-columns: 1fr; }\n  .gt-stage { border-right: 0; border-bottom: 1px solid var(--line); min-height: 320px; }\n  .gt-inspector {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 18px 26px;\n  }\n  .gt-inspector section + section { margin-top: 0; }\n  .gt-inspector section:last-child { grid-column: 1 / -1; }\n  .gt-oss { grid-template-columns: 1fr; gap: 28px; }\n  .gt-stack-row { grid-template-columns: 120px minmax(0, 1fr); gap: 16px 24px; }\n  .gt-refs { grid-column: 2; text-align: left; }\n  .gt-exp-row { grid-template-columns: 120px 1fr; gap: 14px 24px; }\n  .gt-exp-desc { grid-column: 2; }\n  .gt-contact { grid-template-columns: 1fr; gap: 36px; }\n  .gt-notes { gap: 24px; }\n}\n\n@media (max-width: 640px) {\n  .gt-page { --shell: calc(100% - 40px); }\n  .gt-name { font-size: clamp(2.9rem, 13vw, 3.7rem); }\n  .gt-role-line { flex-wrap: wrap; gap: 8px 12px; }\n  .gt-profile { font-size: 15px; }\n  .gt-header { backdrop-filter: blur(14px); }\n  .gt-app-tabs { display: none; }\n  .gt-app-region { display: none; }\n  .gt-release-head { flex-direction: column; }\n  .gt-release-actions { width: 100%; justify-content: stretch; }\n  .gt-release-actions .gt-btn { flex: 1; }\n  .gt-app-body { grid-template-columns: 1fr; }\n  .gt-app-main { border-right: 0; border-bottom: 1px solid var(--line); }\n  .gt-app-side { border-top: 0; }\n  .gt-approval { grid-template-columns: 22px minmax(0, 1fr) auto; }\n  .gt-time { display: none; }\n  .gt-audit { grid-template-columns: 1fr; gap: 7px; }\n  .gt-audit span { white-space: normal; }\n  .gt-ownership { grid-template-columns: 1fr; }\n  .gt-own-fields { grid-row: auto; grid-template-columns: 1fr; gap: 14px; margin-top: 18px; }\n  .gt-own-stack { margin-top: 18px; }\n  .gt-notes { grid-template-columns: 1fr; margin-top: 24px; padding-top: 22px; }\n  .gt-workbench-bar { flex-direction: column; align-items: stretch; gap: 10px; }\n  .gt-statebar { width: 100%; }\n  .gt-statebar label { flex: 1; padding: 0 4px; font-size: 10px; }\n  .gt-stage { padding: 16px; min-height: 300px; }\n  .gt-inspector { grid-template-columns: 1fr; gap: 18px; padding: 16px; }\n  .gt-inspector section:last-child { grid-column: auto; }\n  .gt-attrib { grid-template-columns: 1fr; gap: 12px; }\n  .gt-cli-body { font-size: 10.5px; padding: 14px; }\n  .gt-stack-row { grid-template-columns: 1fr; gap: 10px; }\n  .gt-refs { grid-column: auto; }\n  .gt-exp-row { grid-template-columns: 1fr; gap: 8px; }\n  .gt-exp-desc { grid-column: auto; }\n  .gt-contact h2 { font-size: 26px; }\n  .gt-email-row { gap: 10px; }\n  .gt-email { font-size: 1.55rem; }\n  .gt-footer-inner { flex-wrap: wrap; gap: 6px 14px; }\n}\n\n@media (max-width: 390px) {\n  .gt-name { font-size: 2.55rem; }\n  .gt-header-email { padding: 0 10px; font-size: 12px; }\n  .gt-nav { gap: 16px; }\n  .gt-nav a { font-size: 11px; }\n  .gt-release-title-row h4 { font-size: 17px; }\n  .gt-chip { font-size: 9px; }\n  .gt-statebar label { font-size: 9.5px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  html { scroll-behavior: auto; }\n  .gt-page *, .gt-page *::before, .gt-page *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n</style>\n<div class=\"gt-page\" data-kid=\"1\" data-name=\"portfolio page root\" id=\"top\">\n<a class=\"gt-skip\" data-kid=\"1-1\" data-name=\"skip-to-work link\" href=\"#work\">Skip to selected work</a>\n<div aria-hidden=\"true\" class=\"gt-ambient\" data-kid=\"1-2\" data-name=\"ambient background layer\"><span data-kid=\"1-2-1\" data-name=\"drifting ambient glow orb\"></span><span data-kid=\"1-2-2\" data-name=\"drifting ambient glow orb\"></span><span data-kid=\"1-2-3\" data-name=\"drifting ambient glow orb\"></span></div>\n<header class=\"gt-header\" data-kid=\"1-3\" data-name=\"sticky site header\">\n<div class=\"gt-shell gt-header-inner\" data-kid=\"1-3-1\" data-name=\"header inner container\">\n<a aria-label=\"Inez Park, back to top\" class=\"gt-brand\" data-kid=\"1-3-1-1\" data-name=\"brand name and monogram link\" href=\"#top\">\n<span aria-hidden=\"true\" class=\"gt-mark\" data-kid=\"1-3-1-1-1\" data-name=\"brand monogram badge IP\">IP</span>\n<span data-kid=\"1-3-1-1-2\" data-name=\"brand name text\">Inez Park</span>\n</a>\n<nav aria-label=\"Portfolio sections\" class=\"gt-nav\" data-kid=\"1-3-1-2\" data-name=\"main section navigation\">\n<a data-kid=\"1-3-1-2-1\" data-name=\"nav link to work section\" href=\"#work\">Work</a>\n<a data-kid=\"1-3-1-2-2\" data-name=\"nav link to stack section\" href=\"#stack\">Stack</a>\n<a data-kid=\"1-3-1-2-3\" data-name=\"nav link to experience section\" href=\"#experience\">Experience</a>\n<a data-kid=\"1-3-1-2-4\" data-name=\"nav link to contact section\" href=\"#contact\">Contact</a>\n</nav>\n<div class=\"gt-header-actions\" data-kid=\"1-3-1-3\" data-name=\"header actions container\">\n<a class=\"gt-resume\" data-kid=\"1-3-1-3-1\" data-name=\"request resume link\" href=\"mailto:inez@inezpark.dev?subject=R%C3%A9sum%C3%A9%20request\">\n          Résumé\n          <svg aria-hidden=\"true\" class=\"gt-ico gt-ico--sm\" data-kid=\"1-3-1-3-1-1\" data-name=\"external-link arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M7 17 17 7\"></path><path d=\"M7 7h10v10\"></path></svg>\n</a>\n<a class=\"gt-header-email\" data-kid=\"1-3-1-3-2\" data-name=\"email contact button\" href=\"mailto:inez@inezpark.dev\">Email</a>\n</div>\n</div>\n</header>\n<main data-kid=\"1-4\" data-name=\"main page content\">\n<section class=\"gt-intro\" data-kid=\"1-4-1\" data-name=\"intro section\">\n<div class=\"gt-shell gt-intro-grid\" data-kid=\"1-4-1-1\" data-name=\"intro two-column grid\">\n<div data-kid=\"1-4-1-1-1\" data-name=\"intro name column\">