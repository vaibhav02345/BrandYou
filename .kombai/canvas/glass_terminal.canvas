1-4-2-1-2-2-1-1-3-1-1-1\" data-name=\"rollout plan field head\"><b data-kid=\"1-4-2-1-2-2-1-1-3-1-1-1-1\" data-name=\"rollout plan label\">Rollout plan</b><span data-kid=\"1-4-2-1-2-2-1-1-3-1-1-1-2\" data-name=\"rollout plan metric\">25% of traffic</span></div>\n<div class=\"gt-rollout\" data-kid=\"1-4-2-1-2-2-1-1-3-1-1-2\" data-name=\"rollout step tiles\">\n<span class=\"gt-step\" data-kid=\"1-4-2-1-2-2-1-1-3-1-1-2-1\" data-name=\"rollout step 5 percent\">5%</span>\n<span class=\"gt-step is-active\" data-kid=\"1-4-2-1-2-2-1-1-3-1-1-2-2\" data-name=\"active rollout step 25 percent\">25%</span>\n<span class=\"gt-step\" data-kid=\"1-4-2-1-2-2-1-1-3-1-1-2-3\" data-name=\"rollout step 50 percent\">50%</span>\n<span class=\"gt-step\" data-kid=\"1-4-2-1-2-2-1-1-3-1-1-2-4\" data-name=\"rollout step 100 percent\">100%</span>\n</div>\n</div>\n<div data-kid=\"1-4-2-1-2-2-1-1-3-1-2\" data-name=\"approvals block\">\n<div class=\"gt-subhead\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-1\" data-name=\"approvals field head\"><span data-kid=\"1-4-2-1-2-2-1-1-3-1-2-1-1\" data-name=\"approvals label\">Approvals</span><span data-kid=\"1-4-2-1-2-2-1-1-3-1-2-1-2\" data-name=\"approvals count\">2 of 3 required</span></div>\n<div class=\"gt-approval\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-2\" data-name=\"approval row for Maya Chen\">\n<span class=\"gt-avatar\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-2-1\" data-name=\"approver avatar MC\">MC</span>\n<div data-kid=\"1-4-2-1-2-2-1-1-3-1-2-2-2\" data-name=\"approver identity block\"><div class=\"gt-approval-name\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-2-2-1\" data-name=\"approver name\">Maya Chen</div><div class=\"gt-approval-team\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-2-2-2\" data-name=\"approver team\">Platform</div></div>\n<span class=\"gt-status gt-status--wait\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-2-3\" data-name=\"pending approval status\"><span class=\"gt-dot\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-2-3-1\" data-name=\"status dot\"></span>Pending</span>\n<span class=\"gt-time\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-2-4\" data-name=\"approval time placeholder\">—</span>\n</div>\n<div class=\"gt-approval\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-3\" data-name=\"approval row for Ravi Shah\">\n<span class=\"gt-avatar\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-3-1\" data-name=\"approver avatar RS\">RS</span>\n<div data-kid=\"1-4-2-1-2-2-1-1-3-1-2-3-2\" data-name=\"approver identity block\"><div class=\"gt-approval-name\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-3-2-1\" data-name=\"approver name\">Ravi Shah</div><div class=\"gt-approval-team\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-3-2-2\" data-name=\"approver team\">Payments</div></div>\n<span class=\"gt-status gt-status--ok\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-3-3\" data-name=\"approved status\"><span class=\"gt-dot\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-3-3-1\" data-name=\"status dot\"></span>Approved</span>\n<span class=\"gt-time\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-3-4\" data-name=\"approval time\">10:04</span>\n</div>\n<div class=\"gt-approval\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-4\" data-name=\"approval row for Noor Haddad\">\n<span class=\"gt-avatar\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-4-1\" data-name=\"approver avatar NH\">NH</span>\n<div data-kid=\"1-4-2-1-2-2-1-1-3-1-2-4-2\" data-name=\"approver identity block\"><div class=\"gt-approval-name\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-4-2-1\" data-name=\"approver name\">Noor Haddad</div><div class=\"gt-approval-team\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-4-2-2\" data-name=\"approver team\">Security</div></div>\n<span class=\"gt-status gt-status--ok\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-4-3\" data-name=\"approved status\"><span class=\"gt-dot\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-4-3-1\" data-name=\"status dot\"></span>Approved</span>\n<span class=\"gt-time\" data-kid=\"1-4-2-1-2-2-1-1-3-1-2-4-4\" data-name=\"approval time\">10:22</span>\n</div>\n</div>\n<div class=\"gt-checks\" data-kid=\"1-4-2-1-2-2-1-1-3-1-3\" data-name=\"checklist of passing checks\">\n<span class=\"gt-check\" data-kid=\"1-4-2-1-2-2-1-1-3-1-3-1\" data-name=\"check item API contract\"><svg aria-hidden=\"true\" class=\"gt-ico gt-ico--sm\" data-kid=\"1-4-2-1-2-2-1-1-3-1-3-1-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg>API contract</span>\n<span class=\"gt-check\" data-kid=\"1-4-2-1-2-2-1-1-3-1-3-2\" data-name=\"check item Migration\"><svg aria-hidden=\"true\" class=\"gt-ico gt-ico--sm\" data-kid=\"1-4-2-1-2-2-1-1-3-1-3-2-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Migration</span>\n<span class=\"gt-check\" data-kid=\"1-4-2-1-2-2-1-1-3-1-3-3\" data-name=\"check item Smoke tests\"><svg aria-hidden=\"true\" class=\"gt-ico gt-ico--sm\" data-kid=\"1-4-2-1-2-2-1-1-3-1-3-3-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Smoke tests</span>\n</div>\n</div>\n<aside class=\"gt-app-side\" data-kid=\"1-4-2-1-2-2-1-1-3-2\" data-name=\"mockup side column\">\n<div class=\"gt-field-head\" data-kid=\"1-4-2-1-2-2-1-1-3-2-1\" data-name=\"release details field head\" style=\"margin-bottom:4px\"><b data-kid=\"1-4-2-1-2-2-1-1-3-2-1-1\" data-name=\"release details label\">Release details</b></div>\n<dl data-kid=\"1-4-2-1-2-2-1-1-3-2-2\" data-name=\"release details key-value list\">\n<div class=\"gt-kv\" data-kid=\"1-4-2-1-2-2-1-1-3-2-2-1\" data-name=\"release window row\"><dt data-kid=\"1-4-2-1-2-2-1-1-3-2-2-1-1\" data-name=\"release window label\">Release window</dt><dd data-kid=\"1-4-2-1-2-2-1-1-3-2-2-1-2\" data-name=\"release window value\">14:00–16:00 ET</dd></div>\n<div class=\"gt-kv\" data-kid=\"1-4-2-1-2-2-1-1-3-2-2-2\" data-name=\"owner row\"><dt data-kid=\"1-4-2-1-2-2-1-1-3-2-2-2-1\" data-name=\"owner label\">Owner</dt><dd data-kid=\"1-4-2-1-2-2-1-1-3-2-2-2-2\" data-name=\"owner value\">Inez Park</dd></div>\n<div class=\"gt-kv\" data-kid=\"1-4-2-1-2-2-1-1-3-2-2-3\" data-name=\"services row\"><dt data-kid=\"1-4-2-1-2-2-1-1-3-2-2-3-1\" data-name=\"services label\">Services</dt><dd data-kid=\"1-4-2-1-2-2-1-1-3-2-2-3-2\" data-name=\"services value\">checkout-api, ledger, pricing</dd></div>\n<div class=\"gt-kv\" data-kid=\"1-4-2-1-2-2-1-1-3-2-2-4\" data-name=\"approval policy row\"><dt data-kid=\"1-4-2-1-2-2-1-1-3-2-2-4-1\" data-name=\"approval policy label\">Approval policy</dt><dd data-kid=\"1-4-2-1-2-2-1-1-3-2-2-4-2\" data-name=\"approval policy value\">Platform, Payments, Security</dd></div>\n<div class=\"gt-kv\" data-kid=\"1-4-2-1-2-2-1-1-3-2-2-5\" data-name=\"change type row\"><dt data-kid=\"1-4-2-1-2-2-1-1-3-2-2-5-1\" data-name=\"change type label\">Change type</dt><dd data-kid=\"1-4-2-1-2-2-1-1-3-2-2-5-2\" data-name=\"change type value\">Progressive rollout</dd></div>\n</dl>\n</aside>\n</div>\n<div class=\"gt-audit\" data-kid=\"1-4-2-1-2-2-1-1-4\" data-name=\"audit log strip\">\n<div class=\"gt-audit-item\" data-kid=\"1-4-2-1-2-2-1-1-4-1\" data-name=\"audit event opened\"><time data-kid=\"1-4-2-1-2-2-1-1-4-1-1\" data-name=\"audit event time\">09:12</time><strong data-kid=\"1-4-2-1-2-2-1-1-4-1-2\" data-name=\"audit event action\">Release opened</strong><span data-kid=\"1-4-2-1-2-2-1-1-4-1-3\" data-name=\"audit event actor\">Inez Park</span></div>\n<div class=\"gt-audit-item\" data-kid=\"1-4-2-1-2-2-1-1-4-2\" data-name=\"audit event approval one\"><time data-kid=\"1-4-2-1-2-2-1-1-4-2-1\" data-name=\"audit event time\">10:04</time><strong data-kid=\"1-4-2-1-2-2-1-1-4-2-2\" data-name=\"audit event action\">Approval recorded</strong><span data-kid=\"1-4-2-1-2-2-1-1-4-2-3\" data-name=\"audit event actor\">Ravi Shah</span></div>\n<div class=\"gt-audit-item\" data-kid=\"1-4-2-1-2-2-1-1-4-3\" data-name=\"audit event approval two\"><time data-kid=\"1-4-2-1-2-2-1-1-4-3-1\" data-name=\"audit event time\">10:22</time><strong data-kid=\"1-4-2-1-2-2-1-1-4-3-2\" data-name=\"audit event action\">Approval recorded</strong><span data-kid=\"1-4-2-1-2-2-1-1-4-3-3\" data-name=\"audit event actor\">Noor Haddad</span></div>\n</div>\n</div>\n<figcaption class=\"gt-sr\" data-kid=\"1-4-2-1-2-2-1-2\" data-name=\"mockup screen-reader caption\">Switchyard release interface for checkout-api: production environment, awaiting two of three approvals, 25% progressive rollout, with audit events at 09:12, 10:04, and 10:22.</figcaption>\n</figure>\n<aside aria-label=\"Switchyard contribution\" class=\"gt-ownership\" data-kid=\"1-4-2-1-2-2-2\" data-name=\"Switchyard ownership aside\">\n<div data-kid=\"1-4-2-1-2-2-2-1\" data-name=\"ownership role block\">\n<h4 class=\"gt-own-role\" data-kid=\"1-4-2-1-2-2-2-1-1\" data-name=\"ownership role title\">Frontend lead, product engineer</h4>\n<p class=\"gt-own-meta\" data-kid=\"1-4-2-1-2-2-2-1-2\" data-name=\"ownership company and duration\">Tessellate / 2023–Present</p>\n</div>\n<div class=\"gt-own-fields\" data-kid=\"1-4-2-1-2-2-2-2\" data-name=\"ownership responsibility fields\">\n<div class=\"gt-own-field\" data-kid=\"1-4-2-1-2-2-2-2-1\" data-name=\"ownership field Interface\"><span data-kid=\"1-4-2-1-2-2-2-2-1-1\" data-name=\"ownership field label\">Interface</span><p data-kid=\"1-4-2-1-2-2-2-2-1-2\" data-name=\"ownership field value\">Approval and rollout UI</p></div>\n<div class=\"gt-own-field\" data-kid=\"1-4-2-1-2-2-2-2-2\" data-name=\"ownership field Services\"><span data-kid=\"1-4-2-1-2-2-2-2-2-1\" data-name=\"ownership field label\">Services</span><p data-kid=\"1-4-2-1-2-2-2-2-2-2\" data-name=\"ownership field value\">Release-state API</p></div>\n<div class=\"gt-own-field\" data-kid=\"1-4-2-1-2-2-2-2-3\" data-name=\"ownership field Reliability\"><span data-kid=\"1-4-2-1-2-2-2-2-3-1\" data-name=\"ownership field label\">Reliability</span><p data-kid=\"1-4-2-1-2-2-2-2-3-2\" data-name=\"ownership field value\">Optimistic updates<br data-kid=\"1-4-2-1-2-2-2-2-3-2-1\" data-name=\"line break in reliability value\"/>Reconnect recovery</p></div>\n</div>\n<div class=\"gt-own-stack\" data-kid=\"1-4-2-1-2-2-2-3\" data-name=\"ownership stack block\">\n<span data-kid=\"1-4-2-1-2-2-2-3-1\" data-name=\"ownership stack label\">Stack</span>\n<div class=\"gt-tags\" data-kid=\"1-4-2-1-2-2-2-3-2\" data-name=\"ownership stack tag list\">\n<span data-kid=\"1-4-2-1-2-2-2-3-2-1\" data-name=\"stack tag React\">React</span><span data-kid=\"1-4-2-1-2-2-2-3-2-2\" data-name=\"stack tag TypeScript\">TypeScript</span><span data-kid=\"1-4-2-1-2-2-2-3-2-3\" data-name=\"stack tag Go\">Go</span><span data-kid=\"1-4-2-1-2-2-2-3-2-4\" data-name=\"stack tag PostgreSQL\">PostgreSQL</span><span data-kid=\"1-4-2-1-2-2-2-3-2-5\" data-name=\"stack tag Redis\">Redis</span><span data-kid=\"1-4-2-1-2-2-2-3-2-6\" data-name=\"stack tag WebSockets\">WebSockets</span>\n</div>\n</div>\n<button aria-controls=\"switchyard-impl\" aria-expanded=\"false\" class=\"gt-toggle\" data-impl-toggle=\"\" data-kid=\"1-4-2-1-2-2-2-4\" data-name=\"show implementation toggle button\" type=\"button\">\n<span data-kid=\"1-4-2-1-2-2-2-4-1\" data-name=\"toggle button label\">View implementation</span>\n<svg aria-hidden=\"true\" class=\"gt-ico\" data-kid=\"1-4-2-1-2-2-2-4-2\" data-name=\"toggle chevron icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"m6 9 6 6 6-6\"></path></svg>\n</button>\n<div class=\"gt-impl\" data-kid=\"1-4-2-1-2-2-2-5\" data-name=\"hidden implementation details panel\" hidden=\"\" id=\"switchyard-impl\">\n<p data-kid=\"1-4-2-1-2-2-2-5-1\" data-name=\"implementation note release state\"><strong data-kid=\"1-4-2-1-2-2-2-5-1-1\" data-name=\"note subheading release state\">Release state</strong><code data-kid=\"1-4-2-1-2-2-2-5-1-2\" data-name=\"inline code GET endpoint\">GET /v1/releases/:id</code> returns the release, its approval records, and rollout step. <code data-kid=\"1-4-2-1-2-2-2-5-1-3\" data-name=\"inline code PATCH endpoint\">PATCH /v1/releases/:id/approvals</code> writes a decision with an idempotency key.</p>\n<p data-kid=\"1-4-2-1-2-2-2-5-2\" data-name=\"implementation note socket events\"><strong data-kid=\"1-4-2-1-2-2-2-5-2-1\" data-name=\"note subheading socket events\">Socket events</strong>The client subscribes to <code data-kid=\"1-4-2-1-2-2-2-5-2-2\" data-name=\"inline code event name\">release.updated</code>, <code data-kid=\"1-4-2-1-2-2-2-5-2-3\" data-name=\"inline code event name\">release.approval.changed</code>, and <code data-kid=\"1-4-2-1-2-2-2-5-2-4\" data-name=\"inline code event name\">release.rolled_back</code>, keeping a cursor so a reconnect can replay from the last acknowledged event.</p>\n</div>\n</aside>\n</div>\n<div class=\"gt-notes\" data-kid=\"1-4-2-1-2-3\" data-name=\"project implementation notes\">\n<div class=\"gt-note\" data-kid=\"1-4-2-1-2-3-1\" data-name=\"implementation note card optimistic state\">\n<h5 data-kid=\"1-4-2-1-2-3-1-1\" data-name=\"note title\">Optimistic approval state</h5>\n<p data-kid=\"1-4-2-1-2-3-1-2\" data-name=\"note body\">Approvals paint immediately and reconcile against the server response. A rejected request restores the previous state and surfaces the reason in place.</p>\n</div>\n<div class=\"gt-note\" data-kid=\"1-4-2-1-2-3-2\" data-name=\"implementation note card reconnect\">\n<h5 data-kid=\"1-4-2-1-2-3-2-1\" data-name=\"note title\">Reconnect recovery</h5>\n<p data-kid=\"1-4-2-1-2-3-2-2\" data-name=\"note body\">Release events arrive over a socket. On reconnect, the client rehydrates from the last acknowledged event and records any gap in the audit trail.</p>\n</div>\n</div>\n</article>\n<article aria-labelledby=\"facet-title\" class=\"gt-project\" data-kid=\"1-4-2-1-3\" data-name=\"Facet project article\" id=\"facet\">\n<div class=\"gt-project-head\" data-kid=\"1-4-2-1-3-1\" data-name=\"project heading row\">\n<h3 data-kid=\"1-4-2-1-3-1-1\" data-name=\"project title\" id=\"facet-title\">Facet</h3>\n<div class=\"gt-project-meta\" data-kid=\"1-4-2-1-3-1-2\" data-name=\"project meta tags\">\n<span data-kid=\"1-4-2-1-3-1-2-1\" data-name=\"project category tag\">Design systems</span>\n<span data-kid=\"1-4-2-1-3-1-2-2\" data-name=\"project company tag\">Tessellate</span>\n<span data-kid=\"1-4-2-1-3-1-2-3\" data-name=\"project duration tag\">2022–Present</span>\n</div>\n</div>\n<p class=\"gt-lede\" data-kid=\"1-4-2-1-3-2\" data-name=\"project lede paragraph\">A workbench where product engineers inspect component states, read the props, and export the tokens behind them.</p>\n<div class=\"gt-workbench\" data-kid=\"1-4-2-1-3-3\" data-name=\"component workbench container\">\n<div class=\"gt-workbench-bar\" data-kid=\"1-4-2-1-3-3-1\" data-name=\"workbench toolbar\">\n<div class=\"gt-workbench-title\" data-kid=\"1-4-2-1-3-3-1-1\" data-name=\"component title and type\"><span class=\"gt-ui-dot\" data-kid=\"1-4-2-1-3-3-1-1-1\" data-name=\"status dot marker\"></span>Dialog<span data-kid=\"1-4-2-1-3-3-1-1-2\" data-name=\"component variant tag\">confirm</span></div>\n<fieldset class=\"gt-statebar\" data-kid=\"1-4-2-1-3-3-1-2\" data-name=\"state selector radio group\">\n<legend class=\"gt-sr\" data-kid=\"1-4-2-1-3-3-1-2-1\" data-name=\"state selector screen-reader legend\">Dialog component state</legend>\n<input checked=\"\" data-kid=\"1-4-2-1-3-3-1-2-2\" data-name=\"radio input default state\" id=\"facet-default\" name=\"facet-state\" type=\"radio\"/>\n<label data-kid=\"1-4-2-1-3-3-1-2-3\" data-name=\"state label default\" for=\"facet-default\">Default</label>\n<input data-kid=\"1-4-2-1-3-3-1-2-4\" data-name=\"radio input error state\" id=\"facet-error\" name=\"facet-state\" type=\"radio\"/>\n<label data-kid=\"1-4-2-1-3-3-1-2-5\" data-name=\"state label validation error\" for=\"facet-error\">Validation error</label>\n<input data-kid=\"1-4-2-1-3-3-1-2-6\" data-name=\"radio input submitting state\" id=\"facet-submitting\" name=\"facet-state\" type=\"radio\"/>\n<label data-kid=\"1-4-2-1-3-3-1-2-7\" data-name=\"state label submitting\" for=\"facet-submitting\">Submitting</label>\n<input data-kid=\"1-4-2-1-3-3-1-2-8\" data-name=\"radio input success state\" id=\"facet-success\" name=\"facet-state\" type=\"radio\"/>\n<label data-kid=\"1-4-2-1-3-3-1-2-9\" data-name=\"state label success\" for=\"facet-success\">Success</label>\n</fieldset>\n<p aria-live=\"polite\" class=\"gt-sr\" data-dynamic=\"true\" data-kid=\"1-4-2-1-3-3-1-3\" data-name=\"state preview live region\" data-reason=\"text replaced by state change handler\" id=\"facet-state-status\" role=\"status\"></p>\n</div>\n<div class=\"gt-workbench-body\" data-kid=\"1-4-2-1-3-3-2\" data-name=\"workbench body grid\">\n<div aria-hidden=\"true\" class=\"gt-stage\" data-kid=\"1-4-2-1-3-3-2-1\" data-name=\"component preview stage\">\n<div class=\"gt-state gt-state--default\" data-kid=\"1-4-2-1-3-3-2-1-1\" data-name=\"default state preview\">\n<div class=\"gt-dialog\" data-kid=\"1-4-2-1-3-3-2-1-1-1\" data-name=\"preview dialog default\">\n<div class=\"gt-dialog-head\" data-kid=\"1-4-2-1-3-3-2-1-1-1-1\" data-name=\"dialog head default\">\n<h5 data-kid=\"1-4-2-1-3-3-2-1-1-1-1-1\" data-name=\"dialog title default\">Approve release</h5>\n<p data-kid=\"1-4-2-1-3-3-2-1-1-1-1-2\" data-name=\"dialog subtitle default\">checkout-api will roll out to 25% of production traffic.</p>\n</div>\n<div class=\"gt-dialog-field\" data-kid=\"1-4-2-1-3-3-2-1-1-1-2\" data-name=\"dialog field default\">\n<label data-kid=\"1-4-2-1-3-3-2-1-1-1-2-1\" data-name=\"dialog field label default\">Rollout note</label>\n<div class=\"gt-input\" data-kid=\"1-4-2-1-3-3-2-1-1-1-2-2\" data-name=\"dialog input placeholder default\">Add context for the audit trail</div>\n</div>\n<div class=\"gt-dialog-actions\" data-kid=\"1-4-2-1-3-3-2-1-1-1-3\" data-name=\"dialog actions default\">\n