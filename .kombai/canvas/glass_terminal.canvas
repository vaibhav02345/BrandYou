ct article\">\n<div class=\"gt-project-head\" data-kid=\"1-4-2-1-2-1\" data-name=\"project heading row\">\n<h3 data-kid=\"1-4-2-1-2-1-1\" data-name=\"project title\" id=\"switchyard-title\">Switchyard</h3>\n<div class=\"gt-project-meta\" data-kid=\"1-4-2-1-2-1-2\" data-name=\"project meta tags\">\n<span data-kid=\"1-4-2-1-2-1-2-1\" data-name=\"project category tag\">Release infrastructure</span>\n<span data-kid=\"1-4-2-1-2-1-2-2\" data-name=\"project company tag\">Tessellate</span>\n<span data-kid=\"1-4-2-1-2-1-2-3\" data-name=\"project duration tag\">2023–Present</span>\n</div>\n</div>\n<div class=\"gt-artifact-grid\" data-kid=\"1-4-2-1-2-2\" data-name=\"project artifact grid\">\n<figure class=\"gt-glass gt-artifact\" data-kid=\"1-4-2-1-2-2-1\" data-name=\"Switchyard app mockup frame\" style=\"margin:0\">\n<div aria-hidden=\"true\" class=\"gt-artifact-inner\" data-kid=\"1-4-2-1-2-2-1-1\" data-name=\"mockup inner panel\">\n<div class=\"gt-app-bar\" data-kid=\"1-4-2-1-2-2-1-1-1\" data-name=\"mockup app toolbar\">\n<div class=\"gt-app-brand\" data-kid=\"1-4-2-1-2-2-1-1-1-1\" data-name=\"mockup app brand\"><span class=\"gt-glyph\" data-kid=\"1-4-2-1-2-2-1-1-1-1-1\" data-name=\"mockup app glyph\"></span>Switchyard</div>\n<span class=\"gt-app-workspace\" data-kid=\"1-4-2-1-2-2-1-1-1-2\" data-name=\"mockup workspace label\">Tessellate</span>\n<div class=\"gt-app-tabs\" data-kid=\"1-4-2-1-2-2-1-1-1-3\" data-name=\"mockup tab list\">\n<span class=\"gt-app-tab is-active\" data-kid=\"1-4-2-1-2-2-1-1-1-3-1\" data-name=\"active tab Releases\">Releases</span>\n<span class=\"gt-app-tab\" data-kid=\"1-4-2-1-2-2-1-1-1-3-2\">Flags</span>\n<span class=\"gt-app-tab\" data-kid=\"1-4-2-1-2-2-1-1-1-3-3\" data-name=\"tab Environments\">Environments</span>\n<span class=\"gt-app-tab\" data-kid=\"1-4-2-1-2-2-1-1-1-3-4\" data-name=\"tab Audit\">Audit</span>\n</div>\n<span class=\"gt-app-region\" data-kid=\"1-4-2-1-2-2-1-1-1-4\" data-name=\"mockup region indicator\">prod / us-east-1</span>\n</