        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n.midnight {\n  --mc-bg: #0c1118;\n  --mc-surface: #111923;\n  --mc-surface-2: #151f2b;\n  --mc-line: rgba(203, 220, 239, .12);\n  --mc-text: #edf2f7;\n  --mc-muted: #a1afbd;\n  --mc-dim: #738395;\n  --mc-cyan: #80e6dd;\n  --mc-violet: #b1a1ff;\n  --mc-amber: #ffc989;\n  min-height: 100vh;\n  background: var(--mc-bg);\n  color: var(--mc-text);\n  font-family: 'Hanken Grotesk', sans-serif;\n  font-size: 16px;\n  line-height: 1.6;\n  overflow-x: clip;\n}\n.midnight * { box-sizing: border-box; }\n.midnight a { color: inherit; text-decoration: none; }\n.mc-wrap { width: min(1120px, calc(100% - 64px)); margin-inline: auto; }\n.mc-mono { font-family: 'JetBrains Mono', monospace; }\n.mc-header { height: 78px; border-bottom: 1px solid var(--mc-line); display:flex; align-items:center; }\n.mc-nav { display:flex; align-items:center; justify-content:space-between; gap:28px; }\n.mc-brand { display:flex; align-items:center; gap:12px; min-width:max-content; }\n.mc-mark { display:grid; place-items:center; width:34px; height:34px; border:1px solid rgba(128,230,221,.5); border-radius:9px; color:var(--mc-cyan); font-family:'JetBrains Mono',monospace; font-size:12px; font-weight:600; letter-spacing:-.07em; }\n.mc-brand-name { font-family:'Bricolage Grotesque',sans-serif; font-size:15px; font-weight:700; letter-spacing:-.02em; }\n.mc-nav-links { display:flex; align-items:center; gap:31px; color:var(--mc-muted); font-size:13px; }\n.mc-nav-links a:hover, .mc-footer a:hover { color:var(--mc-cyan); }\n.mc-nav-cta { display:inline-flex; align-items:center; gap:8px; border:1px solid var(--mc-line); border-radius:7px; padding:9px 13px; color:var(--mc-text); font-size:13px; font-weight:600; }\n.mc-nav-cta:hover { border-color:rgba(128,230,221,.55); color:var(--mc-cyan); }\n.mc-nav-cta .icon-arrow-up-right { font-size:14px; }\n.mc-hero { padding:92px 0 57px; }\n.mc-hero-inner { display:grid; grid-template-columns:minmax(0,1fr) 260px; align-items:end; gap:80px; }\n.mc-hero h1 { max-width:800px; margin:0; font-family:'Bricolage Grotesque',sans-serif; font-size:clamp(54px,6.1vw,78px); font-weight:600; letter-spacing:-.065em; line-height:.99; }\n.mc-hero h1 span { color:var(--mc-cyan); }\n.mc-hero-copy { max-width:640px; margin:25px 0 0; color:#b3c0ce; font-size:18px; line-height:1.65; }\n.mc-hero-copy strong { color:var(--mc-text); font-weight:600; }\n.mc-hero-actions { display:flex; align-items:center; gap:23px; flex-wrap:wrap; margin-top:30px; }\n.mc-btn-primary { display:inline-flex; align-items:center; justify-content:center; gap:10px; background:var(--mc-cyan); color:#09201f !important; border-radius:6px; padding:12px 16px; font-size:13px; font-weight:700; transition:transform .18s ease, background .18s ease; }\n.mc-btn-primary:hover { background:#a1f1e9; transform:translateY(-2px); }\n.mc-text-link { display:inline-flex; align-items:center; gap:7px; color:#d1dbe5 !important; font-size:13px; font-weight:600; }\n.mc-text-link:hover { color:var(--mc-violet) !important; }\n.mc-text-link .icon-arrow-up-right { font-size:14px; }\n.mc-hero-note { border-left:1px solid rgba(177,161,255,.52); padding:8px 0 8px 18px; color:var(--mc-muted); font-size:13px; line-height:1.6; }\n.mc-hero-note strong { display:block; color:var(--mc-text); font-family:'Bricolage Grotesque',sans-serif; font-size:20px; letter-spacing:-.025em; margin-bottom:4px; }\n.mc-hero-note .mc-mono { display:block; color:var(--mc-violet); font-size:10px; margin-top:8px; }\n.mc-proofline { display:flex; align-items:center; gap:0; margin-top:60px; border-top:1px solid var(--mc-line); border-bottom:1px solid var(--mc-line); padding:17px 0; color:var(--mc-muted); font-size:12px; }\n.mc-proofline div { padding:0 25px; border-right:1px solid var(--mc-line); }\n.mc-proofline div:first-child { padding-left:0; }\n.mc-proofline div:last-child { border:0; }\n.mc-proofline strong { color:var(--mc-text); font-weight:600; }\n.mc-proofline .mc-mono { color:var(--mc-dim); font-size:10px; margin-right:7px; }\n.mc-section { padding:82px 0; border-bottom:1px solid var(--mc-line); }\n.mc-section-head { display:flex; justify-content:space-between; align-items:end; gap:28px; margin-bottom:35px; }\n.mc-section-head h2 { margin:0; font-family:'Bricolage Grotesque',sans-serif; font-size:36px; line-height:1.1; letter-spacing:-.045em; font-weight:600; }\n.mc-section-head p { max-width:430px; margin:0; color:var(--mc-muted); font-size:14px; }\n.mc-project-feature { display:grid; grid-template-columns:minmax(0,1.08fr) minmax(255px,.72fr); gap:72px; align-items:center; padding:32px 0 34px; border-top:1px solid var(--mc-line); border-bottom:1px solid var(--mc-line); }\n.mc-project-title { display:flex; align-items:center; gap:12px; margin-bottom:14px; }\n.mc-project-title h3 { margin:0; font-family:'Bricolage Grotesque',sans-serif; font-size:25px; line-height:1.2; letter-spacing:-.035em; font-weight:600; }\n.mc-project-title .mc-mono { color:var(--mc-violet); font-size:10px; }\n.mc-project-copy h4 { max-width:560px; margin:0 0 12px; font-family:'Bricolage Grotesque',sans-serif; font-size:29px; line-height:1.22; letter-spacing:-.04em; font-weight:500; }\n.mc-project-copy > p { max-width:570px; margin:0; color:var(--mc-muted); font-size:14px; line-height:1.75; }\n.mc-techline { display:flex; flex-wrap:wrap; gap:8px 14px; margin-top:21px; color:#b7c3cf; font-family:'JetBrains Mono',monospace; font-size:10px; }\n.mc-techline span { border-bottom:1px solid rgba(128,230,221,.28); padding-bottom:3px; }\n.mc-project-aside { border-left:1px solid var(--mc-line); padding:11px 0 11px 28px; }\n.mc-project-aside .mc-mono { display:block; color:var(--mc-dim); font-size:10px; letter-spacing:.025em; }\n.mc-outcome { margin:3px 0 6px; color:var(--mc-cyan); font-family:'Bricolage Grotesque',sans-serif; font-size:62px; font-weight:600; line-height:1; letter-spacing:-.065em; }\n.mc-project-aside p { max-width:210px; margin:0; color:var(--mc-muted); font-size:13px; }\n.mc-project-aside .mc-aside-rule { width:38px; height:1px; background:rgba(177,161,255,.6); margin:23px 0 17px; }\n.mc-project-aside .mc-context { color:#ced8e3; font-size:12px; }\n.mc-artifact-list { margin-top:53px; }\n.mc-artifact-row { display:grid; grid-template-columns:minmax(240px,.85fr) minmax(0,1.2fr) 125px; gap:32px; align-items:start; padding:24px 0; border-bottom:1px solid var(--mc-line); }\n.mc-artifact-row:first-child { border-top:1px solid var(--mc-line); }\n.mc-artifact-question { margin:0; font-family:'Bricolage Grotesque',sans-serif; font-size:20px; line-height:1.25; letter-spacing:-.025em; font-weight:500; }\n.mc-artifact-desc { margin:2px 0 0; color:var(--mc-muted); font-size:13px; line-height:1.7; }\n.mc-artifact-name { color:var(--mc-text); font-weight:600; }\n.mc-artifact-result { justify-self:end; text-align:right; color:var(--mc-violet); font-family:'JetBrains Mono',monospace; font-size:10px; line-height:1.6; }\n.mc-inkspace { margin-top:65px; padding-top:29px; border-top:1px solid var(--mc-line); }\n.mc-inkspace-top { display:grid; grid-template-columns:1fr auto; align-items:end; gap:24px; margin-bottom:22px; }\n.mc-inkspace-top h3 { margin:0; font-family:'Bricolage Grotesque',sans-serif; font-weight:600; font-size:25px; letter-spacing:-.035em; }\n.mc-inkspace-top p { margin:7px 0 0; color:var(--mc-muted); font-size:13px; }\n.mc-illustrative-label { display:inline-flex; align-items:center; gap:7px; color:var(--mc-amber); font-family:'JetBrains Mono',monospace; font-size:10px; white-space:nowrap; }\n.mc-illustrative-label:before { content:''; width:6px; height:6px; border-radius:50%; background:var(--mc-amber); }\n.mc-flow-shell { padding:20px 23px 17px; border:1px solid var(--mc-line); border-radius:9px; background:linear-gradient(135deg,rgba(21,31,43,.75),rgba(17,25,35,.28)); }\n.mc-flow-caption { display:flex; justify-content:space-between; gap:20px; margin-bottom:12px; color:var(--mc-dim); font-family:'JetBrains Mono',monospace; font-size:9px; text-transform:uppercase; letter-spacing:.08em; }\n.mc-flow-svg { display:block; width:100%; height:auto; }\n.mc-flow-svg text { font-family:'JetBrains Mono',monospace; }\n.mc-flow-mobile { display:none; }\n.mc-flow-foot { margin:11px 0 0; color:var(--mc-dim); font-size:11px; }\n.mc-open-source { display:grid; grid-template-columns:1fr auto; align-items:center; gap:35px; padding:38px 0; border-bottom:1px solid var(--mc-line); }\n.mc-open-source h3 { margin:0 0 8px; font-family:'Bricolage Grotesque',sans-serif; font-size:23px; font-weight:600; letter-spacing:-.035em; }\n.mc-open-source p { margin:0; color:var(--mc-muted); font-size:14px; max-width:590px; }\n.mc-stars { display:flex; align-items:baseline; gap:10px; color:var(--mc-text); white-space:nowrap; }\n.mc-stars strong { color:var(--mc-violet); font-family:'Bricolage Grotesque',sans-serif; font-size:34px; line-height:1; letter-spacing:-.04em; }\n.mc-stars span { color:var(--mc-muted); font-size:12px; }\n.mc-open-link { grid-column:1/-1; display:inline-flex; align-items:center; gap:7px; width:max-content; color:var(--mc-cyan) !important; font-size:12px; font-weight:600; }\n.mc-open-link .icon-arrow-up-right { font-size:14px; }\n.mc-experience { padding-top:78px; }\n.mc-experience-grid { display:grid; grid-template-columns:.62fr 1.38fr; gap:80px; }\n.mc-exp-intro h2 { margin:0; font-family:'Bricolage Grotesque',sans-serif; font-size:35px; font-weight:600; line-height:1.1; letter-spacing:-.045em; }\n.mc-exp-intro p { max-width:260px; color:var(--mc-muted); font-size:13px; margin:14px 0 0; }\n.mc-timeline { border-top:1px solid var(--mc-line); }\n.mc-role { display:grid; grid-template-columns:130px 1fr; gap:23px; padding:22px 0 23px; border-bottom:1px solid var(--mc-line); }\n.mc-role-date { padding-top:3px; color:var(--mc-dim); font-family:'JetBrains Mono',monospace; font-size:10px; }\n.mc-role h3 { margin:0; font-size:15px; font-weight:600; color:var(--mc-text); }\n.mc-role .mc-company { color:var(--mc-violet); font-weight:500; }\n.mc-role p { margin:7px 0 0; max-width:590px; color:var(--mc-muted); font-size:13px; line-height:1.65; }\n.mc-skills { margin-top:61px; padding:27px 0 0; border-top:1px solid var(--mc-line); }\n.mc-skills h3 { margin:0 0 19px; font-family:'Bricolage Grotesque',sans-serif; font-size:17px; font-weight:600; }\n.mc-skill-row { display:grid; grid-template-columns:130px 1fr; gap:23px; padding:11px 0; border-bottom:1px solid rgba(203,220,239,.08); }\n.mc-skill-row:last-child { border-bottom:0; }\n.mc-skill-row strong { color:#d7e1e9; font-family:'JetBrains Mono',monospace; font-size:10px; font-weight:500; }\n.mc-skill-row span { color:var(--mc-muted); font-size:12px; }\n.mc-contact { padding:69px 0 73px; border-bottom:1px solid var(--mc-line); }\n.mc-contact-inner { display:flex; align-items:center; justify-content:space-between; gap:35px; }\n.mc-contact h2 { max-width:640px; margin:0; font-family:'Bricolage Grotesque',sans-serif; font-size:41px; line-height:1.12; letter-spacing:-.05em; font-weight:600; }\n.mc-contact h2 span { color:var(--mc-cyan); }\n.mc-contact p { margin:11px 0 0; color:var(--mc-muted); font-size:14px; }\n.mc-footer { min-height:76px; display:flex; align-items:center; justify-content:space-between; gap:20px; color:var(--mc-dim); font-size:11px; }\n.mc-footer nav { display:flex; gap:20px; color:var(--mc-muted); }\n.mc-footer nav a { display:flex; align-items:center; gap:5px; }\n.mc-footer .mc-mono { color:var(--mc-dim); font-size:10px; }\n.midnight a:focus-visible { outline:2px solid var(--mc-cyan); outline-offset:4px; border-radius:3px; }\n@media (max-width: 900px) {\n  .mc-wrap { width:min(100% - 48px, 720px); }\n  .mc-hero-inner { grid-template-columns:minmax(0,1fr) 205px; gap:42px; }\n  .mc-project-feature { gap:37px; }\n  .mc-artifact-row { grid-template-columns:minmax(190px,.8fr) minmax(0,1.2fr); }\n  .mc-artifact-result { grid-column:2; justify-self:start; text-align:left; }\n  .mc-experience-grid { gap:45px; }\n}\n@media (max-width: 680px) {\n  .mc-wrap { width:calc(100% - 40px); }\n  .mc-header { height:68px; }\n  .mc-nav { gap:12px; }\n  .mc-nav-links { display:none; }\n  .mc-nav-cta { padding:8px 10px; font-size:12px; }\n  .mc-brand-name { font-size:14px; }\n  .mc-hero { padding:66px 0 31px; }\n  .mc-hero-inner { display:block; }\n  .mc-hero h1 { font-size:clamp(45px,13vw,62px); line-height:1.01; }\n  .mc-hero-copy { margin-top:19px; font-size:16px; }\n  .mc-hero-actions { gap:17px; margin-top:23px; }\n  .mc-hero-note { margin-top:33px; max-width:310px; }\n  .mc-proofline { display:grid; grid-template-columns:1fr 1fr; gap:14px 10px; margin-top:37px; padding:16px 0; }\n  .mc-proofline div { padding:0 9px; border:0; font-size:11px; }\n  .mc-proofline div:first-child { padding-left:0; }\n  .mc-section { padding:59px 0; }\n  .mc-section-head { display:block; margin-bottom:25px; }\n  .mc-section-head h2 { font-size:31px; }\n  .mc-section-head p { margin-top:10px; font-size:13px; }\n  .mc-project-feature { grid-template-columns:1fr; gap:26px; padding:24px 0; }\n  .mc-project-copy h4 { font-size:25px; }\n  .mc-project-aside { border-left:0; border-top:1px solid var(--mc-line); padding:19px 0 0; display:grid; grid-template-columns:auto 1fr; align-items:end; column-gap:17px; }\n  .mc-project-aside .mc-mono { grid-column:1/-1; }\n  .mc-outcome { font-size:48px; grid-row:2; }\n  .mc-project-aside p { max-width:180px; grid-row:2; }\n  .mc-project-aside .mc-aside-rule { display:none; }\n  .mc-project-aside .mc-context { grid-column:1/-1; margin-top:13px; }\n  .mc-artifact-list { margin-top:36px; }\n  .mc-artifact-row { grid-template-columns:1fr; gap:8px; padding:18px 0; }\n  .mc-artifact-question { font-size:19px; }\n  .mc-artifact-result { grid-column:auto; justify-self:start; text-align:left; }\n  .mc-inkspace { margin-top:44px; padding-top:22px; }\n  .mc-inkspace-top { grid-template-columns:1fr; align-items:start; gap:12px; }\n  .mc-inkspace-top h3 { font-size:23px; }\n  .mc-flow-shell { padding:16px 14px 14px; }\n  .mc-flow-caption { font-size:8px; }\n  .mc-flow-svg { display:none; }\n  .mc-flow-mobile { display:grid; gap:0; }\n  .mc-flow-step { display:grid; grid-template-columns:27px 1fr; gap:10px; position:relative; padding:10px 0 12px; }\n  .mc-flow-step:not(:last-child):after { content:''; position:absolute; left:12px; top:36px; bottom:-1px; width:1px; background:rgba(128,230,221,.35); }\n  .mc-flow-step-no { display:grid; place-items:center; width:25px; height:25px; border:1px solid rgba(128,230,221,.4); border-radius:50%; color:var(--mc-cyan); font-family:'JetBrains Mono',monospace; font-size:9px; }\n  .mc-flow-step strong { display:block; font-size:12px; font-weight:600; }\n  .mc-flow-step p { margin:2px 0 0; color:var(--mc-muted); font-family:'JetBrains Mono',monospace; font-size:9px; }\n  .mc-open-source { grid-template-columns:1fr; gap:18px; padding:28px 0; }\n  .mc-open-source h3 { font-size:21px; }\n  .mc-stars { justify-content:flex-start; }\n  .mc-open-link { grid-column:auto; }\n  .mc-experience { padding-top:57px; }\n  .mc-experience-grid { grid-template-columns:1fr; gap:27px; }\n  .mc-exp-intro h2 { font-size:31px; }\n  .mc-exp-intro p { max-width:420px; margin-top:9px; }\n  .mc-role { grid-template-columns:86px 1fr; gap:12px; padding:17px 0; }\n  .mc-role-date { font-size:9px; }\n  .mc-role h3 { font-size:14px; }\n  .mc-role p { font-size:12px; }\n  .mc-skills { margin-top:42px; }\n  .mc-skill-row { grid-template-columns:84px 1fr; gap:12px; }\n  .mc-skill-row span { font-size:11px; line-height:1.7; }\n  .mc-contact { padding:53px 0 54px; }\n  .mc-contact-inner { align-items:flex-start; flex-direction:column; gap:23px; }\n  .mc-contact h2 { font-size:35px; }\n  .mc-footer { padding:19px 0; align-items:flex-start; flex-direction:column; }\n  .mc-footer nav { gap:15px; flex-wrap:wrap; }\n}\n</style>\n<div class=\"midnight\" data-kid=\"1\" data-name=\"midnight theme page container\">\n    <header class=\"mc-header\" data-kid=\"1-1\" data-name=\"page header\">\n        <div class=\"mc-wrap mc-nav\" data-kid=\"1-1-1\" data-name=\"navigation and branding layout\">\n            <a aria-label=\"Marcus Webb, top of page\" class=\"mc-brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name link\" href=\"#top\">\n                <span class=\"mc-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand initials icon\">\n                    MW\n                </span>\n                <span class=\"mc-brand-name\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    Marcus Webb\n                </span>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"mc-nav-links\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n                <a data-kid=\"1-1-1-2-1\" data-name=\"production systems navigation link\" href=\"#work\">\n                    Production systems\n                </a>\n                <a data-kid=\"1-1-1-2-2\" data-name=\"open source navigation link\" href=\"#open-source\">\n                    Open source\n                </a>\n                <a data-kid=\"1-1-1-2-3\" data-name=\"experience navigation link\" href=\"#experience\">\n                    Experience\n                </a>\n            </nav>\n            <a class=\"mc-nav-cta\" data-kid=\"1-1-1-3\" data-name=\"email call-to-action button\" href=\"mailto:marcus@webworks.dev\">\n                Email Marcus\n                <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-1-1-3-1\" data-name=\"arrow-up-right icon\">\n                </i>\n            </a>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section aria-labelledby=\"hero-title\" class=\"mc-wrap mc-hero\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"mc-hero-inner\" data-kid=\"1-2-1-1\" data-name=\"hero internal layout\">\n                <div data-kid=\"1-2-1-1-1\" data-name=\"hero text container\">\n                    <h1 data-kid=\"1-2-1-1-1-1\" data-name=\"hero main headline\" id=\"hero-title\">\n                        Engineering the systems people\n                        <span data-kid=\"1-2-1-1-1-1-1\" data-name=\"hero headline emphasized text\">\n                            depend on.\n                        </span>\n                    </h1>\n                    <p class=\"mc-hero-copy\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero description paragraph\">\n                        <strong data-kid=\"1-2-1-1-1-2-1\" data-name=\"hero job title emphasis\">\n                            Senior Full-Stack Engineer\n                        </strong>\n                        shipping products from interface to infrastructure. I work on the hard parts: payment flows, shared state, and software that has to earn people's trust every day.\n                    </p>\n                    <div class=\"mc-hero-actions\" data-kid=\"1-2-1-1-1-3\" data-name=\"hero action buttons container\">\n                        <a class=\"mc-btn-primary\" data-kid=\"1-2-1-1-1-3-1\" data-name=\"inspect work primary button\" href=\"#work\">\n                            Inspect production work\n                            <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-1-1-1-3-1-1\" data-name=\"arrow-up-right icon\">\n                            </i>\n                        </a>\n                        <a class=\"mc-text-link\" data-kid=\"1-2-1-1-1-3-2\" data-name=\"open-source link\" href=\"https://github.com/marcuswebb\" rel=\"noreferrer\" target=\"_blank\">\n                            Open-source profile\n                            <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-1-1-1-3-2-1\" data-name=\"arrow-up-right icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <aside class=\"mc-hero-note\" data-kid=\"1-2-1-1-2\" data-name=\"hero info aside note\">\n                    <strong data-kid=\"1-2-1-1-2-1\" data-name=\"hero note title\">\n                        Full-stack systems, built to scale.\n                    </strong>\n                    Based in San Francisco, CA. Focused on thoughtful architecture, clear trade-offs, and outcomes you can measure.\n                    <span class=\"mc-mono\" data-kid=\"1-2-1-1-2-2\" data-name=\"tech stack mono text\">\n                        React / Node / Postgres / AWS\n                    </span>\n                </aside>\n            </div>\n            <div aria-label=\"Selected context\" class=\"mc-proofline\" data-kid=\"1-2-1-2\" data-name=\"hero context proof line\">\n                <div data-kid=\"1-2-1-2-1\" data-name=\"role proof item\">\n                    <span class=\"mc-mono\" data-kid=\"1-2-1-2-1-1\" data-name=\"role proof label\">\n                        ROLE\n                    </span>\n                    <strong data-kid=\"1-2-1-2-1-2\" data-name=\"role proof value\">\n                        Senior Full-Stack Engineer\n                    </strong>\n                </div>\n                <div data-kid=\"1-2-1-2-2\" data-name=\"base proof item\">\n                    <span class=\"mc-mono\" data-kid=\"1-2-1-2-2-1\" data-name=\"base proof label\">\n                        BASE\n                    </span>\n                    <strong data-kid=\"1-2-1-2-2-2\" data-name=\"base proof value\">\n                        San Francisco, CA\n                    </strong>\n                </div>\n                <div data-kid=\"1-2-1-2-3\" data-name=\"focus proof item\">\n                    <span class=\"mc-mono\" data-kid=\"1-2-1-2-3-1\" data-name=\"focus proof label\">\n                        FOCUS\n                    </span>\n                    <strong data-kid=\"1-2-1-2-3-2\" data-name=\"focus proof value\">\n                        Production systems\n                    </strong>\n                </div>\n                <div data-kid=\"1-2-1-2-4\" data-name=\"contact proof item\">\n                    <span class=\"mc-mono\" data-kid=\"1-2-1-2-4-1\" data-name=\"contact proof label\">\n                        CONTACT\n                    </span>\n                    <strong data-kid=\"1-2-1-2-4-2\" data-name=\"contact proof value\">\n                        marcus@webworks.dev\n                    </strong>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"systems-title\" class=\"mc-wrap mc-section\" data-kid=\"1-2-2\" data-name=\"production systems section\" id=\"work\">\n            <div class=\"mc-section-head\" data-kid=\"1-2-2-1\" data-name=\"section header container\">\n                <h2 data-kid=\"1-2-2-1-1\" data-name=\"systems section title\" id=\"systems-title\">\n                    Production systems\n                </h2>\n                <p data-kid=\"1-2-2-1-2\" data-name=\"systems section description\">\n                    Not just what shipped. The questions behind the work, the choices made, and the scale it reached.\n                </p>\n            </div>\n            <article class=\"mc-project-feature\" data-kid=\"1-2-2-2\" data-name=\"project feature article\">\n                <div class=\"mc-project-copy\" data-kid=\"1-2-2-2-1\" data-name=\"project text details container\">\n                    <div class=\"mc-project-title\" data-kid=\"1-2-2-2-1-1\" data-name=\"project title header container\">\n                        <h3 data-kid=\"1-2-2-2-1-1-1\" data-name=\"project name\">\n                            PayFlow\n                        </h3>\n                        <span class=\"mc-mono\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"project category tag\">\n                            payments / fraud detection\n                        </span>\n                    </div>\n                    <h4 data-kid=\"1-2-2-2-1-2\" data-name=\"project research question\">\n                        What does real-time payment visibility look like at production scale?\n                    </h4>\n                    <p data-kid=\"1-2-2-2-1-3\" data-name=\"project description\">\n                        A real-time payment dashboard with machine-learning fraud detection. Built for teams watching live transactions and risk signals across a high-volume payment system.\n                    </p>\n                    <div aria-label=\"Technology used\" class=\"mc-techline\" data-kid=\"1-2-2-2-1-4\" data-name=\"tech stack list container\">\n                        <span data-kid=\"1-2-2-2-1-4-1\" data-name=\"tech stack item\">\n                            Next.js\n                        </span>\n                        <span data-kid=\"1-2-2-2-1-4-2\" data-name=\"tech stack item\">\n                            Go\n                        </span>\n                        <span data-kid=\"1-2-2-2-1-4-3\" data-name=\"tech stack item\">\n                            Redis\n                        </span>\n                        <span data-kid=\"1-2-2-2-1-4-4\" data-name=\"tech stack item\">\n                            Stripe\n                        </span>\n                    </div>\n                </div>\n                <aside aria-label=\"PayFlow project outcome\" class=\"mc-project-aside\" data-kid=\"1-2-2-2-2\" data-name=\"project outcome aside\">\n                    <span class=\"mc-mono\" data-kid=\"1-2-2-2-2-1\" data-name=\"outcome scale label\">\n                        PROJECT SCALE\n                    </span>\n                    <div class=\"mc-outcome\" data-kid=\"1-2-2-2-2-2\" data-name=\"project outcome metric\">\n                        $2M+\n                    </div>\n                    <p data-kid=\"1-2-2-2-2-3\" data-name=\"project outcome description\">\n                        processed daily through the payment system\n                    </p>\n                    <div class=\"mc-aside-rule\" data-kid=\"1-2-2-2-2-4\" data-name=\"aside decorative rule\">\n                    </div>\n                    <span class=\"mc-context\" data-kid=\"1-2-2-2-2-5\" data-name=\"aside project context\">\n                        A system built for throughput and fast fraud review.\n                    </span>\n                </aside>\n            </article>\n            <div aria-label=\"More production systems\" class=\"mc-artifact-list\" data-kid=\"1-2-2-3\" data-name=\"additional production systems list\">\n                <article class=\"mc-artifact-row\" data-kid=\"1-2-2-3-1\" data-name=\"artifact article row\">\n                    <h3 class=\"mc-artifact-question\" data-kid=\"1-2-2-3-1-1\" data-name=\"artifact research question\">\n                        How do you turn a new platform into a product people use?\n                    </h3>\n                    <p class=\"mc-artifact-desc\" data-kid=\"1-2-2-3-1-2\" data-name=\"artifact description paragraph\">\n                        <span class=\"mc-artifact-name\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"artifact project name\">\n                            NovaBuild\n                        </span>\n                        — an AI-assisted, no-code app platform. The product reached 10k+ users and $500K ARR.\n                    </p>\n                    <span class=\"mc-artifact-result\" data-kid=\"1-2-2-3-1-3\" data-name=\"artifact outcome metric\">\n                        10k+ users\n                        <br data-kid=\"1-2-2-3-1-3-1\" data-name=\"metric line break\"/>\n                        $500K ARR\n                    </span>\n                </article>\n            </div>\n            <article aria-labelledby=\"inkspace-title\" class=\"mc-inkspace\" data-kid=\"1-2-2-4\" data-name=\"inkspace section article\">\n                <div class=\"mc-inkspace-top\" data-kid=\"1-2-2-4-1\" data-name=\"inkspace header container\">\n                    <div data-kid=\"1-2-2-4-1-1\" data-name=\"inkspace title container\">\n                        <h3 data-kid=\"1-2-2-4-1-1-1\" data-name=\"inkspace title\" id=\"inkspace-title\">\n                            How does a shared canvas stay in sync?\n                        </h3>\n                        <p data-kid=\"1-2-2-4-1-1-2\" data-name=\"inkspace metadata summary\">\n                            <strong data-kid=\"1-2-2-4-1-1-2-1\" data-name=\"inkspace project name\" style=\"color:var(--mc-text);font-weight:600\">\n                                InkSpace\n                            </strong>\n                            · collaborative design tool · 500+ daily active teams · acquired by DesignCo\n                        </p>\n                    </div>\n                    <span class=\"mc-illustrative-label\" data-kid=\"1-2-2-4-1-2\" data-name=\"illustrative flow label\">\n                        Illustrative flow\n                    </span>\n                </div>\n                <div class=\"mc-flow-shell\" data-kid=\"1-2-2-4-2\" data-name=\"collaboration flow diagram shell\">\n                    <div class=\"mc-flow-caption\" data-kid=\"1-2-2-4-2-1\" data-name=\"collaboration diagram caption\">\n                        <span data-kid=\"1-2-2-4-2-1-1\" data-name=\"diagram caption title\">\n                            Collaboration sequence\n                        </span>\n                        <span data-kid=\"1-2-2-4-2-1-2\" data-name=\"diagram caption subtitle\">\n                            Conceptual — verify implementation details\n                        </span>\n                    </div>\n                    <svg aria-labelledby=\"inkspace-flow-title inkspace-flow-desc\" class=\"mc-flow-svg\" data-kid=\"1-2-2-4-2-2\" data-name=\"collaboration sequence diagram\" role=\"img\" viewbox=\"0 0 940 224\">\n                        <title id=\"inkspace-flow-title\">\n                            Illustrative InkSpace collaboration sequence\n                        </title>\n                        <desc id=\"inkspace-flow-desc\">\n                            An editor sends a change event to a sync service. The service delivers an update to a receiving client, which applies the change and acknowledges it.\n                        </desc>\n                        <defs>\n                            <marker id=\"mc-arrow\" markerheight=\"8\" markerwidth=\"8\" orient=\"auto\" refx=\"7\" refy=\"4\">\n                                <path d=\"M0,0 L8,4 L0,8 Z\" fill=\"#80e6dd\">\n                                </path>\n                            </marker>\n                            <marker id=\"mc-arrow-back\" markerheight=\"8\" markerwidth=\"8\" orient=\"auto\" refx=\"7\" refy=\"4\">\n                                <path d=\"M0,0 L8,4 L0,8 Z\" fill=\"#b1a1ff\">\n                                </path>\n                            </marker>\n                        </defs>\n                        <rect fill=\"#17232e\" height=\"39\" rx=\"6\" stroke=\"rgba(128,230,221,.42)\" width=\"204\" x=\"36\" y=\"15\">\n                        </rect>\n                        <rect fill=\"#17232e\" height=\"39\" rx=\"6\" stroke=\"rgba(177,161,255,.42)\" width=\"204\" x=\"368\" y=\"15\">\n                        </rect>\n                        <rect fill=\"#17232e\" height=\"39\" rx=\"6\" stroke=\"rgba(128,230,221,.42)\" width=\"204\" x=\"700\" y=\"15\">\n                        </rect>\n                        <text fill=\"#edf2f7\" font-size=\"12\" text-anchor=\"middle\" x=\"138\" y=\"40\">\n                            Editing client\n                        </text>\n                        <text fill=\"#edf2f7\" font-size=\"12\" text-anchor=\"middle\" x=\"470\" y=\"40\">\n                            Sync service\n                        </text>\n                        <text fill=\"#edf2f7\" font-size=\"12\" text-anchor=\"middle\" x=\"802\" y=\"40\">\n                            Receiving client\n                        </text>\n                        <line stroke=\"rgba(203,220,239,.20)\" stroke-dasharray=\"4 5\" x1=\"138\" x2=\"138\" y1=\"55\" y2=\"213\">\n                        </line>\n                        <line stroke=\"rgba(203,220,239,.20)\" stroke-dasharray=\"4 5\" x1=\"470\" x2=\"470\" y1=\"55\" y2=\"213\">\n                        </line>\n                        <line stroke=\"rgba(203,220,239,.20)\" stroke-dasharray=\"4 5\" x1=\"802\" x2=\"802\" y1=\"55\" y2=\"213\">\n                        </line>\n                        <line marker-end=\"url(#mc-arrow)\" stroke=\"#80e6dd\" stroke-width=\"1.5\" x1=\"149\" x2=\"458\" y1=\"91\" y2=\"91\">\n                        </line>\n                        <text fill=\"#aebdca\" font-size=\"10\" text-anchor=\"middle\" x=\"303\" y=\"81\">\n                            change event\n                        </text>\n                        <line marker-end=\"url(#mc-arrow-back)\" stroke=\"#b1a1ff\" stroke-width=\"1.5\" x1=\"481\" x2=\"790\" y1=\"139\" y2=\"139\">\n                        </line>\n                        <text fill=\"#aebdca\" font-size=\"10\" text-anchor=\"middle\" x=\"635\" y=\"129\">\n                            deliver update\n                        </text>\n                        <line marker-end=\"url(#mc-arrow)\" stroke=\"#80e6dd\" stroke-width=\"1.5\" x1=\"791\" x2=\"482\" y1=\"187\" y2=\"187\">\n                        </line>\n                        <text fill=\"#aebdca\" font-size=\"10\" text-anchor=\"middle\" x=\"635\" y=\"177\">\n                            acknowledge applied change\n                        </text>\n                    </svg>\n                    <div aria-label=\"Illustrative collaboration sequence\" class=\"mc-flow-mobile\" data-kid=\"1-2-2-4-2-3\" data-name=\"collaboration flow mobile layout\">\n                        <div class=\"mc-flow-step\" data-kid=\"1-2-2-4-2-3-1\" data-name=\"collaboration step 1\">\n                            <span class=\"mc-flow-step-no\" data-kid=\"1-2-2-4-2-3-1-1\" data-name=\"step 1 number\">\n                                1\n                            </span>\n                            <div data-kid=\"1-2-2-4-2-3-1-2\" data-name=\"step 1 details\">\n                                <strong data-kid=\"1-2-2-4-2-3-1-2-1\" data-name=\"step 1 title\">\n                                    Editing client sends a change\n                                </strong>\n                                <p data-kid=\"1-2-2-4-2-3-1-2-2\" data-name=\"step 1 description\">\n                                    change event → sync service\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mc-flow-step\" data-kid=\"1-2-2-4-2-3-2\" data-name=\"collaboration step 2\">\n                            <span class=\"mc-flow-step-no\" data-kid=\"1-2-2-4-2-3-2-1\" data-name=\"step 2 number\">\n                                2\n                            </span>\n                            <div data-kid=\"1-2-2-4-2-3-2-2\" data-name=\"step 2 details\">\n                                <strong data-kid=\"1-2-2-4-2-3-2-2-1\" data-name=\"step 2 title\">\n                                    Sync service delivers the update\n                                </strong>\n                                <p data-kid=\"1-2-2-4-2-3-2-2-2\" data-name=\"step 2 description\">\n                                    sync service → receiving client\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mc-flow-step\" data-kid=\"1-2-2-4-2-3-3\" data-name=\"collaboration step 3\">\n                            <span class=\"mc-flow-step-no\" data-kid=\"1-2-2-4-2-3-3-1\" data-name=\"step 3 number\">\n                                3\n                            </span>\n                            <div data-kid=\"1-2-2-4-2-3-3-2\" data-name=\"step 3 details\">\n                                <strong data-kid=\"1-2-2-4-2-3-3-2-1\" data-name=\"step 3 title\">\n                                    Receiving client applies and acknowledges\n                                </strong>\n                                <p data-kid=\"1-2-2-4-2-3-3-2-2\" data-name=\"step 3 description\">\n                                    receiving client → sync service\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mc-flow-foot\" data-kid=\"1-2-2-4-2-4\" data-name=\"collaboration sequence warning footer\">\n                        Conceptual sequence diagram only; confirm the event path against the shipped system before publishing.\n                    </p>\n                </div>\n            </article>\n        </section>\n        <section aria-labelledby=\"opensource-title\" class=\"mc-wrap\" data-kid=\"1-2-3\" data-name=\"open source section\" id=\"open-source\">\n            <div class=\"mc-open-source\" data-kid=\"1-2-3-1\" data-name=\"open source details container\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"open source text content\">\n                    <h3 data-kid=\"1-2-3-1-1-1\" data-name=\"open source section title\" id=\"opensource-title\">\n                        Open-source contributions\n                    </h3>\n                    <p data-kid=\"1-2-3-1-1-2\" data-name=\"open source description\">\n                        Public code is part of the work. Explore Marcus’s GitHub profile for the repositories, contributions, and discussion behind it.\n                    </p>\n                </div>\n                <div class=\"mc-stars\" data-kid=\"1-2-3-1-2\" data-name=\"github stats container\">\n                    <strong data-kid=\"1-2-3-1-2-1\" data-name=\"github stars count\">\n                        2.4k\n                    </strong>\n                    <span data-kid=\"1-2-3-1-2-2\" data-name=\"github stats label\">\n                        GitHub stars\n                        <br data-kid=\"1-2-3-1-2-2-1\" data-name=\"stats label break\"/>\n                        across open-source work\n                    </span>\n                </div>\n                <a class=\"mc-open-link\" data-kid=\"1-2-3-1-3\" data-name=\"github profile link\" href=\"https://github.com/marcuswebb\" rel=\"noreferrer\" target=\"_blank\">\n                    <i aria-hidden=\"true\" class=\"icon-git-pull-request\" data-kid=\"1-2-3-1-3-1\" data-name=\"git pull request icon\">\n                    </i>\n                    Browse contributions on GitHub\n                    <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-3-1-3-2\" data-name=\"arrow-up-right icon\">\n                    </i>\n                </a>\n            </div>\n        </section>\n        <section aria-labelledby=\"experience-title\" class=\"mc-wrap mc-experience\" data-kid=\"1-2-4\" data-name=\"career experience section\" id=\"experience\">\n            <div class=\"mc-experience-grid\" data-kid=\"1-2-4-1\" data-name=\"experience grid container\">\n                <div class=\"mc-exp-intro\" data-kid=\"1-2-4-1-1\" data-name=\"experience intro container\">\n                    <h2 data-kid=\"1-2-4-1-1-1\" data-name=\"experience section title\" id=\"experience-title\">\n                        Career, with the work attached.\n                    </h2>\n                    <p data-kid=\"1-2-4-1-1-2\" data-name=\"experience description\">\n                        Experience is clearest when it points to the systems and teams it helped move forward.\n                    </p>\n                </div>\n                <div class=\"mc-timeline\" data-kid=\"1-2-4-1-2\" data-name=\"experience timeline\">\n                    <article class=\"mc-role\" data-kid=\"1-2-4-1-2-1\" data-name=\"current role entry\">\n                        <time class=\"mc-role-date\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"current role date\">\n                            2022 — Present\n                        </time>\n                        <div data-kid=\"1-2-4-1-2-1-2\" data-name=\"current role details\">\n                            <h3 data-kid=\"1-2-4-1-2-1-2-1\" data-name=\"current role title\">\n                                Senior Full-Stack Engineer\n                                <span class=\"mc-company\" data-kid=\"1-2-4-1-2-1-2-1-1\" data-name=\"current company name\">\n                                    · TechCorp Inc.\n                                </span>\n                            </h3>\n                            <p data-kid=\"1-2-4-1-2-1-2-2\" data-name=\"current role description\">\n                                Led a team of 8 building core payment infrastructure serving 1M+ users.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"mc-role\" data-kid=\"1-2-4-1-2-2\" data-name=\"previous role entry\">\n                        <time class=\"mc-role-date\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"previous role date\">\n                            2020 — 2022\n                        </time>\n                        <div data-kid=\"1-2-4-1-2-2-2\" data-name=\"previous role details\">\n                            <h3 data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"previous role title\">\n                                Frontend Engineer\n                                <span class=\"mc-company\" data-kid=\"1-2-4-1-2-2-2-1-1\" data-name=\"previous company name\">\n                                    · StartupXYZ\n                                </span>\n                            </h3>\n                            <p data-kid=\"1-2-4-1-2-2-2-2\" data-name=\"previous role description\">\n                                Built the frontend from scratch and helped scale the product to 100K users in six months.\n                            </p>\n                        </div>\n                    </article>\n                    <div aria-labelledby=\"skills-title\" class=\"mc-skills\" data-kid=\"1-2-4-1-2-3\" data-name=\"technical toolkit section\">\n                        <h3 data-kid=\"1-2-4-1-2-3-1\" data-name=\"toolkit section title\" id=\"skills-title\">\n                            Technical toolkit\n                        </h3>\n                        <div class=\"mc-skill-row\" data-kid=\"1-2-4-1-2-3-2\" data-name=\"frontend skills row\">\n                            <strong data-kid=\"1-2-4-1-2-3-2-1\" data-name=\"frontend skills label\">\n                                Frontend\n                            </strong>\n                            <span data-kid=\"1-2-4-1-2-3-2-2\" data-name=\"frontend skills list\">\n                                React · TypeScript · Next.js · Tailwind · Framer Motion\n                            </span>\n                        </div>\n                        <div class=\"mc-skill-row\" data-kid=\"1-2-4-1-2-3-3\" data-name=\"backend skills row\">\n                            <strong data-kid=\"1-2-4-1-2-3-3-1\" data-name=\"backend skills label\">\n                                Backend\n                            </strong>\n                            <span data-kid=\"1-2-4-1-2-3-3-2\" data-name=\"backend skills list\">\n                                Node.js · Python · Rust · PostgreSQL · Redis\n                            </span>\n                        </div>\n                        <div class=\"mc-skill-row\" data-kid=\"1-2-4-1-2-3-4\" data-name=\"platform skills row\">\n                            <strong data-kid=\"1-2-4-1-2-3-4-1\" data-name=\"platform skills label\">\n                                Platform\n                            </strong>\n                            <span data-kid=\"1-2-4-1-2-3-4-2\" data-name=\"platform skills list\">\n                                AWS · Docker · Kubernetes · CI/CD · Terraform\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"contact-title\" class=\"mc-wrap mc-contact\" data-kid=\"1-2-5\" data-name=\"contact section\" id=\"contact\">\n            <div class=\"mc-contact-inner\" data-kid=\"1-2-5-1\" data-name=\"contact inner layout\">\n                <div data-kid=\"1-2-5-1-1\" data-name=\"contact header text container\">\n                    <h2 data-kid=\"1-2-5-1-1-1\" data-name=\"contact section title\" id=\"contact-title\">\n                        Have a system worth\n                        <span data-kid=\"1-2-5-1-1-1-1\" data-name=\"contact title emphasized text\">\n                            getting right?\n                        </span>\n                    </h2>\n                    <p data-kid=\"1-2-5-1-1-2\" data-name=\"contact description\">\n                        For engineering leadership, collaboration, or a thoughtful technical conversation.\n                    </p>\n                </div>\n                <a class=\"mc-btn-primary\" data-kid=\"1-2-5-1-2\" data-name=\"contact email call-to-action\" href=\"mailto:marcus@webworks.dev\">\n                    Email Marcus\n                    <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-5-1-2-1\" data-name=\"arrow-up-right icon\">\n                    </i>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"mc-wrap mc-footer\" data-kid=\"1-3\" data-name=\"footer section\">\n        <span data-kid=\"1-3-1\" data-name=\"copyright notice\">\n            © Marcus Webb · Senior Full-Stack Engineer\n        </span>\n        <nav aria-label=\"Social links\" data-kid=\"1-3-2\" data-name=\"footer social navigation\">\n            <a data-kid=\"1-3-2-1\" data-name=\"github footer link\" href=\"https://github.com/marcuswebb\" rel=\"noreferrer\" target=\"_blank\">\n                GitHub\n                <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-3-2-1-1\" data-name=\"arrow-up-right icon\">\n                </i>\n            </a>\n            <a data-kid=\"1-3-2-2\" data-name=\"linkedin footer link\" href=\"https://www.linkedin.com/in/marcus-webb\" rel=\"noreferrer\" target=\"_blank\">\n                LinkedIn\n                <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-3-2-2-1\" data-name=\"arrow-up-right icon\">\n                </i>\n            </a>\n            <a data-kid=\"1-3-2-3\" data-name=\"email footer link\" href=\"mailto:marcus@webworks.dev\">\n                Email\n            </a>\n        </nav>\n        <span class=\"mc-mono\" data-kid=\"1-3-3\" data-name=\"footer domain name text\">\n            webworks.dev\n        </span>\n    </footer>\n</div>\n",
      "comments": [],
