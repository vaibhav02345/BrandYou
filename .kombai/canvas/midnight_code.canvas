      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.mc-page{--bg:#090d12;--panel:#0e141c;--panel-2:#111923;--line:rgba(196,211,226,.13);--line-strong:rgba(196,211,226,.23);--ink:#eef3f8;--body:#b7c2ce;--muted:#7f8d9b;--cyan:#62d7d2;--violet:#a894ff;min-height:100vh;background:radial-gradient(ellipse at 80% 3%,rgba(35,91,110,.15),transparent 31rem),var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif;line-height:1.65;overflow-x:clip}\n.mc-page *{box-sizing:border-box}.mc-page a{color:inherit;text-decoration:none}.mc-shell{width:min(1160px,calc(100% - 64px));margin-inline:auto}.mc-header{height:82px;border-bottom:1px solid var(--line);display:flex;align-items:center}.mc-header-inner{display:flex;align-items:center;justify-content:space-between;gap:28px}.mc-brand{display:flex;align-items:center;gap:12px;min-width:240px}.mc-monogram{width:36px;height:36px;border:1px solid var(--line-strong);border-radius:9px;display:grid;place-items:center;color:var(--cyan);font:600 12px 'IBM Plex Mono',monospace;letter-spacing:-.08em;background:rgba(255,255,255,.025)}.mc-brand-name{font:600 13px 'Space Grotesk',sans-serif;letter-spacing:.01em}.mc-brand-role{display:block;color:var(--muted);font:11px 'IBM Plex Mono',monospace;margin-top:1px}.mc-nav{display:flex;align-items:center;gap:30px;color:#aeb9c6;font-size:12px}.mc-nav a{transition:color .2s}.mc-nav a:hover{color:var(--cyan)}.mc-nav-cta{color:var(--ink)!important;border:1px solid var(--line-strong);border-radius:6px;padding:9px 13px}.mc-nav-cta:hover{border-color:var(--cyan);color:var(--cyan)!important}.mc-main{padding-bottom:88px}.mc-hero{padding:91px 0 74px;display:grid;grid-template-columns:minmax(0,1.14fr) minmax(300px,.72fr);gap:90px;align-items:center}.mc-hero-intro{max-width:680px}.mc-roleline{display:flex;align-items:center;gap:11px;color:var(--cyan);font:500 11px 'IBM Plex Mono',monospace;letter-spacing:.08em;text-transform:uppercase;margin-bottom:22px}.mc-roleline:before{content:'';height:1px;width:25px;background:var(--cyan)}.mc-h1{font:600 clamp(48px,5.7vw,76px)/1.01 'Space Grotesk',sans-serif;letter-spacing:-.065em;margin:0;max-width:700px}.mc-h1 em{font-style:normal;color:#8fd8e2}.mc-hero-copy{color:#aebac6;font-size:16px;line-height:1.8;max-width:570px;margin:25px 0 25px}.mc-hero-copy strong{color:var(--ink);font-weight:600}.mc-location{display:flex;align-items:center;gap:8px;color:var(--muted);font:11px 'IBM Plex Mono',monospace;margin:0 0 28px}.mc-location .icon-map-pin{font-size:14px;color:var(--cyan)}.mc-actions{display:flex;align-items:center;gap:21px;flex-wrap:wrap}.mc-primary-link{display:inline-flex;align-items:center;gap:10px;color:#071014!important;background:var(--cyan);padding:12px 15px;border-radius:5px;font-weight:700;font-size:12px}.mc-primary-link:hover{background:#86e7e2}.mc-text-link{display:inline-flex;align-items:center;gap:7px;color:#d1dae3!important;font-size:12px}.mc-text-link .icon-arrow-up-right{font-size:14px;color:var(--cyan)}.mc-evidence{border-left:1px solid var(--line-strong);padding-left:31px}.mc-evidence-title{font:500 10px 'IBM Plex Mono',monospace;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin:0 0 12px}.mc-proof-row{display:grid;grid-template-columns:92px 1fr;gap:15px;align-items:start;padding:18px 0;border-bottom:1px solid var(--line)}.mc-proof-row:last-child{border-bottom:0}.mc-proof-num{font:500 31px/.95 'Space Grotesk',sans-serif;letter-spacing:-.06em;color:var(--ink)}.mc-proof-copy{font-size:12px;color:#c8d1db;line-height:1.45}.mc-proof-copy small{display:block;color:var(--muted);font:10px/1.5 'IBM Plex Mono',monospace;margin-top:5px}.mc-divider{border-top:1px solid var(--line)}.mc-section{padding:72px 0}.mc-section-head{display:flex;justify-content:space-between;align-items:end;gap:26px;margin-bottom:29px}.mc-section-title{font:500 29px/1.1 'Space Grotesk',sans-serif;letter-spacing:-.045em;margin:0}.mc-section-sub{color:var(--muted);font-size:12px;margin:8px 0 0;max-width:520px}.mc-project{border:1px solid var(--line-strong);border-radius:10px;background:linear-gradient(125deg,rgba(17,25,35,.95),rgba(12,18,25,.93));overflow:hidden}.mc-project-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding:28px 31px 25px;border-bottom:1px solid var(--line)}.mc-project-title{font:600 23px/1.2 'Space Grotesk',sans-serif;letter-spacing:-.035em;margin:0}.mc-project-kind{font:10px 'IBM Plex Mono',monospace;color:var(--cyan);margin-top:6px}.mc-project-summary{font-size:13px;color:var(--body);margin:12px 0 0;max-width:670px;line-height:1.7}.mc-project-link{white-space:nowrap;display:inline-flex;align-items:center;gap:8px;color:var(--cyan)!important;font:11px 'IBM Plex Mono',monospace;margin-top:4px}.mc-project-link .icon-arrow-up-right{font-size:14px}.mc-diagram-wrap{padding:30px 31px 21px}.mc-diagram-label{display:flex;align-items:center;justify-content:space-between;color:#a6b4c2;font:10px 'IBM Plex Mono',monospace;letter-spacing:.08em;text-transform:uppercase;margin-bottom:19px}.mc-diagram-label span:last-child{color:var(--muted);letter-spacing:0;text-transform:none}.mc-flow{display:grid;grid-template-columns:1fr 31px 1fr 31px 1fr 31px 1fr;align-items:stretch}.mc-node{min-height:111px;padding:16px 14px;border:1px solid var(--line-strong);border-radius:6px;background:rgba(6,11,16,.35);display:flex;flex-direction:column;justify-content:space-between}.mc-node-type{font:10px 'IBM Plex Mono',monospace;color:var(--muted)}.mc-node-name{font:600 14px 'Space Grotesk',sans-serif;color:var(--ink);margin-top:13px}.mc-node-detail{font:10px 'IBM Plex Mono',monospace;color:#8da0b0;margin-top:2px}.mc-node--focus{border-color:rgba(98,215,210,.48);background:rgba(32,95,101,.11)}.mc-node--focus .mc-node-name{color:#9ce9e5}.mc-node--risk{border-color:rgba(168,148,255,.4);background:rgba(100,76,154,.09)}.mc-node--risk .mc-node-name{color:#c1b5ff}.mc-flow-arrow{display:grid;place-items:center;color:var(--muted);font:16px 'IBM Plex Mono',monospace}.mc-flow-note{margin:13px 0 0;color:#718090;font:10px/1.55 'IBM Plex Mono',monospace}.mc-project-bottom{display:grid;grid-template-columns:1.15fr .85fr;border-top:1px solid var(--line)}.mc-project-fact{padding:21px 30px;border-right:1px solid var(--line)}.mc-project-fact:last-child{border-right:0}.mc-fact-label{display:block;color:var(--muted);font:10px 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px}.mc-fact-value{font:600 20px 'Space Grotesk',sans-serif;letter-spacing:-.03em}.mc-fact-value small{font:12px 'DM Sans',sans-serif;color:var(--body);letter-spacing:0;margin-left:5px}.mc-tech-inline{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}.mc-tech-inline span{font:10px 'IBM Plex Mono',monospace;color:#b1bdc9;border:1px solid var(--line);padding:4px 7px;border-radius:3px}.mc-work-list{border-top:1px solid var(--line);margin-top:33px}.mc-work-row{display:grid;grid-template-columns:170px minmax(0,1fr) 180px;gap:23px;align-items:center;padding:20px 3px;border-bottom:1px solid var(--line)}.mc-work-name{font:600 15px 'Space Grotesk',sans-serif}.mc-work-type{display:block;color:var(--muted);font:10px 'IBM Plex Mono',monospace;margin-top:4px}.mc-work-desc{color:#acb8c4;font-size:12px;line-height:1.6}.mc-work-outcome{text-align:right;color:#d5e0e9;font:11px/1.5 'IBM Plex Mono',monospace}.mc-work-outcome small{display:block;color:var(--muted);font-size:9px}.mc-experience{display:grid;grid-template-columns:245px 1fr;gap:64px}.mc-exp-intro p{font-size:13px;color:var(--body);line-height:1.7;margin:12px 0 0}.mc-exp-list{border-top:1px solid var(--line-strong)}.mc-exp-item{display:grid;grid-template-columns:145px 1fr;gap:22px;padding:21px 0;border-bottom:1px solid var(--line)}.mc-exp-date{font:10px 'IBM Plex Mono',monospace;color:var(--muted);padding-top:4px}.mc-exp-role{font:600 15px 'Space Grotesk',sans-serif}.mc-exp-company{color:#9ba9b6;font-size:12px;margin-top:2px}.mc-exp-desc{font-size:12px;color:var(--body);line-height:1.65;margin:8px 0 0;max-width:680px}.mc-skills-section{padding-top:27px}.mc-skill-group{display:grid;grid-template-columns:180px 1fr;gap:22px;padding:14px 0;border-bottom:1px solid var(--line)}.mc-skill-group:first-child{border-top:1px solid var(--line-strong)}.mc-skill-label{font:10px 'IBM Plex Mono',monospace;color:var(--muted);padding-top:4px}.mc-skill-values{color:#d5dee7;font-size:13px;line-height:1.7}.mc-os-section{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center;padding:28px 0;border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong)}.mc-os-title{font:500 27px 'Space Grotesk',sans-serif;letter-spacing:-.04em;margin:0}.mc-os-copy{color:var(--body);font-size:12px;max-width:590px;margin:9px 0 0;line-height:1.7}.mc-os-proof{display:flex;align-items:baseline;gap:12px;margin-top:13px}.mc-os-count{font:600 22px 'Space Grotesk',sans-serif;color:var(--ink)}.mc-os-label{font:10px 'IBM Plex Mono',monospace;color:var(--muted)}.mc-os-link{display:inline-flex;align-items:center;gap:9px;border:1px solid var(--line-strong);border-radius:5px;padding:11px 13px;font-size:11px;color:var(--ink)!important;white-space:nowrap}.mc-os-link:hover{color:var(--cyan)!important;border-color:var(--cyan)}.mc-os-link i{color:var(--cyan);font-size:14px}.mc-contact{padding:63px 0 40px;display:flex;justify-content:space-between;align-items:end;gap:24px}.mc-contact h2{font:500 35px/1.08 'Space Grotesk',sans-serif;letter-spacing:-.05em;margin:0;max-width:540px}.mc-contact p{color:var(--body);font-size:13px;margin:13px 0 0}.mc-contact-actions{display:flex;align-items:center;gap:20px}.mc-footer{border-top:1px solid var(--line);padding:20px 0 24px;color:var(--muted);font:10px 'IBM Plex Mono',monospace;display:flex;justify-content:space-between;gap:18px}.mc-footer a{color:#c4d0da!important}.mc-footer a:hover{color:var(--cyan)!important}\n@media(max-width:900px){.mc-shell{width:min(100% - 42px,720px)}.mc-header{height:auto;min-height:74px;padding:13px 0}.mc-brand{min-width:0}.mc-nav{gap:17px}.mc-hero{grid-template-columns:1fr;gap:35px;padding:68px 0 54px}.mc-hero-intro{max-width:720px}.mc-evidence{border-left:0;border-top:1px solid var(--line-strong);padding:21px 0 0}.mc-evidence-title{margin-bottom:5px}.mc-proof-row{grid-template-columns:105px 1fr;padding:13px 0}.mc-proof-num{font-size:25px}.mc-section{padding:55px 0}.mc-experience{grid-template-columns:1fr;gap:26px}.mc-exp-intro p{max-width:600px}.mc-exp-list{margin-top:0}}\n@media(max-width:620px){.mc-shell{width:calc(100% - 36px)}.mc-header-inner{align-items:flex-start;flex-direction:column;gap:12px}.mc-header{padding:13px 0 11px}.mc-nav{width:100%;justify-content:space-between;gap:10px;overflow-x:auto;padding:0 0 2px;white-space:nowrap;font-size:11px}.mc-nav a{flex:none}.mc-nav-cta{padding:7px 10px}.mc-brand{gap:9px}.mc-monogram{width:31px;height:31px}.mc-h1{font-size:clamp(43px,12vw,59px);line-height:1.03}.mc-roleline{font-size:9px;margin-bottom:16px}.mc-hero{padding:51px 0 39px;gap:29px}.mc-hero-copy{font-size:14px;margin:19px 0 16px}.mc-location{margin-bottom:21px}.mc-actions{gap:16px}.mc-primary-link{padding:11px 12px;font-size:11px}.mc-evidence{padding-top:16px}.mc-section{padding:43px 0}.mc-section-head{display:block;margin-bottom:21px}.mc-section-title{font-size:25px}.mc-project-head{padding:21px 18px;display:block}.mc-project-title{font-size:21px}.mc-project-link{margin-top:15px}.mc-diagram-wrap{padding:22px 17px 17px}.mc-diagram-label{font-size:9px;align-items:flex-start;gap:10px}.mc-diagram-label span:last-child{text-align:right}.mc-flow{grid-template-columns:1fr;gap:8px}.mc-node{min-height:72px;display:grid;grid-template-columns:1fr auto;align-items:center;padding:11px 12px}.mc-node-type{grid-column:1;grid-row:1}.mc-node-name{grid-column:1;grid-row:2;margin-top:2px}.mc-node-detail{grid-column:2;grid-row:1 / span 2;margin:0;text-align:right}.mc-flow-arrow{height:13px;transform:rotate(90deg);font-size:13px}.mc-flow-note{margin-top:12px;font-size:9px}.mc-project-bottom{grid-template-columns:1fr}.mc-project-fact{padding:16px 18px;border-right:0;border-bottom:1px solid var(--line)}.mc-project-fact:last-child{border-bottom:0}.mc-fact-value{font-size:18px}.mc-work-row{grid-template-columns:1fr auto;gap:7px 12px;padding:17px 0}.mc-work-name{grid-column:1}.mc-work-desc{grid-column:1 / -1;grid-row:2}.mc-work-outcome{grid-column:2;grid-row:1;font-size:10px}.mc-work-outcome small{max-width:100px}.mc-exp-item{grid-template-columns:1fr;gap:6px;padding:18px 0}.mc-exp-date{padding:0}.mc-skill-group{grid-template-columns:1fr;gap:4px;padding:12px 0}.mc-os-section{grid-template-columns:1fr;gap:19px;padding:23px 0}.mc-os-title{font-size:24px}.mc-os-link{justify-self:start}.mc-contact{padding:43px 0 31px;display:block}.mc-contact h2{font-size:31px}.mc-contact-actions{margin-top:19px;flex-wrap:wrap;gap:15px}.mc-footer{flex-direction:column;gap:7px}.mc-footer span:last-child{white-space:normal}}\n</style>\n<div class=\"mc-page\" data-kid=\"1\">\n    <header class=\"mc-header\" data-kid=\"1-1\">\n        <div class=\"mc-shell mc-header-inner\" data-kid=\"1-1-1\">\n            <a aria-label=\"Marcus Webb home\" class=\"mc-brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name link\" href=\"#top\">\n                <span class=\"mc-monogram\" data-kid=\"1-1-1-1-1\" data-name=\"brand monogram logo\">\n                    MW\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand identification container\">\n                    <span class=\"mc-brand-name\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        Marcus Webb\n                    </span>\n                    <span class=\"mc-brand-role\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand professional role text\">\n                        Senior Full-Stack Engineer\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"mc-nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a data-kid=\"1-1-1-2-1\" data-name=\"systems navigation link\" href=\"#systems\">\n                    Systems\n                </a>\n                <a data-kid=\"1-1-1-2-2\" data-name=\"experience navigation link\" href=\"#experience\">\n                    Experience\n                </a>\n                <a data-kid=\"1-1-1-2-3\" data-name=\"open source navigation link\" href=\"#open-source\">\n                    Open source\n                </a>\n                <a class=\"mc-nav-cta\" data-kid=\"1-1-1-2-4\" data-name=\"contact call-to-action link\" href=\"#contact\">\n                    Contact\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mc-main\" data-kid=\"1-2\" id=\"top\">\n        <section aria-labelledby=\"hero-title\" class=\"mc-shell mc-hero\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"mc-hero-intro\" data-kid=\"1-2-1-1\" data-name=\"hero introduction container\">\n                <div class=\"mc-roleline\" data-kid=\"1-2-1-1-1\" data-name=\"hero professional role line\">\n                    Senior Full-Stack Engineer · San Francisco\n                </div>\n                <h1 class=\"mc-h1\" data-kid=\"1-2-1-1-2\" data-name=\"hero headline\" id=\"hero-title\">\n                    I build the systems behind\n                    <em data-kid=\"1-2-1-1-2-1\" data-name=\"hero headline emphasized text\">\n                        high-volume products.\n                    </em>\n                </h1>\n                <p class=\"mc-hero-copy\" data-kid=\"1-2-1-1-3\" data-name=\"hero copy paragraph\">\n                    I work across product interfaces, backend services, and the teams that ship them. At TechCorp, I led eight engineers building payment infrastructure for\n                    <strong data-kid=\"1-2-1-1-3-1\" data-name=\"hero copy highlight text\">\n                        more than one million users.\n                    </strong>\n                </p>\n                <p class=\"mc-location\" data-kid=\"1-2-1-1-4\" data-name=\"hero location text\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-1-1-4-1\" data-name=\"map pin icon\">\n                    </i>\n                    San Francisco, California\n                </p>\n                <div class=\"mc-actions\" data-kid=\"1-2-1-1-5\" data-name=\"hero action buttons container\">\n                    <a class=\"mc-primary-link\" data-kid=\"1-2-1-1-5-1\" data-name=\"read brief primary link\" href=\"#payflow\">\n                        Read the PayFlow system brief\n                        <span aria-hidden=\"true\" data-kid=\"1-2-1-1-5-1-1\" data-name=\"read brief arrow icon\">\n                            ↓\n                        </span>\n                    </a>\n                    <a class=\"mc-text-link\" data-kid=\"1-2-1-1-5-2\" data-name=\"email link\" href=\"mailto:marcus@webworks.dev\">\n                        Email Marcus\n                        <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-1-1-5-2-1\" data-name=\"external arrow icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n            <aside aria-label=\"Production experience at a glance\" class=\"mc-evidence\" data-kid=\"1-2-1-2\" data-name=\"production experience evidence box\">\n                <p class=\"mc-evidence-title\" data-kid=\"1-2-1-2-1\" data-name=\"evidence title\">\n                    Production experience\n                </p>\n                <div class=\"mc-proof-row\" data-kid=\"1-2-1-2-2\" data-name=\"first evidence metric row\">\n                    <strong class=\"mc-proof-num\" data-kid=\"1-2-1-2-2-1\" data-name=\"first evidence metric value\">\n                        1M+\n                    </strong>\n                    <div class=\"mc-proof-copy\" data-kid=\"1-2-1-2-2-2\" data-name=\"first evidence metric label\">\n                        users supported\n                        <small data-kid=\"1-2-1-2-2-2-1\" data-name=\"first evidence metric detail\">\n                            Core payment infrastructure · TechCorp\n                        </small>\n                    </div>\n                </div>\n                <div class=\"mc-proof-row\" data-kid=\"1-2-1-2-3\" data-name=\"second evidence metric row\">\n                    <strong class=\"mc-proof-num\" data-kid=\"1-2-1-2-3-1\" data-name=\"second evidence metric value\">\n                        $2M+\n                    </strong>\n                    <div class=\"mc-proof-copy\" data-kid=\"1-2-1-2-3-2\" data-name=\"second evidence metric label\">\n                        processed daily\n                        <small data-kid=\"1-2-1-2-3-2-1\" data-name=\"second evidence metric detail\">\n                            PayFlow payment platform\n                        </small>\n                    </div>\n                </div>\n                <div class=\"mc-proof-row\" data-kid=\"1-2-1-2-4\" data-name=\"third evidence metric row\">\n                    <strong class=\"mc-proof-num\" data-kid=\"1-2-1-2-4-1\" data-name=\"third evidence metric value\">\n                        8\n                    </strong>\n                    <div class=\"mc-proof-copy\" data-kid=\"1-2-1-2-4-2\" data-name=\"third evidence metric label\">\n                        engineers led\n                        <small data-kid=\"1-2-1-2-4-2-1\" data-name=\"third evidence metric detail\">\n                            Payment infrastructure team · TechCorp\n                        </small>\n                    </div>\n                </div>\n            </aside>\n        </section>\n        <div class=\"mc-divider\" data-kid=\"1-2-2\">\n        </div>\n        <section aria-labelledby=\"systems-heading\" class=\"mc-shell mc-section\" data-kid=\"1-2-3\" data-name=\"production systems section\" id=\"systems\">\n            <div class=\"mc-section-head\" data-kid=\"1-2-3-1\">\n                <div data-kid=\"1-2-3-1-1\">\n                    <h2 class=\"mc-section-title\" data-kid=\"1-2-3-1-1-1\" data-name=\"systems section title\" id=\"systems-heading\">\n                        Production systems\n                    </h2>\n                    <p class=\"mc-section-sub\" data-kid=\"1-2-3-1-1-2\" data-name=\"systems section subtitle\">\n                        The decisions, scale, and outcomes behind shipped work.\n                    </p>\n                </div>\n            </div>\n            <article aria-labelledby=\"payflow-title\" class=\"mc-project\" data-kid=\"1-2-3-2\" data-name=\"payflow system project article\" id=\"payflow\">\n                <div class=\"mc-project-head\" data-kid=\"1-2-3-2-1\">\n                    <div data-kid=\"1-2-3-2-1-1\">\n                        <h3 class=\"mc-project-title\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"project title\" id=\"payflow-title\">\n                            PayFlow\n                        </h3>\n                        <div class=\"mc-project-kind\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"project category tag\">\n                            Payments platform · Fraud detection\n                        </div>\n                        <p class=\"mc-project-summary\" data-kid=\"1-2-3-2-1-1-3\" data-name=\"project description paragraph\">\n                            A real-time payment dashboard with machine-learning fraud detection. Built for transactions that need to move quickly without losing sight of risk.\n                        </p>\n                    </div>\n                    <a class=\"mc-project-link\" data-kid=\"1-2-3-2-1-2\" data-name=\"discuss project link\" href=\"#contact\">\n                        Discuss the system\n                        <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"discuss project icon\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"mc-diagram-wrap\" data-kid=\"1-2-3-2-2\">\n                    <div class=\"mc-diagram-label\" data-kid=\"1-2-3-2-2-1\" data-name=\"diagram label container\">\n                        <span data-kid=\"1-2-3-2-2-1-1\" data-name=\"diagram title\">\n                            High-level payment flow\n                        </span>\n                        <span data-kid=\"1-2-3-2-2-1-2\" data-name=\"diagram disclaimer\">\n                            Conceptual view · implementation details to confirm\n                        </span>\n                    </div>\n                    <div aria-label=\"Conceptual PayFlow transaction path: customer checkout sends a payment to the Go payment API, fraud checks assess risk, and Stripe authorizes the transaction.\" class=\"mc-flow\" data-kid=\"1-2-3-2-2-2\" data-name=\"system flow diagram\" role=\"img\">\n                        <div class=\"mc-node\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"entry node box\">\n                            <span class=\"mc-node-type\" data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"entry node type\">\n                                ENTRY\n                            </span>\n                            <span class=\"mc-node-name\" data-kid=\"1-2-3-2-2-2-1-2\" data-name=\"entry node name\">\n                                Checkout\n                            </span>\n                            <span class=\"mc-node-detail\" data-kid=\"1-2-3-2-2-2-1-3\" data-name=\"entry node detail\">\n                                payment request\n                            </span>\n                        </div>\n                        <span aria-hidden=\"true\" class=\"mc-flow-arrow\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"flow arrow icon 1\">\n                            →\n                        </span>\n                        <div class=\"mc-node mc-node--focus\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"service node box\">\n                            <span class=\"mc-node-type\" data-kid=\"1-2-3-2-2-2-3-1\" data-name=\"service node type\">\n                                PAYMENT SERVICE\n                            </span>\n                            <span class=\"mc-node-name\" data-kid=\"1-2-3-2-2-2-3-2\" data-name=\"service node name\">\n                                Go API\n                            </span>\n                            <span class=\"mc-node-detail\" data-kid=\"1-2-3-2-2-2-3-3\" data-name=\"service node detail\">\n                                transaction handling\n                            </span>\n                        </div>\n                        <span aria-hidden=\"true\" class=\"mc-flow-arrow\" data-kid=\"1-2-3-2-2-2-4\" data-name=\"flow arrow icon 2\">\n                            →\n                        </span>\n                        <div class=\"mc-node mc-node--risk\" data-kid=\"1-2-3-2-2-2-5\" data-name=\"risk node box\">\n                            <span class=\"mc-node-type\" data-kid=\"1-2-3-2-2-2-5-1\" data-name=\"risk node type\">\n                                RISK DECISION\n                            </span>\n                            <span class=\"mc-node-name\" data-kid=\"1-2-3-2-2-2-5-2\" data-name=\"risk node name\">\n                                Fraud checks\n                            </span>\n                            <span class=\"mc-node-detail\" data-kid=\"1-2-3-2-2-2-5-3\" data-name=\"risk node detail\">\n                                ML signals\n                            </span>\n                        </div>\n                        <span aria-hidden=\"true\" class=\"mc-flow-arrow\" data-kid=\"1-2-3-2-2-2-6\" data-name=\"flow arrow icon 3\">\n                            →\n                        </span>\n                        <div class=\"mc-node\" data-kid=\"1-2-3-2-2-2-7\" data-name=\"processor node box\">\n                            <span class=\"mc-node-type\" data-kid=\"1-2-3-2-2-2-7-1\" data-name=\"processor node type\">\n                                PROCESSOR\n                            </span>\n                            <span class=\"mc-node-name\" data-kid=\"1-2-3-2-2-2-7-2\" data-name=\"processor node name\">\n                                Stripe\n                            </span>\n                            <span class=\"mc-node-detail\" data-kid=\"1-2-3-2-2-2-7-3\" data-name=\"processor node detail\">\n                                authorization\n                            </span>\n                        </div>\n                    </div>\n                    <p class=\"mc-flow-note\" data-kid=\"1-2-3-2-2-3\" data-name=\"system diagram note\">\n                        Illustrative flow based on the project summary. Confirm component boundaries and transaction sequence before publishing.\n                    </p>\n                </div>\n                <div class=\"mc-project-bottom\" data-kid=\"1-2-3-2-3\">\n                    <div class=\"mc-project-fact\" data-kid=\"1-2-3-2-3-1\" data-name=\"project scale metric box\">\n                        <span class=\"mc-fact-label\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"scale metric label\">\n                            Reported scale\n                        </span>\n                        <strong class=\"mc-fact-value\" data-kid=\"1-2-3-2-3-1-2\" data-name=\"scale metric value\">\n                            $2M+\n                            <small data-kid=\"1-2-3-2-3-1-2-1\" data-name=\"scale metric unit\">\n                                processed daily\n                            </small>\n                        </strong>\n                    </div>\n                    <div class=\"mc-project-fact\" data-kid=\"1-2-3-2-3-2\" data-name=\"tech stack metric box\">\n                        <span class=\"mc-fact-label\" data-kid=\"1-2-3-2-3-2-1\" data-name=\"tech stack label\">\n                            Stack in project profile\n                        </span>\n                        <div class=\"mc-tech-inline\" data-kid=\"1-2-3-2-3-2-2\" data-name=\"tech stack items list\">\n                            <span data-kid=\"1-2-3-2-3-2-2-1\" data-name=\"tech stack item 1\">\n                                Next.js\n                            </span>\n                            <span data-kid=\"1-2-3-2-3-2-2-2\" data-name=\"tech stack item 2\">\n                                Go\n                            </span>\n                            <span data-kid=\"1-2-3-2-3-2-2-3\" data-name=\"tech stack item 3\">\n                                Redis\n                            </span>\n                            <span data-kid=\"1-2-3-2-3-2-2-4\" data-name=\"tech stack item 4\">\n                                Stripe\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </article>\n            <div aria-label=\"Additional systems\" class=\"mc-work-list\" data-kid=\"1-2-3-3\" data-name=\"additional projects list\">\n                <div class=\"mc-work-row\" data-kid=\"1-2-3-3-1\" data-name=\"work row 1 container\">\n                    <div class=\"mc-work-name\" data-kid=\"1-2-3-3-1-1\" data-name=\"work row 1 title\">\n                        NovaBuild\n                        <span class=\"mc-work-type\" data-kid=\"1-2-3-3-1-1-1\" data-name=\"work row 1 category\">\n                            AI-assisted app builder\n                        </span>\n                    </div>\n                    <p class=\"mc-work-desc\" data-kid=\"1-2-3-3-1-2\" data-name=\"work row 1 description\">\n                        No-code platform for building web apps with AI assistance.\n                    </p>\n                    <div class=\"mc-work-outcome\" data-kid=\"1-2-3-3-1-3\" data-name=\"work row 1 outcome\">\n                        10k+ users\n                        <small data-kid=\"1-2-3-3-1-3-1\" data-name=\"work row 1 outcome detail\">\n                            $500K ARR\n                        </small>\n                    </div>\n                </div>\n                <div class=\"mc-work-row\" data-kid=\"1-2-3-3-2\" data-name=\"work row 2 container\">\n                    <div class=\"mc-work-name\" data-kid=\"1-2-3-3-2-1\" data-name=\"work row 2 title\">\n                        InkSpace\n                        <span class=\"mc-work-type\" data-kid=\"1-2-3-3-2-1-1\" data-name=\"work row 2 category\">\n                            Real-time collaboration\n                        </span>\n                    </div>\n                    <p class=\"mc-work-desc\" data-kid=\"1-2-3-3-2-2\" data-name=\"work row 2 description\">\n                        Collaborative design tool built for remote teams.\n                    </p>\n                    <div class=\"mc-work-outcome\" data-kid=\"1-2-3-3-2-3\" data-name=\"work row 2 outcome\">\n                        500+ daily teams\n                        <small data-kid=\"1-2-3-3-2-3-1\" data-name=\"work row 2 outcome detail\">\n                            Acquired by DesignCo\n                        </small>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <div class=\"mc-divider\" data-kid=\"1-2-4\">\n        </div>\n        <section aria-labelledby=\"experience-heading\" class=\"mc-shell mc-section\" data-kid=\"1-2-5\" data-name=\"experience section\" id=\"experience\">\n            <div class=\"mc-experience\" data-kid=\"1-2-5-1\">\n                <div class=\"mc-exp-intro\" data-kid=\"1-2-5-1-1\">\n                    <h2 class=\"mc-section-title\" data-kid=\"1-2-5-1-1-1\" data-name=\"experience section title\" id=\"experience-heading\">\n                        Experience\n                    </h2>\n                    <p data-kid=\"1-2-5-1-1-2\" data-name=\"experience section description\">\n                        Responsibilities tied to the systems and outcomes—not just a list of titles.\n                    </p>\n                </div>\n                <div class=\"mc-exp-list\" data-kid=\"1-2-5-1-2\">\n                    <article class=\"mc-exp-item\" data-kid=\"1-2-5-1-2-1\" data-name=\"experience item 1\">\n                        <div class=\"mc-exp-date\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"experience date 1\">\n                            2022 — Present\n                        </div>\n                        <div data-kid=\"1-2-5-1-2-1-2\">\n                            <h3 class=\"mc-exp-role\" data-kid=\"1-2-5-1-2-1-2-1\" data-name=\"experience role 1\">\n                                Senior Full-Stack Engineer\n                            </h3>\n                            <div class=\"mc-exp-company\" data-kid=\"1-2-5-1-2-1-2-2\" data-name=\"experience company 1\">\n                                TechCorp Inc.\n                            </div>\n                            <p class=\"mc-exp-desc\" data-kid=\"1-2-5-1-2-1-2-3\" data-name=\"experience description 1\">\n                                Led a team of eight building core payment infrastructure serving more than one million users.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"mc-exp-item\" data-kid=\"1-2-5-1-2-2\" data-name=\"experience item 2\">\n                        <div class=\"mc-exp-date\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"experience date 2\">\n                            2020 — 2022\n                        </div>\n                        <div data-kid=\"1-2-5-1-2-2-2\">\n                            <h3 class=\"mc-exp-role\" data-kid=\"1-2-5-1-2-2-2-1\" data-name=\"experience role 2\">\n                                Frontend Engineer\n                            </h3>\n                            <div class=\"mc-exp-company\" data-kid=\"1-2-5-1-2-2-2-2\" data-name=\"experience company 2\">\n                                StartupXYZ\n                            </div>\n                            <p class=\"mc-exp-desc\" data-kid=\"1-2-5-1-2-2-2-3\" data-name=\"experience description 2\">\n                                Built the product frontend from the ground up; the platform reached 100k users in six months.\n                            </p>\n                        </div>\n                    </article>\n                </div>\n            </div>\n            <div aria-label=\"Technical expertise\" class=\"mc-skills-section\" data-kid=\"1-2-5-2\">\n                <div class=\"mc-skill-group\" data-kid=\"1-2-5-2-1\" data-name=\"skill group 1\">\n                    <div class=\"mc-skill-label\" data-kid=\"1-2-5-2-1-1\" data-name=\"skill group 1 label\">\n                        Frontend\n                    </div>\n                    <div class=\"mc-skill-values\" data-kid=\"1-2-5-2-1-2\" data-name=\"skill group 1 values\">\n                        React · TypeScript · Next.js · Tailwind · Framer Motion\n                    </div>\n                </div>\n                <div class=\"mc-skill-group\" data-kid=\"1-2-5-2-2\" data-name=\"skill group 2\">\n                    <div class=\"mc-skill-label\" data-kid=\"1-2-5-2-2-1\" data-name=\"skill group 2 label\">\n                        Backend\n                    </div>\n                    <div class=\"mc-skill-values\" data-kid=\"1-2-5-2-2-2\" data-name=\"skill group 2 values\">\n                        Node.js · Python · Rust · PostgreSQL · Redis\n                    </div>\n                </div>\n                <div class=\"mc-skill-group\" data-kid=\"1-2-5-2-3\" data-name=\"skill group 3\">\n                    <div class=\"mc-skill-label\" data-kid=\"1-2-5-2-3-1\" data-name=\"skill group 3 label\">\n                        Infrastructure\n                    </div>\n                    <div class=\"mc-skill-values\" data-kid=\"1-2-5-2-3-2\" data-name=\"skill group 3 values\">\n                        AWS · Docker · Kubernetes · CI/CD · Terraform\n                    </div>\n                </div>\n            </div>\n        </section>\n        <div class=\"mc-divider\" data-kid=\"1-2-6\">\n        </div>\n        <section aria-labelledby=\"open-source-title\" class=\"mc-shell mc-section\" data-kid=\"1-2-7\" id=\"open-source\">\n            <div class=\"mc-os-section\" data-kid=\"1-2-7-1\">\n                <div data-kid=\"1-2-7-1-1\">\n                    <h2 class=\"mc-os-title\" data-kid=\"1-2-7-1-1-1\" data-name=\"open source section title\" id=\"open-source-title\">\n                        Open source\n                    </h2>\n                    <p class=\"mc-os-copy\" data-kid=\"1-2-7-1-1-2\" data-name=\"open source copy\">\n                        I contribute in public alongside product work. Repository-level highlights can be added as specific projects and pull requests are confirmed.\n                    </p>\n                    <div class=\"mc-os-proof\" data-kid=\"1-2-7-1-1-3\" data-name=\"open source metrics container\">\n                        <strong class=\"mc-os-count\" data-kid=\"1-2-7-1-1-3-1\" data-name=\"open source metrics count\">\n                            2.4k\n                        </strong>\n                        <span class=\"mc-os-label\" data-kid=\"1-2-7-1-1-3-2\" data-name=\"open source metrics label\">\n                            GitHub stars noted in profile\n                        </span>\n                    </div>\n                </div>\n                <a class=\"mc-os-link\" data-kid=\"1-2-7-1-2\" data-name=\"github profile link\" href=\"https://github.com/marcuswebb\" rel=\"noreferrer\" target=\"_blank\">\n                    View GitHub profile\n                    <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-7-1-2-1\" data-name=\"github arrow icon\">\n                    </i>\n                </a>\n            </div>\n        </section>\n        <div class=\"mc-divider\" data-kid=\"1-2-8\">\n        </div>\n        <section aria-labelledby=\"contact-title\" class=\"mc-shell mc-contact\" data-kid=\"1-2-9\" id=\"contact\">\n            <div data-kid=\"1-2-9-1\">\n                <h2 data-kid=\"1-2-9-1-1\" data-name=\"contact section title\" id=\"contact-title\">\n                    Have a system worth building?\n                </h2>\n                <p data-kid=\"1-2-9-1-2\" data-name=\"contact section description\">\n                    I’m happy to talk engineering leadership, production systems, and thoughtful collaboration.\n                </p>\n            </div>\n            <div class=\"mc-contact-actions\" data-kid=\"1-2-9-2\">\n                <a class=\"mc-primary-link\" data-kid=\"1-2-9-2-1\" data-name=\"contact email link\" href=\"mailto:marcus@webworks.dev\">\n                    Email Marcus\n                    <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-9-2-1-1\" data-name=\"contact email icon\">\n                    </i>\n                </a>\n                <a class=\"mc-text-link\" data-kid=\"1-2-9-2-2\" data-name=\"linkedin profile link\" href=\"https://www.linkedin.com/in/marcus-webb\" rel=\"noreferrer\" target=\"_blank\">\n                    LinkedIn\n                    <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-9-2-2-1\" data-name=\"linkedin icon\">\n                    </i>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"mc-shell mc-footer\" data-kid=\"1-3\">\n        <span data-kid=\"1-3-1\" data-name=\"footer copyright text\">\n            © Marcus Webb · San Francisco, CA\n        </span>\n        <span data-kid=\"1-3-2\" data-name=\"footer contact block\">\n            Senior Full-Stack Engineer ·\n            <a data-kid=\"1-3-2-1\" data-name=\"footer email link\" href=\"mailto:marcus@webworks.dev\">\n                marcus@webworks.dev\n            </a>\n        </span>\n    </footer>\n</div>\n",
