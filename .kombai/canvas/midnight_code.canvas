      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.mc-page{--paper:#F9F7F2;--paper-dark:#F0EDE6;--forest:#1B3022;--forest-2:#243D2E;--amber:#D97706;--amber-soft:#F0B05B;--text:#2D2926;--muted:#726D68;--line:#DED9D0;--mono:#858D82;background:var(--paper);color:var(--text);font-family:'Hanken Grotesk',sans-serif;font-size:16px;line-height:1.55;min-height:100vh;overflow-x:clip}\n.mc-page a{color:inherit;text-decoration:none}\n.mc-wrap{width:min(1180px,calc(100% - 72px));margin-inline:auto}\n.mc-nav{height:78px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.12);color:#F9F7F2}\n.mc-brand{display:flex;align-items:center;gap:13px;font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:17px;letter-spacing:-.03em}\n.mc-mark{width:34px;height:34px;border:1px solid rgba(240,176,91,.62);display:grid;place-items:center;color:var(--amber-soft);font-size:11px;font-family:ui-monospace,monospace;letter-spacing:-.05em}\n.mc-navlinks{display:flex;align-items:center;gap:36px;color:rgba(249,247,242,.68);font-size:13px;font-weight:600}\n.mc-navlinks a:hover{color:#fff}\n.mc-nav-cta{border:1px solid rgba(240,176,91,.55);color:#F9F7F2!important;padding:10px 16px;font-size:13px}\n.mc-hero{background:var(--forest);color:var(--paper);position:relative;overflow:hidden}\n.mc-hero::after{content:'';position:absolute;right:-80px;top:70px;width:460px;height:460px;border:1px solid rgba(240,176,91,.09);border-radius:50%;box-shadow:0 0 0 60px rgba(240,176,91,.025),0 0 0 120px rgba(240,176,91,.018);pointer-events:none}\n.mc-hero-content{position:relative;z-index:1;padding:88px 0 38px;display:grid;grid-template-columns:1.12fr .88fr;gap:80px;align-items:end}\n.mc-hero h1{font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(52px,6.5vw,88px);line-height:.98;letter-spacing:-.072em;font-weight:600;margin:0 0 25px;color:#F9F7F2}\n.mc-role{font-size:18px;font-weight:500;color:var(--amber-soft);letter-spacing:-.015em}\n.mc-role span{color:rgba(249,247,242,.55);font-weight:400}\n.mc-summary{font-size:18px;line-height:1.7;color:rgba(249,247,242,.72);max-width:470px;margin:0 0 29px}\n.mc-hero-actions{display:flex;gap:22px;align-items:center;flex-wrap:wrap}\n.mc-btn-main{display:inline-flex;align-items:center;gap:10px;background:var(--amber);color:#fff!important;padding:13px 18px;font-size:13px;font-weight:700;transition:background .2s ease}\n.mc-btn-main:hover{background:#bd6500}\n.mc-hero-link{display:inline-flex;align-items:center;gap:7px;color:rgba(249,247,242,.78)!important;font-size:13px;font-weight:600}\n.mc-hero-link:hover{color:#fff!important}\n.mc-loc{display:flex;align-items:center;gap:8px;margin-top:30px;color:rgba(249,247,242,.52);font-size:12px}\n.mc-loc i{color:var(--amber-soft);font-size:14px}\n.mc-proofline{border-top:1px solid rgba(249,247,242,.15);padding:21px 0 24px;display:flex;align-items:center;gap:29px;color:rgba(249,247,242,.57);font-size:12px;letter-spacing:.015em;position:relative;z-index:1}\n.mc-proofline strong{font-family:'Bricolage Grotesque',sans-serif;font-size:17px;color:#F9F7F2;font-weight:600;letter-spacing:-.03em;margin-right:6px}\n.mc-proof-sep{height:22px;width:1px;background:rgba(249,247,242,.2)}\n.mc-section{padding:82px 0}\n.mc-section-heading{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:end;margin-bottom:37px}\n.mc-section-heading h2{font-family:'Bricolage Grotesque',sans-serif;font-size:39px;line-height:1.07;letter-spacing:-.055em;font-weight:600;color:var(--forest);margin:0;max-width:400px}\n.mc-section-heading p{margin:0;color:var(--muted);font-size:15px;line-height:1.7;max-width:480px}\n.mc-evidence-head{display:grid;grid-template-columns:1.15fr 1.1fr .85fr;padding:0 18px 12px;border-bottom:1px solid var(--line);color:#8B847C;font-size:10px;text-transform:uppercase;letter-spacing:.14em;font-weight:700}\n.mc-evidence-row{display:grid;grid-template-columns:1.15fr 1.1fr .85fr;gap:20px;padding:24px 18px;border-bottom:1px solid var(--line);align-items:start;transition:background .18s ease}\n.mc-evidence-row:hover{background:rgba(27,48,34,.035)}\n.mc-work-name{font-family:'Bricolage Grotesque',sans-serif;font-size:20px;font-weight:600;letter-spacing:-.035em;color:var(--forest);margin-bottom:4px}\n.mc-work-kind{font-size:12px;color:#8C857E}\n.mc-work-role{font-size:14px;color:#514B45;line-height:1.55;max-width:260px}\n.mc-work-evidence{display:flex;flex-direction:column;gap:3px;font-size:13px;color:#6C665F;line-height:1.5}\n.mc-work-evidence strong{font-family:'Bricolage Grotesque',sans-serif;font-size:19px;color:var(--forest);font-weight:600;letter-spacing:-.04em}\n.mc-evidence-footer{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:24px;padding:0 18px;color:#817B74;font-size:12px}\n.mc-inline-link{display:inline-flex;align-items:center;gap:7px;color:var(--forest)!important;font-weight:700;font-size:12px;white-space:nowrap}\n.mc-inline-link i{font-size:14px;color:var(--amber)}\n.mc-experience{background:var(--paper-dark)}\n.mc-experience .mc-section-heading{margin-bottom:29px}\n.mc-career{border-top:1px solid #D7D1C8}\n.mc-career-row{display:grid;grid-template-columns:200px 1fr 240px;gap:35px;padding:27px 0;border-bottom:1px solid #D7D1C8;align-items:start}\n.mc-period{font-family:ui-monospace,SFMono-Regular,monospace;color:#7D776F;font-size:12px;padding-top:5px}\n.mc-career-role{font-family:'Bricolage Grotesque',sans-serif;font-size:22px;line-height:1.15;letter-spacing:-.04em;font-weight:600;color:var(--forest);margin-bottom:4px}\n.mc-career-company{font-size:13px;color:#817A72}\n.mc-career-desc{font-size:14px;line-height:1.7;color:#625C55;max-width:520px;margin:2px 0 0}\n.mc-career-proof{justify-self:end;font-size:12px;color:#746D65;text-align:right;padding-top:5px}\n.mc-skill-section{padding-bottom:85px}\n.mc-skill-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:54px;padding-top:7px}\n.mc-skill-group{border-top:1px solid var(--line);padding-top:15px}\n.mc-skill-group h3{font-family:ui-monospace,SFMono-Regular,monospace;text-transform:uppercase;font-size:11px;letter-spacing:.1em;color:#918A81;font-weight:500;margin:0 0 17px}\n.mc-skill-list{display:flex;flex-wrap:wrap;gap:8px}\n.mc-skill-list span{padding:7px 10px;border:1px solid #DED9D0;background:rgba(255,255,255,.46);font-size:12px;color:#514C46}\n.mc-open-source{background:#EAE5DB;padding:64px 0}\n.mc-os-inner{display:grid;grid-template-columns:1fr 1.2fr;gap:60px;align-items:center}\n.mc-os-inner h2{font-family:'Bricolage Grotesque',sans-serif;color:var(--forest);font-size:32px;line-height:1.1;letter-spacing:-.05em;margin:0 0 9px;font-weight:600}\n.mc-os-lede{font-size:14px;line-height:1.65;color:#69635C;margin:0;max-width:410px}\n.mc-os-evidence{border-left:1px solid #CFC8BD;padding:4px 0 4px 32px;display:flex;gap:19px;align-items:center}\n.mc-os-number{font-family:'Bricolage Grotesque',sans-serif;font-size:49px;line-height:1;color:var(--forest);font-weight:600;letter-spacing:-.07em;white-space:nowrap}\n.mc-os-copy{font-size:13px;line-height:1.6;color:#716A62;max-width:350px}\n.mc-os-copy strong{display:block;color:var(--text);font-weight:700;margin-bottom:2px}\n.mc-contact{background:var(--forest);color:var(--paper);padding:74px 0 25px}\n.mc-contact-main{display:flex;justify-content:space-between;align-items:end;gap:50px;padding-bottom:58px}\n.mc-contact h2{font-family:'Bricolage Grotesque',sans-serif;font-size:50px;line-height:1;letter-spacing:-.06em;color:var(--paper);margin:0 0 13px;font-weight:600}\n.mc-contact p{color:rgba(249,247,242,.65);font-size:14px;margin:0;max-width:430px}\n.mc-contact-link{display:inline-flex;align-items:center;gap:10px;border-bottom:1px solid rgba(240,176,91,.7);padding:0 0 10px;color:#F9F7F2!important;font-size:17px;font-weight:600;white-space:nowrap}\n.mc-contact-link i{color:var(--amber-soft);font-size:19px}\n.mc-footer{border-top:1px solid rgba(249,247,242,.14);padding:18px 0 0;display:flex;justify-content:space-between;gap:24px;color:rgba(249,247,242,.42);font-size:11px}\n.mc-footer span:last-child{font-family:ui-monospace,monospace;letter-spacing:.04em}\n@media(max-width:900px){.mc-wrap{width:min(100% - 48px,720px)}.mc-hero-content{gap:40px}.mc-section-heading{gap:35px}.mc-career-row{grid-template-columns:150px 1fr 160px;gap:20px}.mc-proofline{gap:18px}.mc-proofline strong{font-size:15px}.mc-os-inner{gap:30px}}\n@media(max-width:680px){.mc-wrap{width:calc(100% - 40px)}.mc-nav{height:68px}.mc-navlinks{gap:0}.mc-navlinks a:not(.mc-nav-cta){display:none}.mc-nav-cta{padding:8px 11px;font-size:12px}.mc-brand{font-size:15px}.mc-hero-content{padding:65px 0 32px;grid-template-columns:1fr;gap:23px}.mc-hero h1{font-size:57px;margin-bottom:19px;max-width:450px}.mc-role{font-size:16px}.mc-summary{font-size:16px;max-width:500px;margin-bottom:21px}.mc-loc{margin-top:21px}.mc-proofline{display:grid;grid-template-columns:1fr 1fr;gap:14px 20px;padding:19px 0 22px}.mc-proof-sep{display:none}.mc-proofline span{font-size:11px}.mc-proofline strong{font-size:16px}.mc-section{padding:58px 0}.mc-section-heading{grid-template-columns:1fr;gap:13px;margin-bottom:26px}.mc-section-heading h2{font-size:32px}.mc-section-heading p{font-size:14px}.mc-evidence-head{display:none}.mc-evidence-row{grid-template-columns:1fr 1fr;gap:14px 18px;padding:19px 6px}.mc-work-name{font-size:18px}.mc-work-kind{font-size:11px}.mc-work-role{font-size:12px}.mc-work-evidence{font-size:12px}.mc-work-evidence strong{font-size:17px}.mc-evidence-row>div:last-child{grid-column:1/-1;display:flex;align-items:baseline;gap:9px}.mc-evidence-footer{padding:0 6px;align-items:flex-start;flex-direction:column}.mc-career-row{grid-template-columns:1fr;gap:8px;padding:21px 0}.mc-period{font-size:11px}.mc-career-role{font-size:20px}.mc-career-desc{font-size:13px}.mc-career-proof{justify-self:start;text-align:left;padding:0;font-size:11px}.mc-skill-section{padding-bottom:57px}.mc-skill-grid{grid-template-columns:1fr;gap:23px}.mc-skill-group{padding-top:13px}.mc-open-source{padding:47px 0}.mc-os-inner{grid-template-columns:1fr;gap:25px}.mc-os-inner h2{font-size:29px}.mc-os-evidence{padding-left:19px;gap:14px}.mc-os-number{font-size:42px}.mc-os-copy{font-size:12px}.mc-contact{padding:55px 0 19px}.mc-contact-main{align-items:flex-start;flex-direction:column;gap:27px;padding-bottom:40px}.mc-contact h2{font-size:42px}.mc-contact p{font-size:13px}.mc-contact-link{font-size:15px}.mc-footer{flex-direction:column;gap:6px}.mc-hero::after{right:-260px;top:130px;width:360px;height:360px}}\n</style>\n<div class=\"mc-page\" data-kid=\"1\">\n    <section class=\"mc-hero\" data-kid=\"1-1\" id=\"top\">\n        <div class=\"mc-wrap\" data-kid=\"1-1-1\">\n            <header class=\"mc-nav\" data-kid=\"1-1-1-1\">\n                <a aria-label=\"Marcus Webb home\" class=\"mc-brand\" data-kid=\"1-1-1-1-1\" href=\"#top\">\n                    <span class=\"mc-mark\" data-kid=\"1-1-1-1-1-1\">\n                        MW\n                    </span>\n                    <span data-kid=\"1-1-1-1-1-2\">\n                        Marcus Webb\n                    </span>\n                </a>\n                <nav aria-label=\"Primary navigation\" class=\"mc-navlinks\" data-kid=\"1-1-1-1-2\">\n                    <a data-kid=\"1-1-1-1-2-1\" href=\"#work\">\n                        Work\n                    </a>\n                    <a data-kid=\"1-1-1-1-2-2\" href=\"#experience\">\n                        Experience\n                    </a>\n                    <a data-kid=\"1-1-1-1-2-3\" data-name=\"expertise navigation link\" href=\"#expertise\">\n                        Expertise\n                    </a>\n                    <a data-kid=\"1-1-1-1-2-4\" data-name=\"open source navigation link\" href=\"#open-source\">\n                        Open source\n                    </a>\n                    <a class=\"mc-nav-cta\" data-kid=\"1-1-1-1-2-5\" data-name=\"email marcus navigation cta\" href=\"#contact\">\n                        Email Marcus\n                    </a>\n                </nav>\n            </header>\n            <div class=\"mc-hero-content\" data-kid=\"1-1-1-2\">\n                <div data-kid=\"1-1-1-2-1\">\n                    <h1 data-kid=\"1-1-1-2-1-1\">\n                        Marcus\n                        <br data-kid=\"1-1-1-2-1-1-1\"/>\n                        Webb.\n                    </h1>\n                    <div class=\"mc-role\" data-kid=\"1-1-1-2-1-2\">\n                        Senior Full-Stack Engineer\n                        <span data-kid=\"1-1-1-2-1-2-1\">\n                            · San Francisco\n                        </span>\n                    </div>\n                </div>\n                <div data-kid=\"1-1-1-2-2\">\n                    <p class=\"mc-summary\" data-kid=\"1-1-1-2-2-1\">\n                        I lead teams building the systems behind products people rely on—from the interface to the infrastructure underneath.\n                    </p>\n                    <div class=\"mc-hero-actions\" data-kid=\"1-1-1-2-2-2\">\n                        <a class=\"mc-btn-main\" data-kid=\"1-1-1-2-2-2-1\" href=\"#work\">\n                            Review production work\n                            <i class=\"icon-arrow-up-right\" data-kid=\"1-1-1-2-2-2-1-1\">\n                            </i>\n                        </a>\n                        <a class=\"mc-hero-link\" data-kid=\"1-1-1-2-2-2-2\" href=\"mailto:marcus@webworks.dev\">\n                            Email Marcus\n                            <i class=\"icon-arrow-up-right\" data-kid=\"1-1-1-2-2-2-2-1\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"mc-loc\" data-kid=\"1-1-1-2-2-3\">\n                        <i class=\"icon-map-pin\" data-kid=\"1-1-1-2-2-3-1\">\n                        </i>\n                        <span data-kid=\"1-1-1-2-2-3-2\">\n                            San Francisco, CA · Working across the full stack\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div aria-label=\"Portfolio evidence\" class=\"mc-proofline\" data-kid=\"1-1-1-3\">\n                <span data-kid=\"1-1-1-3-1\">\n                    <strong data-dynamic=\"true\" data-kid=\"1-1-1-3-1-1\" data-name=\"total users metric\" data-reason=\"number text fetched or calculated by script\">\n                        1M+\n                    </strong>\n                    users served\n                </span>\n                <i class=\"mc-proof-sep\" data-kid=\"1-1-1-3-2\">\n                </i>\n                <span data-kid=\"1-1-1-3-3\">\n                    <strong data-dynamic=\"true\" data-kid=\"1-1-1-3-3-1\" data-name=\"processed daily metric\" data-reason=\"currency value fetched or calculated by script\">\n                        $2M+\n                    </strong>\n                    processed daily\n                </span>\n                <i class=\"mc-proof-sep\" data-kid=\"1-1-1-3-4\">\n                </i>\n                <span data-kid=\"1-1-1-3-5\">\n                    <strong data-dynamic=\"true\" data-kid=\"1-1-1-3-5-1\" data-name=\"github stars count\" data-reason=\"count fetched from github api\">\n                        2.4k\n                    </strong>\n                    GitHub stars\n                </span>\n            </div>\n        </div>\n    </section>\n    <main data-kid=\"1-2\">\n        <section class=\"mc-section\" data-kid=\"1-2-1\" id=\"work\">\n            <div class=\"mc-wrap\" data-kid=\"1-2-1-1\">\n                <div class=\"mc-section-heading\" data-kid=\"1-2-1-1-1\">\n                    <h2 data-kid=\"1-2-1-1-1-1\">\n                        Evidence at a glance\n                    </h2>\n                    <p data-kid=\"1-2-1-1-1-2\">\n                        Selected systems and outcomes, with the work and context behind each claim.\n                    </p>\n                </div>\n                <div class=\"mc-evidence-head\" data-kid=\"1-2-1-1-2\">\n                    <span data-kid=\"1-2-1-1-2-1\">\n                        What shipped\n                    </span>\n                    <span data-kid=\"1-2-1-1-2-2\">\n                        Role and scope\n                    </span>\n                    <span data-kid=\"1-2-1-1-2-3\">\n                        Evidence\n                    </span>\n                </div>\n                <article class=\"mc-evidence-row\" data-kid=\"1-2-1-1-3\" id=\"payflow\">\n                    <div data-kid=\"1-2-1-1-3-1\">\n                        <div class=\"mc-work-name\" data-kid=\"1-2-1-1-3-1-1\">\n                            Payment infrastructure\n                        </div>\n                        <div class=\"mc-work-kind\" data-kid=\"1-2-1-1-3-1-2\">\n                            PayFlow · Fintech platform\n                        </div>\n                    </div>\n                    <div class=\"mc-work-role\" data-kid=\"1-2-1-1-3-2\">\n                        Senior Full-Stack Engineer at TechCorp. Led an 8-person team building core payment services.\n                    </div>\n                    <div class=\"mc-work-evidence\" data-kid=\"1-2-1-1-3-3\">\n                        <strong data-kid=\"1-2-1-1-3-3-1\">\n                            $2M+ / day\n                        </strong>\n                        <span data-kid=\"1-2-1-1-3-3-2\">\n                            Payment volume · 1M+ users served\n                        </span>\n                    </div>\n                </article>\n                <article class=\"mc-evidence-row\" data-kid=\"1-2-1-1-4\" id=\"novabuild\">\n                    <div data-kid=\"1-2-1-1-4-1\">\n                        <div class=\"mc-work-name\" data-kid=\"1-2-1-1-4-1-1\">\n                            NovaBuild\n                        </div>\n                        <div class=\"mc-work-kind\" data-kid=\"1-2-1-1-4-1-2\">\n                            AI-assisted app platform\n                        </div>\n                    </div>\n                    <div class=\"mc-work-role\" data-kid=\"1-2-1-1-4-2\">\n                        Product engineering across a no-code platform for building web apps.\n                    </div>\n                    <div class=\"mc-work-evidence\" data-kid=\"1-2-1-1-4-3\">\n                        <strong data-kid=\"1-2-1-1-4-3-1\">\n                            10k+ users\n                        </strong>\n                        <span data-kid=\"1-2-1-1-4-3-2\">\n                            $500K ARR\n                        </span>\n                    </div>\n                </article>\n                <article class=\"mc-evidence-row\" data-kid=\"1-2-1-1-5\" id=\"inkspace\">\n                    <div data-kid=\"1-2-1-1-5-1\">\n                        <div class=\"mc-work-name\" data-kid=\"1-2-1-1-5-1-1\">\n                            InkSpace\n                        </div>\n                        <div class=\"mc-work-kind\" data-kid=\"1-2-1-1-5-1-2\">\n                            Collaborative design software\n                        </div>\n                    </div>\n                    <div class=\"mc-work-role\" data-kid=\"1-2-1-1-5-2\">\n                        Realtime collaboration built with WebSockets, Canvas API, and AWS.\n                    </div>\n                    <div class=\"mc-work-evidence\" data-kid=\"1-2-1-1-5-3\">\n                        <strong data-kid=\"1-2-1-1-5-3-1\">\n                            500+ teams\n                        </strong>\n                        <span data-kid=\"1-2-1-1-5-3-2\">\n                            Daily active · Acquired by DesignCo\n                        </span>\n                    </div>\n                </article>\n                <div class=\"mc-evidence-footer\" data-kid=\"1-2-1-1-6\">\n                    <span data-kid=\"1-2-1-1-6-1\">\n                        Project results are shown with the system they came from—not as standalone claims.\n                    </span>\n                    <a class=\"mc-inline-link\" data-kid=\"1-2-1-1-6-2\" href=\"#experience\">\n                        See the career record\n                        <i class=\"icon-arrow-up-right\" data-kid=\"1-2-1-1-6-2-1\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"mc-experience mc-section\" data-kid=\"1-2-2\" id=\"experience\">\n            <div class=\"mc-wrap\" data-kid=\"1-2-2-1\">\n                <div class=\"mc-section-heading\" data-kid=\"1-2-2-1-1\">\n                    <h2 data-kid=\"1-2-2-1-1-1\">\n                        Career record\n                    </h2>\n                    <p data-kid=\"1-2-2-1-1-2\">\n                        Engineering scope, responsibility, and the teams behind the work.\n                    </p>\n                </div>\n                <div class=\"mc-career\" data-kid=\"1-2-2-1-2\">\n                    <article class=\"mc-career-row\" data-kid=\"1-2-2-1-2-1\">\n                        <div class=\"mc-period\" data-kid=\"1-2-2-1-2-1-1\">\n                            2022 — Present\n                        </div>\n                        <div data-kid=\"1-2-2-1-2-1-2\">\n                            <div class=\"mc-career-role\" data-kid=\"1-2-2-1-2-1-2-1\">\n                                Senior Full-Stack Engineer\n                            </div>\n                            <div class=\"mc-career-company\" data-kid=\"1-2-2-1-2-1-2-2\">\n                                TechCorp Inc.\n                            </div>\n                        </div>\n                        <p class=\"mc-career-desc\" data-kid=\"1-2-2-1-2-1-3\">\n                            Led a team of 8. Built core payment infrastructure serving more than a million users.\n                        </p>\n                    </article>\n                    <article class=\"mc-career-row\" data-kid=\"1-2-2-1-2-2\">\n                        <div class=\"mc-period\" data-kid=\"1-2-2-1-2-2-1\">\n                            2020 — 2022\n                        </div>\n                        <div data-kid=\"1-2-2-1-2-2-2\">\n                            <div class=\"mc-career-role\" data-kid=\"1-2-2-1-2-2-2-1\">\n                                Frontend Engineer\n                            </div>\n                            <div class=\"mc-career-company\" data-kid=\"1-2-2-1-2-2-2-2\">\n                                StartupXYZ\n                            </div>\n                        </div>\n                        <p class=\"mc-career-desc\" data-kid=\"1-2-2-1-2-2-3\">\n                            Built the product frontend from scratch; helped scale to 100K users in six months and introduced a shared design system.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"mc-section mc-skill-section\" data-kid=\"1-2-3\" id=\"expertise\">\n            <div class=\"mc-wrap\" data-kid=\"1-2-3-1\">\n                <div class=\"mc-section-heading\" data-kid=\"1-2-3-1-1\">\n                    <h2 data-kid=\"1-2-3-1-1-1\">\n                        Technical expertise\n                    </h2>\n                    <p data-kid=\"1-2-3-1-1-2\">\n                        Tools I’ve used to design, ship, and operate software across the stack.\n                    </p>\n                </div>\n                <div class=\"mc-skill-grid\" data-kid=\"1-2-3-1-2\">\n                    <div class=\"mc-skill-group\" data-kid=\"1-2-3-1-2-1\">\n                        <h3 data-kid=\"1-2-3-1-2-1-1\">\n       